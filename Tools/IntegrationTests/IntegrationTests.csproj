<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <IsTestProject>true</IsTestProject>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <NoWarn>$(NoWarn);MSB3277</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="xunit" Version="2.5.0" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.9.0" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.5.0" />
    <PackageReference Include="coverlet.collector" Version="6.0.2" />
  </ItemGroup>

  <!-- Con UseWPF, el conjunto de `using` implícitos del SDK de escritorio
       reemplaza al genérico: agrega los System.Windows.* y **no** incluye
       System.IO, así que un archivo que use `Path` o `File` sin declararlo no
       compila (CS0103 «el nombre 'Path' no existe en el contexto actual»). Se
       comprobó en el job `compile-debug` del CI, que es justo el que existe
       para esto. Se ve afectado todo archivo que use System.IO a secas, y por
       eso se declara acá de una vez para el proyecto entero —y además cada
       archivo que lo usa lo importa explícitamente, que es lo que hacen los 93
       archivos de la aplicación.
       Los System.Windows.* sí se quitan: System.Windows.Shapes trae una clase
       `Path` que choca con System.IO.Path. Los archivos que necesitan WPF
       (ConvertersTests) lo importan a mano. -->
  <ItemGroup>
    <Using Include="System.IO" />
    <Using Remove="System.Windows" />
    <Using Remove="System.Windows.Controls" />
    <Using Remove="System.Windows.Data" />
    <Using Remove="System.Windows.Documents" />
    <Using Remove="System.Windows.Input" />
    <Using Remove="System.Windows.Media" />
    <Using Remove="System.Windows.Media.Imaging" />
    <Using Remove="System.Windows.Navigation" />
    <Using Remove="System.Windows.Shapes" />
    <Using Remove="System.Windows.Threading" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\SysDiag.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\..\Tools\fixtures\diagnostico_fixture.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>