# Convenciones de SysDiag. Solo describen el estilo: no hay un paso de CI que lo
# haga cumplir todavía (docs/MEJORAS.md §2.3). Los avisos de los analizadores no
# se cambian aquí a propósito.
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

[*.{cs,xaml,csproj}]
indent_style = space
indent_size = 4

[*.{yml,json,ps1}]
indent_style = space
indent_size = 2

[*.md]
trim_trailing_whitespace = false
