<Window x:Class="SysDiag.Ui.TrazaWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        xmlns:ui="clr-namespace:SysDiag.Ui"
        Title="Pérdida por salto" Height="720" Width="1010" MinHeight="440" MinWidth="840"
        WindowStyle="None" WindowStartupLocation="CenterOwner"
        Background="{StaticResource BBase}"
        TextOptions.TextFormattingMode="Ideal" UseLayoutRounding="True">

  <shell:WindowChrome.WindowChrome>
    <shell:WindowChrome CaptionHeight="46" ResizeBorderThickness="6"
                        CornerRadius="0" GlassFrameThickness="0"
                        UseAeroCaptionButtons="False"/>
  </shell:WindowChrome.WindowChrome>

  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="46"/>
      <RowDefinition Height="*"/>
    </Grid.RowDefinitions>

    <Border Grid.Row="0" Background="{StaticResource BRail}"
            BorderBrush="{StaticResource BStrokeSoft}" BorderThickness="0,0,0,1">
      <Grid>
        <StackPanel Orientation="Horizontal" Margin="18,0,0,0" VerticalAlignment="Center">
          <Image Source="/Resources/Logo/Lockup.png" Height="22" Stretch="Uniform"
                 RenderOptions.BitmapScalingMode="HighQuality"/>
          <Rectangle Width="1" Height="16" Fill="{StaticResource BStroke}" Margin="16,0,14,0"/>
          <TextBlock Text="Pérdida por salto" Style="{StaticResource Dim}" VerticalAlignment="Center"/>
        </StackPanel>
        <Button HorizontalAlignment="Right" Content="&#xE8BB;" Style="{StaticResource BtnCaptionClose}"
                Click="Cerrar_Click" ToolTip="Cerrar"
                AutomationProperties.Name="Cerrar esta ventana"
                shell:WindowChrome.IsHitTestVisibleInChrome="True"/>
      </Grid>
    </Border>

    <Grid Grid.Row="1" Margin="24,16,24,16" ui:Motion.Enter="True">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="*"/>
        <RowDefinition Height="Auto"/>
      </Grid.RowDefinitions>

      <StackPanel Grid.Row="0">
        <TextBlock Text="Dónde se pierden los paquetes" Style="{StaticResource H1}"/>
        <TextBlock Style="{StaticResource Dim}" Margin="0,5,0,0" TextWrapping="Wrap"
                   Text="El traceroute dice por dónde pasan los paquetes; no dice dónde se pierden. Acá se manda una tanda de pings a cada salto, así que se ve la pérdida y el jitter de cada tramo, no solo el camino."/>
      </StackPanel>

      <Grid Grid.Row="1" Margin="0,16,0,0">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto"/>
          <ColumnDefinition Width="Auto"/>
          <ColumnDefinition Width="Auto"/>
          <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <ComboBox x:Name="ComboDestino" Grid.Column="0" Width="270" IsEditable="True"
                  ToolTip="Escribí cualquier host o IP. La medición usa ICMP, igual que un ping."/>
        <ComboBox x:Name="ComboMuestras" Grid.Column="1" Width="150" Margin="10,0,0,0"
                  ToolTip="Más muestras dan una pérdida más confiable y tardan más: cada salto espera hasta un segundo por respuesta."/>
        <Button x:Name="BtnMedir" Grid.Column="2" Content="Medir" Style="{StaticResource BtnPrimary}"
                Margin="10,0,0,0" Click="Medir_Click"/>
      </Grid>

      <TextBlock Grid.Row="2" x:Name="TxtEstado" Style="{StaticResource Eyebrow}" Margin="0,14,0,0"/>

      <ScrollViewer Grid.Row="3" VerticalScrollBarVisibility="Auto"
                    Margin="0,12,-14,0" Padding="0,0,14,0">
        <StackPanel x:Name="PanelResultado"/>
      </ScrollViewer>

      <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
        <Button Content="Cerrar" Style="{StaticResource BtnGhost}" Click="Cerrar_Click"/>
      </StackPanel>
    </Grid>
  </Grid>
</Window>
