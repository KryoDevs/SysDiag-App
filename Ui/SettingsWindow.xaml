<Window x:Class="SysDiag.Ui.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        SizeToContent="Height" Width="580" ResizeMode="NoResize" MaxHeight="720"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False">

  <Border Style="{StaticResource PanelShell}">
    <DockPanel LastChildFill="True">
      <StackPanel DockPanel.Dock="Top">
        <Rectangle Height="4" Width="46" HorizontalAlignment="Left" RadiusX="2" RadiusY="2"
                   Fill="{StaticResource BAccent}" Margin="0,0,0,16"/>
        <TextBlock Text="Ajustes" Style="{StaticResource H2}"/>
        <TextBlock Style="{StaticResource Dim}" TextWrapping="Wrap" Margin="0,8,0,20"
                   Text="Se aplican de inmediato y quedan guardados para la próxima vez que abras SysDiag."/>
      </StackPanel>

      <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
        <Button Content="Restablecer por defecto" Style="{StaticResource BtnGhost}" Margin="0,0,8,0" Click="Restablecer_Click"/>
        <Button Content="Cerrar" Style="{StaticResource BtnGhost}" Margin="0,0,8,0" Click="Cerrar_Click"/>
        <Button Content="Guardar" Style="{StaticResource BtnPrimary}" Click="Guardar_Click" IsDefault="True"/>
      </StackPanel>

      <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="0,0,-14,0" Padding="0,0,14,0">
        <StackPanel>

          <Grid Style="{StaticResource FilaAjuste}">
            <StackPanel HorizontalAlignment="Left" MaxWidth="360">
              <TextBlock Text="Licencia" Style="{StaticResource Body}" FontWeight="SemiBold"/>
              <TextBlock x:Name="TxtLicencia" Style="{StaticResource Dim}" TextWrapping="Wrap"
                         Text="Estado de la licencia actual."/>
            </StackPanel>
            <Button Content="Activación" Style="{StaticResource BtnQuiet}" HorizontalAlignment="Right"
                    VerticalAlignment="Center" Click="Licencia_Click"
                    ToolTip="Ver el estado, ingresar un código de activación o comprar uno"/>
          </Grid>

          <Grid Style="{StaticResource FilaAjuste}">
            <StackPanel HorizontalAlignment="Left" MaxWidth="360">
              <TextBlock Text="Muestreo de CPU" Style="{StaticResource Body}" FontWeight="SemiBold"/>
              <TextBlock Style="{StaticResource Dim}" TextWrapping="Wrap"
                         Text="Segundos midiendo antes de calcular el uso real por proceso."/>
            </StackPanel>
            <TextBox x:Name="TxtSample" Style="{StaticResource CampoNumero}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
          </Grid>

          <Grid Style="{StaticResource FilaAjuste}">
            <StackPanel HorizontalAlignment="Left" MaxWidth="360">
              <TextBlock Text="Pings por destino" Style="{StaticResource Body}" FontWeight="SemiBold"/>
              <TextBlock Style="{StaticResource Dim}" TextWrapping="Wrap"
                         Text="Más pings, medición de jitter más estable, pero más lento."/>
            </StackPanel>
            <TextBox x:Name="TxtPing" Style="{StaticResource CampoNumero}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
          </Grid>

          <Grid Style="{StaticResource FilaAjuste}">
            <StackPanel HorizontalAlignment="Left" MaxWidth="360">
              <TextBlock Text="Ventana de eventos (días)" Style="{StaticResource Body}" FontWeight="SemiBold"/>
              <TextBlock Style="{StaticResource Dim}" TextWrapping="Wrap"
                         Text="Cuántos días atrás revisa Estabilidad en el registro de Windows."/>
            </StackPanel>
            <TextBox x:Name="TxtEventDays" Style="{StaticResource CampoNumero}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
          </Grid>

          <Grid Style="{StaticResource FilaAjuste}">
            <StackPanel HorizontalAlignment="Left" MaxWidth="360">
              <TextBlock Text="Ventana de errores WHEA (días)" Style="{StaticResource Body}" FontWeight="SemiBold"/>
              <TextBlock Style="{StaticResource Dim}" TextWrapping="Wrap"
                         Text="Más corta que la anterior a propósito: hardware fallando ahora importa más que hace un mes."/>
            </StackPanel>
            <TextBox x:Name="TxtWheaDays" Style="{StaticResource CampoNumero}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
          </Grid>

          <Grid Style="{StaticResource FilaAjuste}">
            <StackPanel HorizontalAlignment="Left" MaxWidth="360">
              <TextBlock Text="Historial a conservar" Style="{StaticResource Body}" FontWeight="SemiBold"/>
              <TextBlock Style="{StaticResource Dim}" TextWrapping="Wrap"
                         Text="Diagnósticos guardados antes de descartar los más viejos."/>
            </StackPanel>
            <TextBox x:Name="TxtHistorial" Style="{StaticResource CampoNumero}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
          </Grid>

          <Grid Margin="0">
            <StackPanel HorizontalAlignment="Left" MaxWidth="360">
              <TextBlock Text="Registros a conservar" Style="{StaticResource Body}" FontWeight="SemiBold"/>
              <TextBlock Style="{StaticResource Dim}" TextWrapping="Wrap"
                         Text="Este cambia recién en el próximo arranque, no en esta sesión."/>
            </StackPanel>
            <TextBox x:Name="TxtLogs" Style="{StaticResource CampoNumero}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
          </Grid>

        </StackPanel>
      </ScrollViewer>
    </DockPanel>
  </Border>
</Window>
