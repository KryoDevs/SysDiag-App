<Window x:Class="SysDiag.Ui.ActivationWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        SizeToContent="Height" Width="620" ResizeMode="NoResize" MaxHeight="760"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False">

  <Border Style="{StaticResource PanelShell}">
    <DockPanel LastChildFill="True">
      <StackPanel DockPanel.Dock="Top">
        <Rectangle Height="4" Width="46" HorizontalAlignment="Left" RadiusX="2" RadiusY="2"
                   Fill="{StaticResource BAccent}" Margin="0,0,0,16"/>
        <TextBlock Text="Activación de SysDiag" Style="{StaticResource H2}"/>
        <TextBlock Style="{StaticResource Dim}" TextWrapping="Wrap" Margin="0,8,0,18"
                   Text="El diagnóstico y la lectura son siempre libres. Las acciones que modifican el equipo —optimizar, instalar, limpiar, reparar— incluyen 14 días de prueba y después requieren un código de activación."/>
      </StackPanel>

      <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
        <Button Content="Comprar un código" Style="{StaticResource BtnGhost}" Margin="0,0,8,0" Click="Comprar_Click"/>
        <Button Content="Cerrar" Style="{StaticResource BtnGhost}" Margin="0,0,8,0" Click="Cerrar_Click"/>
        <Button x:Name="BtnActivar" Content="Activar" Style="{StaticResource BtnPrimary}" Click="Activar_Click" IsDefault="True"/>
      </StackPanel>

      <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="0,0,-14,0" Padding="0,0,14,0">
        <StackPanel>

          <!-- Estado actual de la licencia -->
          <Border Background="{StaticResource BSurface}" CornerRadius="{StaticResource RMd}"
                  BorderBrush="{StaticResource BStrokeSoft}" BorderThickness="1" Padding="18,15">
            <StackPanel>
              <TextBlock Text="ESTADO" Style="{StaticResource SectionLabel}"/>
              <TextBlock x:Name="TxtEstado" Style="{StaticResource H2}" Margin="0,8,0,0"/>
              <TextBlock x:Name="TxtDetalle" Style="{StaticResource Dim}" TextWrapping="Wrap" Margin="0,6,0,0"/>
            </StackPanel>
          </Border>

          <!-- Entrada del código -->
          <TextBlock Text="CÓDIGO DE ACTIVACIÓN" Style="{StaticResource SectionLabel}" Margin="0,20,0,8"/>
          <TextBox x:Name="TxtCodigo" Style="{StaticResource CampoCodigo}"
                   VerticalContentAlignment="Center" Margin="0,0,0,0"
                   ToolTip="SDG7-AAAAA-BBBBB-CCCCC-DDDDD-EEEE"/>
          <TextBlock x:Name="TxtError" Style="{StaticResource Dim}" TextWrapping="Wrap" Margin="0,8,0,0"
                     Foreground="{StaticResource BBad}" Visibility="Collapsed"/>

          <Border Background="{StaticResource BAccentWash}" CornerRadius="{StaticResource RSm}"
                  Padding="13,10" Margin="0,16,0,0">
            <TextBlock Style="{StaticResource Dim}" TextWrapping="Wrap"
                       Text="El código se verifica en tu equipo, sin conexión. Se guarda solo en este equipo; guárdalo en un lugar seguro para reinstalaciones."/>
          </Border>

        </StackPanel>
      </ScrollViewer>
    </DockPanel>
  </Border>
</Window>
