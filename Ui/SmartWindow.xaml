<Window x:Class="SysDiag.Ui.SmartWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        xmlns:ui="clr-namespace:SysDiag.Ui"
        Title="SMART del disco" Height="720" Width="1000" MinHeight="460" MinWidth="800"
        WindowStyle="None" WindowStartupLocation="CenterOwner"
        Background="{StaticResource BBase}"
        TextOptions.TextFormattingMode="Ideal" UseLayoutRounding="True">

  <shell:WindowChrome.WindowChrome>
    <shell:WindowChrome CaptionHeight="46" ResizeBorderThickness="6"
                        CornerRadius="0" GlassFrameThickness="0"
                        UseAeroCaptionButtons="False"/>
  </shell:WindowChrome.WindowChrome>

  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="46"/>
      <RowDefinition Height="*"/>
    </Grid.RowDefinitions>

    <Border Grid.Row="0" Background="{StaticResource BRail}"
            BorderBrush="{StaticResource BStrokeSoft}" BorderThickness="0,0,0,1">
      <Grid>
        <StackPanel Orientation="Horizontal" Margin="18,0,0,0" VerticalAlignment="Center">
          <Image Source="/Resources/Logo/Lockup.png" Height="22" Stretch="Uniform"
                 RenderOptions.BitmapScalingMode="HighQuality"/>
          <Rectangle Width="1" Height="16" Fill="{StaticResource BStroke}" Margin="16,0,14,0"/>
          <TextBlock Text="SMART del disco" Style="{StaticResource Dim}" VerticalAlignment="Center"/>
        </StackPanel>
        <Button HorizontalAlignment="Right" Content="&#xE8BB;" Style="{StaticResource BtnCaptionClose}"
                Click="Cerrar_Click" ToolTip="Cerrar"
                AutomationProperties.Name="Cerrar esta ventana"
                shell:WindowChrome.IsHitTestVisibleInChrome="True"/>
      </Grid>
    </Border>

    <Grid Grid.Row="1" Margin="24,16,24,16" ui:Motion.Enter="True">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="*"/>
        <RowDefinition Height="Auto"/>
      </Grid.RowDefinitions>

      <StackPanel Grid.Row="0" Margin="0,0,0,16">
        <TextBlock Text="Salud del disco, atributo por atributo" Style="{StaticResource H1}"/>
        <TextBlock Style="{StaticResource Dim}" Margin="0,5,0,0" TextWrapping="Wrap"
                   Text="El estado que reporta Windows dice «correcto» hasta que dice «fallido», y en el medio no dice nada. Acá están los atributos que avisan antes: sectores reasignados, sectores que el disco no pudo leer, errores de la interfaz y vida útil restante del SSD."/>
        <TextBlock x:Name="TxtEstado" Style="{StaticResource Eyebrow}" Margin="0,10,0,0"/>
      </StackPanel>

      <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"
                    Margin="0,0,-14,0" Padding="0,0,14,0">
        <StackPanel x:Name="PanelDiscos"/>
      </ScrollViewer>

      <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
        <Button x:Name="BtnLeer" Content="Volver a leer" Style="{StaticResource BtnGhost}"
                Margin="0,0,8,0" Click="Leer_Click"
                ToolTip="Vuelve a consultar los discos. Cada lectura es una foto del momento: nada de lo que ves se guarda."/>
        <Button Content="Cerrar" Style="{StaticResource BtnGhost}" Click="Cerrar_Click"/>
      </StackPanel>
    </Grid>
  </Grid>
</Window>
