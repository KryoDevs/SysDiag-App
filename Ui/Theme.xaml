<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <!-- ================================================================
       SISTEMA VISUAL SysDiag · "Medianoche"

       Paleta: azul medianoche de base, violeta como acento y cian como
       acento secundario. El cian no es arbitrario: es el color del logo,
       y se reserva para lo que está vivo en este instante (operación en
       curso, paso del registro, traza del monitor de ping). El violeta
       es el color de la marca y de la acción.

       Reglas que ordenan el resto:
         · Fondo más oscuro = más profundo. La jerarquía la da la
           elevación de la superficie, no el grosor del borde.
         · Un solo acento por pantalla. El color semántico (verde,
           ámbar, rojo) solo califica datos; nunca decora.
         · Todo número va en monoespaciada, para que las columnas no
           bailen al actualizarse.
       ================================================================ -->

  <!-- ============================ COLORES ============================ -->
  <Color x:Key="CBase">#FF0B1020</Color>
  <Color x:Key="CRail">#FF080C18</Color>
  <Color x:Key="CSurface">#FF141A2E</Color>
  <Color x:Key="CSurfaceAlt">#FF1B2340</Color>
  <Color x:Key="CSurfaceHi">#FF242E52</Color>
  <Color x:Key="CStroke">#FF2C3763</Color>
  <Color x:Key="CStrokeSoft">#FF1A2240</Color>
  <Color x:Key="CText">#FFEDEFFA</Color>
  <Color x:Key="CTextDim">#FFA6B0D4</Color>
  <Color x:Key="CTextMuted">#FF6E79A8</Color>
  <Color x:Key="CAccent">#FF8B7CFF</Color>
  <Color x:Key="CAccentDeep">#FF6D5AE8</Color>
  <Color x:Key="CAccent2">#FF38D6F0</Color>
  <Color x:Key="COk">#FF35D6A0</Color>
  <Color x:Key="CWarn">#FFF5A524</Color>
  <Color x:Key="CBad">#FFFF5470</Color>

  <!-- ============================ PINCELES =========================== -->
  <SolidColorBrush x:Key="BBase" Color="{StaticResource CBase}"/>
  <SolidColorBrush x:Key="BRail" Color="{StaticResource CRail}"/>
  <SolidColorBrush x:Key="BSurface" Color="{StaticResource CSurface}"/>
  <SolidColorBrush x:Key="BSurfaceAlt" Color="{StaticResource CSurfaceAlt}"/>
  <SolidColorBrush x:Key="BSurfaceHi" Color="{StaticResource CSurfaceHi}"/>
  <SolidColorBrush x:Key="BStroke" Color="{StaticResource CStroke}"/>
  <SolidColorBrush x:Key="BStrokeSoft" Color="{StaticResource CStrokeSoft}"/>
  <SolidColorBrush x:Key="BText" Color="{StaticResource CText}"/>
  <SolidColorBrush x:Key="BTextDim" Color="{StaticResource CTextDim}"/>
  <SolidColorBrush x:Key="BTextMuted" Color="{StaticResource CTextMuted}"/>
  <SolidColorBrush x:Key="BAccent" Color="{StaticResource CAccent}"/>
  <SolidColorBrush x:Key="BAccentDeep" Color="{StaticResource CAccentDeep}"/>
  <SolidColorBrush x:Key="BAccent2" Color="{StaticResource CAccent2}"/>
  <SolidColorBrush x:Key="BOk" Color="{StaticResource COk}"/>
  <SolidColorBrush x:Key="BWarn" Color="{StaticResource CWarn}"/>
  <SolidColorBrush x:Key="BBad" Color="{StaticResource CBad}"/>

  <!-- Tinta: texto y trazos que van ENCIMA del violeta. -->
  <SolidColorBrush x:Key="BInk" Color="#FF0A0D1A"/>

  <!-- Superposiciones: se suman sobre cualquier superficie sin cambiar
       su color base, así el hover se siente igual en un botón violeta
       que en uno fantasma. -->
  <SolidColorBrush x:Key="BHover" Color="#FFFFFFFF" Opacity="0.06"/>
  <SolidColorBrush x:Key="BAccentWash" Color="#FF8B7CFF" Opacity="0.16"/>
  <SolidColorBrush x:Key="BAccent2Wash" Color="#FF38D6F0" Opacity="0.14"/>
  <SolidColorBrush x:Key="BTrack" Color="#FFFFFFFF" Opacity="0.07"/>

  <!-- =========================== DEGRADADOS ========================== -->
  <LinearGradientBrush x:Key="GAccent" StartPoint="0,0" EndPoint="0,1">
    <GradientStop Color="#FFA79AFF" Offset="0"/>
    <GradientStop Color="#FF7A67F5" Offset="1"/>
  </LinearGradientBrush>

  <LinearGradientBrush x:Key="GHero" StartPoint="0,0" EndPoint="1,1">
    <GradientStop Color="#FF1E2749" Offset="0"/>
    <GradientStop Color="#FF121833" Offset="1"/>
  </LinearGradientBrush>

  <LinearGradientBrush x:Key="GRail" StartPoint="0,0" EndPoint="0,1">
    <GradientStop Color="#FF0A0F1E" Offset="0"/>
    <GradientStop Color="#FF070A15" Offset="1"/>
  </LinearGradientBrush>

  <LinearGradientBrush x:Key="GPulse" StartPoint="0,0" EndPoint="1,0">
    <GradientStop Color="#FF38D6F0" Offset="0"/>
    <GradientStop Color="#FF8B7CFF" Offset="1"/>
  </LinearGradientBrush>

  <!-- ============================= SOMBRAS =========================== -->
  <DropShadowEffect x:Key="CardShadow" Color="#FF000000" Direction="270"
                    ShadowDepth="3" BlurRadius="14" Opacity="0.40"/>
  <DropShadowEffect x:Key="PanelShadow" Color="#FF000000" Direction="270"
                    ShadowDepth="6" BlurRadius="30" Opacity="0.55"/>

  <!-- ============================ GEOMETRÍA ========================== -->
  <!-- Escala de espaciado sobre base de 4: los valores dejan de ser
       arbitrarios y el ritmo vertical se mantiene entre vistas. -->
  <Thickness x:Key="CardPad">18,16,18,16</Thickness>
  <CornerRadius x:Key="RSm">5</CornerRadius>
  <CornerRadius x:Key="RMd">10</CornerRadius>
  <CornerRadius x:Key="RLg">14</CornerRadius>
  <CornerRadius x:Key="RPill">12</CornerRadius>

  <!-- =========================== TIPOGRAFÍA ========================== -->
  <!-- Segoe UI Variable Display para lo que se lee como titular; la
       Variable Text para el cuerpo; Cascadia Mono lleva cifras
       tabulares, así las columnas de números no bailan. -->
  <FontFamily x:Key="FDisplay">Segoe UI Variable Display, Segoe UI</FontFamily>
  <FontFamily x:Key="FBody">Segoe UI Variable Text, Segoe UI</FontFamily>
  <FontFamily x:Key="FMono">Cascadia Mono, Consolas, Courier New</FontFamily>

  <Style x:Key="Eyebrow" TargetType="TextBlock">
    <Setter Property="FontFamily" Value="{StaticResource FBody}"/>
    <Setter Property="FontSize" Value="10.5"/>
    <Setter Property="FontWeight" Value="SemiBold"/>
    <Setter Property="Foreground" Value="{StaticResource BTextMuted}"/>
  </Style>

  <Style x:Key="Metric" TargetType="TextBlock">
    <Setter Property="FontFamily" Value="{StaticResource FDisplay}"/>
    <Setter Property="FontSize" Value="30"/>
    <Setter Property="FontWeight" Value="SemiBold"/>
    <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
  </Style>

  <Style x:Key="H1" TargetType="TextBlock">
    <Setter Property="FontFamily" Value="{StaticResource FDisplay}"/>
    <Setter Property="FontSize" Value="24"/>
    <Setter Property="FontWeight" Value="SemiBold"/>
    <Setter Property="Foreground" Value="{StaticResource BText}"/>
  </Style>

  <Style x:Key="H2" TargetType="TextBlock">
    <Setter Property="FontFamily" Value="{StaticResource FDisplay}"/>
    <Setter Property="FontSize" Value="17"/>
    <Setter Property="FontWeight" Value="SemiBold"/>
    <Setter Property="Foreground" Value="{StaticResource BText}"/>
  </Style>

  <Style x:Key="Body" TargetType="TextBlock">
    <Setter Property="FontFamily" Value="{StaticResource FBody}"/>
    <Setter Property="FontSize" Value="13"/>
    <Setter Property="Foreground" Value="{StaticResource BText}"/>
  </Style>

  <Style x:Key="Dim" TargetType="TextBlock">
    <Setter Property="FontFamily" Value="{StaticResource FBody}"/>
    <Setter Property="FontSize" Value="12"/>
    <Setter Property="Foreground" Value="{StaticResource BTextDim}"/>
  </Style>

  <Style x:Key="SectionLabel" TargetType="TextBlock" BasedOn="{StaticResource Eyebrow}">
    <Setter Property="Margin" Value="0,0,0,10"/>
  </Style>

  <!-- Distintivo de severidad: fondo tenue del mismo tono que el texto. -->
  <Style x:Key="Chip" TargetType="Border">
    <Setter Property="CornerRadius" Value="{StaticResource RSm}"/>
    <Setter Property="Padding" Value="8,3"/>
    <Setter Property="HorizontalAlignment" Value="Left"/>
    <Setter Property="VerticalAlignment" Value="Center"/>
  </Style>

  <!-- Distintivo mínimo: dice de dónde viene un dato sin competir con él. -->
  <Style x:Key="MiniChip" TargetType="Border">
    <Setter Property="Background" Value="{StaticResource BSurfaceAlt}"/>
    <Setter Property="CornerRadius" Value="{StaticResource RSm}"/>
    <Setter Property="Padding" Value="7,2"/>
    <Setter Property="VerticalAlignment" Value="Center"/>
    <Setter Property="HorizontalAlignment" Value="Left"/>
  </Style>

  <Style x:Key="MiniChipText" TargetType="TextBlock">
    <Setter Property="FontFamily" Value="{StaticResource FBody}"/>
    <Setter Property="FontSize" Value="9.5"/>
    <Setter Property="FontWeight" Value="SemiBold"/>
    <Setter Property="Foreground" Value="{StaticResource BTextMuted}"/>
  </Style>

  <!-- ============================ SUPERFICIES ======================== -->
  <Style x:Key="Card" TargetType="Border">
    <Setter Property="Background" Value="{StaticResource BSurface}"/>
    <Setter Property="BorderBrush" Value="{StaticResource BStrokeSoft}"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="CornerRadius" Value="{StaticResource RMd}"/>
    <Setter Property="Padding" Value="{StaticResource CardPad}"/>
    <Setter Property="Effect" Value="{StaticResource CardShadow}"/>
  </Style>

  <!-- Variante sin relleno: para bloques que cierran una lectura y no
       deben competir con las tarjetas de datos que tienen encima. -->
  <Style x:Key="CardOutline" TargetType="Border">
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="BorderBrush" Value="{StaticResource BStrokeSoft}"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="CornerRadius" Value="{StaticResource RMd}"/>
    <Setter Property="Padding" Value="{StaticResource CardPad}"/>
  </Style>

  <!-- Tarjeta de titular: la única con degradado. reservada al puntaje,
       que es lo primero que se mira al abrir la aplicación. -->
  <Style x:Key="HeroCard" TargetType="Border" BasedOn="{StaticResource Card}">
    <Setter Property="Background" Value="{StaticResource GHero}"/>
    <Setter Property="BorderBrush" Value="{StaticResource BStroke}"/>
    <Setter Property="CornerRadius" Value="{StaticResource RLg}"/>
    <Setter Property="Padding" Value="26,24,26,26"/>
  </Style>

  <Style x:Key="MetricCard" TargetType="Border" BasedOn="{StaticResource Card}">
    <Style.Triggers>
      <Trigger Property="IsMouseOver" Value="True">
        <Setter Property="BorderBrush" Value="{StaticResource BStroke}"/>
        <Setter Property="Background" Value="{StaticResource BSurfaceAlt}"/>
      </Trigger>
    </Style.Triggers>
  </Style>

  <!-- Armazón común de los paneles flotantes (diálogos y ventanas de
       opciones). Centralizarlo aquí es lo que hace que todas las ventanas
       secundarias se vean como la misma aplicación. -->
  <Style x:Key="PanelShell" TargetType="Border">
    <Setter Property="Background" Value="{StaticResource BSurface}"/>
    <Setter Property="BorderBrush" Value="{StaticResource BStroke}"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="CornerRadius" Value="{StaticResource RLg}"/>
    <Setter Property="Padding" Value="26,22,26,20"/>
    <Setter Property="Effect" Value="{StaticResource PanelShadow}"/>
  </Style>

  <!-- Estado de la corrida, en la barra superior. -->
  <Style x:Key="EstadoPill" TargetType="Border">
    <Setter Property="Background" Value="{StaticResource BSurfaceAlt}"/>
    <Setter Property="BorderBrush" Value="{StaticResource BStrokeSoft}"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="CornerRadius" Value="{StaticResource RPill}"/>
    <Setter Property="Padding" Value="11,5"/>
    <Setter Property="VerticalAlignment" Value="Center"/>
  </Style>

  <!-- Punto que late solo mientras hay una operación en curso. -->
  <Style x:Key="PuntoVivo" TargetType="Ellipse">
    <Setter Property="Width" Value="7"/>
    <Setter Property="Height" Value="7"/>
    <Setter Property="Fill" Value="{StaticResource BAccent2}"/>
    <Setter Property="Margin" Value="0,0,7,0"/>
    <Style.Triggers>
      <EventTrigger RoutedEvent="Loaded">
        <BeginStoryboard>
          <Storyboard RepeatBehavior="Forever" AutoReverse="True">
            <DoubleAnimation Storyboard.TargetProperty="Opacity" From="1" To="0.25" Duration="0:0:0.7"/>
          </Storyboard>
        </BeginStoryboard>
      </EventTrigger>
    </Style.Triggers>
  </Style>

  <!-- ================================================================
       Desplazamiento. La barra nativa es clara y con flechas; retemplada
       queda fina, redondeada y muda, para no competir con el contenido.
       ================================================================ -->
  <Style x:Key="ScrollThumb" TargetType="Thumb">
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Thumb">
          <Border Background="{StaticResource BStroke}" CornerRadius="3" Margin="3,0"/>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style TargetType="ScrollBar">
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="Width" Value="10"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ScrollBar">
          <Grid Background="Transparent">
            <Track x:Name="PART_Track" IsDirectionReversed="True">
              <Track.DecreaseRepeatButton>
                <RepeatButton Command="ScrollBar.PageUpCommand" Opacity="0" Focusable="False"/>
              </Track.DecreaseRepeatButton>
              <Track.Thumb>
                <Thumb Style="{StaticResource ScrollThumb}"/>
              </Track.Thumb>
              <Track.IncreaseRepeatButton>
                <RepeatButton Command="ScrollBar.PageDownCommand" Opacity="0" Focusable="False"/>
              </Track.IncreaseRepeatButton>
            </Track>
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="Orientation" Value="Horizontal">
              <Setter Property="Height" Value="10"/>
              <Setter Property="Width" Value="Auto"/>
              <Setter TargetName="PART_Track" Property="IsDirectionReversed" Value="False"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- ================================================================
       Botones. El hover es una capa blanca translúcida sobre el fondo,
       no un cambio de opacidad: así el texto sigue siendo legible sobre
       el violeta y sobre el fantasma por igual.
       ================================================================ -->
  <Style x:Key="BtnBase" TargetType="Button">
    <Setter Property="FontFamily" Value="{StaticResource FBody}"/>
    <Setter Property="FontSize" Value="13"/>
    <Setter Property="Foreground" Value="{StaticResource BText}"/>
    <Setter Property="Padding" Value="16,9"/>
    <Setter Property="Cursor" Value="Hand"/>
    <Setter Property="SnapsToDevicePixels" Value="True"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Border x:Name="Bd" Background="{TemplateBinding Background}"
                  BorderBrush="{TemplateBinding BorderBrush}"
                  BorderThickness="1" CornerRadius="{StaticResource RSm}">
            <Grid>
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                Margin="{TemplateBinding Padding}"/>
              <Border x:Name="Luz" Background="{StaticResource BHover}"
                      CornerRadius="{StaticResource RSm}" Opacity="0" IsHitTestVisible="False"/>
            </Grid>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Luz" Property="Opacity" Value="1"/>
              <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource BAccent}"/>
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter TargetName="Bd" Property="Opacity" Value="0.35"/>
              <Setter Property="Cursor" Value="Arrow"/>
            </Trigger>
            <Trigger Property="IsKeyboardFocused" Value="True">
              <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource BAccent2}"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style x:Key="BtnPrimary" TargetType="Button" BasedOn="{StaticResource BtnBase}">
    <Setter Property="Background" Value="{StaticResource GAccent}"/>
    <Setter Property="BorderBrush" Value="{StaticResource BAccentDeep}"/>
    <Setter Property="Foreground" Value="{StaticResource BInk}"/>
    <Setter Property="FontWeight" Value="SemiBold"/>
  </Style>

  <Style x:Key="BtnGhost" TargetType="Button" BasedOn="{StaticResource BtnBase}">
    <Setter Property="Background" Value="{StaticResource BSurfaceAlt}"/>
    <Setter Property="BorderBrush" Value="{StaticResource BStroke}"/>
  </Style>

  <!-- Sin caja: para acciones secundarias del pie, donde cuatro botones
       enmarcados seguidos pesan más que la acción principal. El hover
       tampoco dibuja borde: con cinco botones en fila, el borde que
       aparece y desaparece distrae más de lo que orienta. -->
  <Style x:Key="BtnQuiet" TargetType="Button" BasedOn="{StaticResource BtnBase}">
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="BorderBrush" Value="Transparent"/>
    <Setter Property="Foreground" Value="{StaticResource BTextDim}"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Border x:Name="Bd" Background="{TemplateBinding Background}"
                  BorderBrush="{TemplateBinding BorderBrush}"
                  BorderThickness="1" CornerRadius="{StaticResource RSm}">
            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                              Margin="{TemplateBinding Padding}"/>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Bd" Property="Background" Value="{StaticResource BHover}"/>
              <Setter Property="Foreground" Value="{StaticResource BText}"/>
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter TargetName="Bd" Property="Opacity" Value="0.35"/>
              <Setter Property="Cursor" Value="Arrow"/>
            </Trigger>
            <Trigger Property="IsKeyboardFocused" Value="True">
              <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource BAccent2}"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style x:Key="BtnCaption" TargetType="Button">
    <Setter Property="Width" Value="46"/>
    <Setter Property="Height" Value="34"/>
    <Setter Property="Foreground" Value="{StaticResource BTextMuted}"/>
    <Setter Property="FontFamily" Value="Segoe Fluent Icons, Segoe MDL2 Assets"/>
    <Setter Property="FontSize" Value="10"/>
    <Setter Property="Cursor" Value="Arrow"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Border x:Name="Bd" Background="Transparent">
            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Bd" Property="Background" Value="{StaticResource BHover}"/>
              <Setter Property="Foreground" Value="{StaticResource BText}"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style x:Key="BtnCaptionClose" TargetType="Button" BasedOn="{StaticResource BtnCaption}">
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Border x:Name="Bd" Background="Transparent">
            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Bd" Property="Background" Value="{StaticResource BBad}"/>
              <Setter Property="Foreground" Value="White"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- ================================================================
       Conmutador de vistas. Pastillas dentro de una bandeja: el activo
       se rellena de violeta, así se distingue del resto a un golpe de
       vista sin depender solo del texto.
       ================================================================ -->
  <Style x:Key="SegmentBar" TargetType="Border">
    <Setter Property="Background" Value="{StaticResource BSurface}"/>
    <Setter Property="BorderBrush" Value="{StaticResource BStrokeSoft}"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="CornerRadius" Value="9"/>
    <Setter Property="Padding" Value="4"/>
    <Setter Property="VerticalAlignment" Value="Center"/>
    <Setter Property="SnapsToDevicePixels" Value="True"/>
  </Style>

  <Style x:Key="Segment" TargetType="RadioButton">
    <Setter Property="FontFamily" Value="{StaticResource FBody}"/>
    <Setter Property="FontSize" Value="12.5"/>
    <Setter Property="Foreground" Value="{StaticResource BTextDim}"/>
    <Setter Property="Cursor" Value="Hand"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="RadioButton">
          <Border x:Name="Bd" Background="Transparent" CornerRadius="6" Padding="14,6">
            <ContentPresenter VerticalAlignment="Center" HorizontalAlignment="Center"/>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Bd" Property="Background" Value="{StaticResource BHover}"/>
            </Trigger>
            <Trigger Property="IsChecked" Value="True">
              <Setter TargetName="Bd" Property="Background" Value="{StaticResource GAccent}"/>
              <Setter Property="Foreground" Value="{StaticResource BInk}"/>
              <Setter Property="FontWeight" Value="SemiBold"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- ================================================================
       Rail de navegación. Es un ListBox y no botones sueltos: así el
       módulo activo queda marcado solo, sin estado que sincronizar.
       ================================================================ -->
  <Style x:Key="NavItem" TargetType="ListBoxItem">
    <Setter Property="Padding" Value="0"/>
    <Setter Property="Cursor" Value="Hand"/>
    <Setter Property="Foreground" Value="{StaticResource BTextDim}"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ListBoxItem">
          <Grid>
            <Border x:Name="Bd" Background="Transparent" CornerRadius="0"/>
            <Rectangle x:Name="Mark" Width="3" RadiusX="2" RadiusY="2" Margin="0,7"
                       HorizontalAlignment="Left" Fill="{StaticResource BAccent}"
                       Visibility="Collapsed"/>
            <ContentPresenter Margin="15,9" VerticalAlignment="Center"/>
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Bd" Property="Background" Value="{StaticResource BHover}"/>
              <Setter Property="Foreground" Value="{StaticResource BText}"/>
            </Trigger>
            <Trigger Property="IsSelected" Value="True">
              <Setter TargetName="Bd" Property="Background" Value="{StaticResource BAccentWash}"/>
              <Setter TargetName="Mark" Property="Visibility" Value="Visible"/>
              <Setter Property="Foreground" Value="{StaticResource BText}"/>
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter Property="Opacity" Value="0.45"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- Encabezado de grupo: no es un destino, es una etiqueta. Va dentro
       de la lista para que el desplazamiento la arrastre con su grupo. -->
  <Style x:Key="NavGroupItem" TargetType="ListBoxItem">
    <Setter Property="IsEnabled" Value="False"/>
    <Setter Property="Focusable" Value="False"/>
    <Setter Property="IsHitTestVisible" Value="False"/>
    <Setter Property="Padding" Value="0"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ListBoxItem">
          <ContentPresenter Margin="14,14,12,6"/>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style x:Key="NavGroup" TargetType="TextBlock" BasedOn="{StaticResource Eyebrow}">
    <Setter Property="FontSize" Value="9.5"/>
    <Setter Property="Foreground" Value="{StaticResource BTextMuted}"/>
  </Style>

  <!-- Sin color propio: hereda el del ítem, de modo que la navegación
       entera cambia de tono con un solo desencadenante. -->
  <Style x:Key="NavIcon" TargetType="TextBlock">
    <Setter Property="FontFamily" Value="Segoe Fluent Icons, Segoe MDL2 Assets"/>
    <Setter Property="FontSize" Value="15"/>
    <Setter Property="Width" Value="24"/>
    <Setter Property="VerticalAlignment" Value="Center"/>
    <Setter Property="TextAlignment" Value="Center"/>
  </Style>

  <Style x:Key="NavLabel" TargetType="TextBlock">
    <Setter Property="FontFamily" Value="{StaticResource FBody}"/>
    <Setter Property="FontSize" Value="12.5"/>
    <Setter Property="VerticalAlignment" Value="Center"/>
    <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
  </Style>

  <!-- Llamada principal del rail: diagnóstico completo. -->
  <Style x:Key="CtaIcon" TargetType="TextBlock">
    <Setter Property="FontFamily" Value="Segoe Fluent Icons, Segoe MDL2 Assets"/>
    <Setter Property="FontSize" Value="14"/>
    <Setter Property="Margin" Value="0,0,9,0"/>
    <Setter Property="VerticalAlignment" Value="Center"/>
  </Style>

  <Style x:Key="CtaLabel" TargetType="TextBlock">
    <Setter Property="FontFamily" Value="{StaticResource FBody}"/>
    <Setter Property="FontSize" Value="12.5"/>
    <Setter Property="FontWeight" Value="SemiBold"/>
    <Setter Property="VerticalAlignment" Value="Center"/>
  </Style>

  <!-- La plantilla nativa del ListBox pinta el fondo del sistema (blanco)
       cuando el control está deshabilitado, que es justo lo que pasa
       mientras corre un módulo. Se reemplaza entera para que no quede
       ningún camino por el que se cuele un color ajeno a la paleta. -->
  <Style x:Key="PlainList" TargetType="ListBox">
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="BorderThickness" Value="0"/>
    <Setter Property="Foreground" Value="{StaticResource BText}"/>
    <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ListBox">
          <Border Background="Transparent" BorderThickness="0">
            <ScrollViewer Focusable="False" Padding="0" Background="Transparent">
              <ItemsPresenter SnapsToDevicePixels="True"/>
            </ScrollViewer>
          </Border>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- Fila de hallazgo: franja de severidad + área + qué pasó. -->
  <Style x:Key="FindingItem" TargetType="ListBoxItem">
    <Setter Property="Padding" Value="0"/>
    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ListBoxItem">
          <Border x:Name="Bd" Background="Transparent" BorderBrush="{StaticResource BStrokeSoft}"
                  BorderThickness="0,0,0,1">
            <Grid>
              <Rectangle x:Name="Marca" Width="3" HorizontalAlignment="Left"
                         Fill="{StaticResource BAccent}" Visibility="Collapsed"/>
              <ContentPresenter Margin="0"/>
            </Grid>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Bd" Property="Background" Value="{StaticResource BHover}"/>
            </Trigger>
            <Trigger Property="IsSelected" Value="True">
              <Setter TargetName="Bd" Property="Background" Value="{StaticResource BSurfaceAlt}"/>
              <Setter TargetName="Marca" Property="Visibility" Value="Visible"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- ================================================================
       ComboBox retemplado por completo: el nativo despliega en blanco.
       ================================================================ -->
  <ControlTemplate x:Key="ComboToggle" TargetType="ToggleButton">
    <Border Background="{StaticResource BSurfaceAlt}" BorderBrush="{StaticResource BStroke}"
            BorderThickness="1" CornerRadius="{StaticResource RSm}">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="30"/>
        </Grid.ColumnDefinitions>
        <ContentPresenter Grid.Column="0" Margin="13,0,0,0" VerticalAlignment="Center"
                          Content="{Binding SelectedItem, RelativeSource={RelativeSource AncestorType=ComboBox}}"/>
        <Path Grid.Column="1" HorizontalAlignment="Center" VerticalAlignment="Center"
              Data="M0,0 L8,0 L4,5 Z" Fill="{StaticResource BTextDim}"/>
      </Grid>
    </Border>
  </ControlTemplate>

  <Style TargetType="ComboBox">
    <Setter Property="FontFamily" Value="{StaticResource FBody}"/>
    <Setter Property="FontSize" Value="12.5"/>
    <Setter Property="Foreground" Value="{StaticResource BText}"/>
    <Setter Property="Height" Value="36"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ComboBox">
          <Grid>
            <ToggleButton Template="{StaticResource ComboToggle}"
                          IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"
                          Focusable="False" ClickMode="Press"/>
            <Popup IsOpen="{TemplateBinding IsDropDownOpen}" Placement="Bottom"
                   AllowsTransparency="True" PopupAnimation="Fade" Focusable="False">
              <Border Background="{StaticResource BSurfaceAlt}" BorderBrush="{StaticResource BStroke}"
                      BorderThickness="1" CornerRadius="{StaticResource RMd}" Margin="0,5,0,0"
                      MinWidth="{TemplateBinding ActualWidth}">
                <ScrollViewer MaxHeight="320">
                  <StackPanel IsItemsHost="True"/>
                </ScrollViewer>
              </Border>
            </Popup>
          </Grid>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style TargetType="ComboBoxItem">
    <Setter Property="Padding" Value="13,8"/>
    <Setter Property="Foreground" Value="{StaticResource BText}"/>
    <Setter Property="Cursor" Value="Hand"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ComboBoxItem">
          <Border x:Name="Bd" Background="Transparent" Padding="{TemplateBinding Padding}">
            <ContentPresenter/>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Bd" Property="Background" Value="{StaticResource BHover}"/>
            </Trigger>
            <Trigger Property="IsSelected" Value="True">
              <Setter TargetName="Bd" Property="Background" Value="{StaticResource BAccentWash}"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- ================================================================
       DataGrid: sin líneas verticales, cabecera discreta, datos en mono.
       ================================================================ -->
  <Style TargetType="DataGridColumnHeader">
    <Setter Property="Background" Value="#FF10162A"/>
    <Setter Property="Foreground" Value="{StaticResource BTextMuted}"/>
    <Setter Property="FontFamily" Value="{StaticResource FBody}"/>
    <Setter Property="FontSize" Value="10.5"/>
    <Setter Property="FontWeight" Value="SemiBold"/>
    <Setter Property="Padding" Value="13,11"/>
    <Setter Property="BorderBrush" Value="{StaticResource BStroke}"/>
    <Setter Property="BorderThickness" Value="0,0,0,1"/>
    <Setter Property="HorizontalContentAlignment" Value="Left"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="DataGridColumnHeader">
          <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                  BorderThickness="{TemplateBinding BorderThickness}" Padding="{TemplateBinding Padding}">
            <ContentPresenter VerticalAlignment="Center"/>
          </Border>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style TargetType="DataGridCell">
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="BorderThickness" Value="0"/>
    <Setter Property="Foreground" Value="{StaticResource BText}"/>
    <Setter Property="FontFamily" Value="{StaticResource FMono}"/>
    <Setter Property="FontSize" Value="12"/>
    <Setter Property="Padding" Value="13,8"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="DataGridCell">
          <Border Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
            <ContentPresenter VerticalAlignment="Center"/>
          </Border>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style TargetType="DataGridRow">
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="BorderBrush" Value="{StaticResource BStrokeSoft}"/>
    <Setter Property="BorderThickness" Value="0,0,0,1"/>
    <Style.Triggers>
      <Trigger Property="IsMouseOver" Value="True">
        <Setter Property="Background" Value="{StaticResource BHover}"/>
      </Trigger>
      <Trigger Property="IsSelected" Value="True">
        <Setter Property="Background" Value="{StaticResource BAccentWash}"/>
      </Trigger>
    </Style.Triggers>
  </Style>

  <Style TargetType="DataGrid">
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="BorderThickness" Value="0"/>
    <Setter Property="RowBackground" Value="Transparent"/>
    <Setter Property="GridLinesVisibility" Value="None"/>
    <Setter Property="HeadersVisibility" Value="Column"/>
    <Setter Property="AutoGenerateColumns" Value="True"/>
    <Setter Property="IsReadOnly" Value="True"/>
    <Setter Property="CanUserAddRows" Value="False"/>
    <Setter Property="CanUserDeleteRows" Value="False"/>
    <Setter Property="SelectionMode" Value="Single"/>
    <Setter Property="SelectionUnit" Value="FullRow"/>
    <Setter Property="EnableRowVirtualization" Value="True"/>
    <Setter Property="ColumnWidth" Value="Auto"/>
    <Setter Property="RowHeaderWidth" Value="0"/>
  </Style>

  <!-- Barra de progreso indeterminada propia: la nativa ignora el color. -->
  <Style x:Key="Pulse" TargetType="ProgressBar">
    <Setter Property="Height" Value="3"/>
    <Setter Property="IsIndeterminate" Value="True"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ProgressBar">
          <Grid x:Name="Root" Background="{StaticResource BStrokeSoft}" ClipToBounds="True">
            <Border x:Name="Bar" Background="{StaticResource GPulse}" Width="160"
                    HorizontalAlignment="Left">
              <Border.RenderTransform>
                <TranslateTransform x:Name="Slide" X="-160"/>
              </Border.RenderTransform>
            </Border>
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="IsIndeterminate" Value="True">
              <Trigger.EnterActions>
                <BeginStoryboard x:Name="Anim">
                  <Storyboard RepeatBehavior="Forever">
                    <DoubleAnimation Storyboard.TargetName="Slide" Storyboard.TargetProperty="X"
                                     From="-160" To="900" Duration="0:0:1.5"/>
                  </Storyboard>
                </BeginStoryboard>
              </Trigger.EnterActions>
              <Trigger.ExitActions>
                <StopStoryboard BeginStoryboardName="Anim"/>
              </Trigger.ExitActions>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- ================================================================
       Entradas
       ================================================================ -->
  <Style x:Key="CampoNumero" TargetType="TextBox">
    <Setter Property="Width" Value="72"/>
    <Setter Property="Height" Value="36"/>
    <Setter Property="Background" Value="{StaticResource BSurfaceAlt}"/>
    <Setter Property="Foreground" Value="{StaticResource BText}"/>
    <Setter Property="FontFamily" Value="{StaticResource FMono}"/>
    <Setter Property="FontSize" Value="13"/>
    <Setter Property="TextAlignment" Value="Center"/>
    <Setter Property="VerticalContentAlignment" Value="Center"/>
    <Setter Property="BorderBrush" Value="{StaticResource BStroke}"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="CaretBrush" Value="{StaticResource BAccent}"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="TextBox">
          <Border x:Name="Bd" Background="{TemplateBinding Background}"
                  BorderBrush="{TemplateBinding BorderBrush}"
                  BorderThickness="{TemplateBinding BorderThickness}"
                  CornerRadius="{StaticResource RSm}">
            <ScrollViewer x:Name="PART_ContentHost" VerticalAlignment="Center" Margin="6,0"/>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsKeyboardFocused" Value="True">
              <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource BAccent}"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- Fila de un panel de ajustes: etiqueta a la izquierda, valor a la
       derecha, separación constante. -->
  <Style x:Key="FilaAjuste" TargetType="Grid">
    <Setter Property="Margin" Value="0,0,0,14"/>
  </Style>

  <!-- Casilla de opción con franja de riesgo, compartida por los diálogos
       de limpieza y optimización. -->
  <Style x:Key="Opcion" TargetType="CheckBox">
    <Setter Property="Cursor" Value="Hand"/>
    <Setter Property="FontFamily" Value="{StaticResource FBody}"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="CheckBox">
          <Border x:Name="Bd" Background="Transparent" CornerRadius="8" Padding="14,12" Margin="0,0,0,8">
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="3"/>
                <ColumnDefinition Width="30"/>
                <ColumnDefinition Width="*"/>
              </Grid.ColumnDefinitions>
              <Rectangle Grid.Column="0" Width="3" RadiusX="2" RadiusY="2"
                         Fill="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}}"/>
              <Border x:Name="Box" Grid.Column="1" Width="18" Height="18" CornerRadius="5"
                      BorderBrush="{StaticResource BStroke}" BorderThickness="1.5"
                      VerticalAlignment="Top" Margin="12,1,0,0" Background="Transparent">
                <Path x:Name="Tick" Data="M0,4.5 L3.5,8 L10,0" Stroke="{StaticResource BInk}"
                      StrokeThickness="2" Stretch="None" Margin="3,4,0,0" Visibility="Collapsed"/>
              </Border>
              <ContentPresenter Grid.Column="2" Margin="12,0,0,0"/>
            </Grid>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Bd" Property="Background" Value="{StaticResource BHover}"/>
            </Trigger>
            <Trigger Property="IsChecked" Value="True">
              <Setter TargetName="Box" Property="Background" Value="{StaticResource GAccent}"/>
              <Setter TargetName="Box" Property="BorderBrush" Value="{StaticResource BAccentDeep}"/>
              <Setter TargetName="Tick" Property="Visibility" Value="Visible"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- ================================================================
       Gráfico de barras. Etiqueta a la izquierda, barra al centro y
       cifra a la derecha: se lee por columnas o comparando longitudes,
       sin tener que interpretar ejes. El riel de fondo marca el máximo
       del conjunto, que es la escala con la que se dibujaron.
       ================================================================ -->
  <DataTemplate x:Key="BarTemplate">
    <Grid Margin="0,0,0,11" ToolTip="{Binding Detalle}">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="176"/>
        <ColumnDefinition Width="Auto"/>
        <ColumnDefinition Width="Auto"/>
      </Grid.ColumnDefinitions>
      <TextBlock Grid.Column="0" Text="{Binding Etiqueta}" Style="{StaticResource Dim}"
                 VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Margin="0,0,16,0"/>
      <Grid Grid.Column="1" VerticalAlignment="Center">
        <Rectangle Width="420" Height="10" RadiusX="5" RadiusY="5"
                   Fill="{StaticResource BTrack}" HorizontalAlignment="Left"/>
        <Rectangle Height="10" RadiusX="5" RadiusY="5" HorizontalAlignment="Left"
                   Fill="{Binding Color}" Width="{Binding Ancho}"/>
      </Grid>
      <TextBlock Grid.Column="2" Text="{Binding ValorTexto}" FontFamily="{StaticResource FMono}"
                 FontSize="12" Foreground="{Binding Color}" VerticalAlignment="Center"
                 Margin="16,0,0,0" MinWidth="64"/>
    </Grid>
  </DataTemplate>

  <Style TargetType="ToolTip">
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ToolTip">
          <Border Background="{StaticResource BSurfaceHi}" BorderBrush="{StaticResource BStroke}"
                  BorderThickness="1" CornerRadius="{StaticResource RSm}" Padding="11,7"
                  Effect="{StaticResource CardShadow}">
            <ContentPresenter TextBlock.Foreground="{StaticResource BText}"
                              TextBlock.FontFamily="{StaticResource FBody}"
                              TextBlock.FontSize="12"/>
          </Border>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

</ResourceDictionary>
