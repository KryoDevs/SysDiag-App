<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <!-- ================================================================
       SISTEMA VISUAL SysDiag · "Medianoche"

       Paleta: azul medianoche de base, violeta como acento y cian como
       acento secundario. El cian no es arbitrario: es el color del logo,
       y se reserva para lo que está vivo en este instante (operación en
       curso, paso del registro, traza del monitor de ping). El violeta
       es el color de la marca y de la acción.

       Reglas que ordenan el resto:
         · Fondo más oscuro = más profundo. La jerarquía la da la
           elevación de la superficie, no el grosor del borde.
         · Un solo acento por pantalla. El color semántico (verde,
           ámbar, rojo) solo califica datos; nunca decora.
         · Todo número va en monoespaciada, para que las columnas no
           bailen al actualizarse.
       ================================================================ -->

  <!-- ============================ COLORES ============================ -->
  <Color x:Key="CBase">#FF0B1020</Color>
  <Color x:Key="CRail">#FF080C18</Color>
  <Color x:Key="CSurface">#FF141A2E</Color>
  <Color x:Key="CSurfaceAlt">#FF1B2340</Color>
  <Color x:Key="CSurfaceHi">#FF242E52</Color>
  <Color x:Key="CStroke">#FF2C3763</Color>
  <Color x:Key="CStrokeSoft">#FF1A2240</Color>
  <Color x:Key="CText">#FFEDEFFA</Color>
  <Color x:Key="CTextDim">#FFA6B0D4</Color>
  <!-- El texto tenue es el único color del tema que estaba por debajo del mínimo
       de contraste: 4,47 sobre el fondo base, 4,08 sobre la superficie y 3,65
       sobre la superficie alterna, y se usa en rótulos de 10,5 px (Eyebrow,
       SectionLabel, NavGroup, los chips). Subido a #808CC2: 5,81 / 5,30 / 4,74.
       Mismo matiz frío, mismo peso visual, y ahora cumple AA en los cuatro
       fundos. La regla la fija TemaRegressionTests, no este comentario. -->
  <Color x:Key="CTextMuted">#FF808CC2</Color>
  <Color x:Key="CAccent">#FF8B7CFF</Color>
  <Color x:Key="CAccentDeep">#FF6D5AE8</Color>
  <Color x:Key="CAccent2">#FF38D6F0</Color>
  <Color x:Key="COk">#FF35D6A0</Color>
  <Color x:Key="CWarn">#FFF5A524</Color>
  <Color x:Key="CBad">#FFFF5470</Color>

  <!-- ============================ PINCELES =========================== -->
  <SolidColorBrush x:Key="BBase" Color="{StaticResource CBase}"/>
  <SolidColorBrush x:Key="BRail" Color="{StaticResource CRail}"/>
  <SolidColorBrush x:Key="BSurface" Color="{StaticResource CSurface}"/>
  <SolidColorBrush x:Key="BSurfaceAlt" Color="{StaticResource CSurfaceAlt}"/>
  <SolidColorBrush x:Key="BSurfaceHi" Color="{StaticResource CSurfaceHi}"/>
  <SolidColorBrush x:Key="BStroke" Color="{StaticResource CStroke}"/>
  <SolidColorBrush x:Key="BStrokeSoft" Color="{StaticResource CStrokeSoft}"/>
  <SolidColorBrush x:Key="BText" Color="{StaticResource CText}"/>
  <SolidColorBrush x:Key="BTextDim" Color="{StaticResource CTextDim}"/>
  <SolidColorBrush x:Key="BTextMuted" Color="{StaticResource CTextMuted}"/>
  <SolidColorBrush x:Key="BAccent" Color="{StaticResource CAccent}"/>
  <SolidColorBrush x:Key="BAccentDeep" Color="{StaticResource CAccentDeep}"/>
  <SolidColorBrush x:Key="BAccent2" Color="{StaticResource CAccent2}"/>
  <SolidColorBrush x:Key="BOk" Color="{StaticResource COk}"/>
  <SolidColorBrush x:Key="BWarn" Color="{StaticResource CWarn}"/>
  <SolidColorBrush x:Key="BBad" Color="{StaticResource CBad}"/>

  <!-- Tinta: texto y trazos que van ENCIMA del violeta. -->
  <SolidColorBrush x:Key="BInk" Color="#FF0A0D1A"/>

  <!-- Superposiciones: se suman sobre cualquier superficie sin cambiar
       su color base, así el hover se siente igual en un botón violeta
       que en uno fantasma. -->
  <SolidColorBrush x:Key="BHover" Color="#FFFFFFFF" Opacity="0.06"/>
  <SolidColorBrush x:Key="BAccentWash" Color="#FF8B7CFF" Opacity="0.16"/>
  <SolidColorBrush x:Key="BAccent2Wash" Color="#FF38D6F0" Opacity="0.14"/>
  <SolidColorBrush x:Key="BTrack" Color="#FFFFFFFF" Opacity="0.07"/>

  <!-- =========================== DEGRADADOS ========================== -->
  <LinearGradientBrush x:Key="GAccent" StartPoint="0,0" EndPoint="0,1">
    <GradientStop Color="#FFA79AFF" Offset="0"/>
    <GradientStop Color="#FF7A67F5" Offset="1"/>
  </LinearGradientBrush>

  <LinearGradientBrush x:Key="GHero" StartPoint="0,0" EndPoint="1,1">
    <GradientStop Color="#FF1E2749" Offset="0"/>
    <GradientStop Color="#FF121833" Offset="1"/>
  </LinearGradientBrush>

  <LinearGradientBrush x:Key="GRail" StartPoint="0,0" EndPoint="0,1">
    <GradientStop Color="#FF0A0F1E" Offset="0"/>
    <GradientStop Color="#FF070A15" Offset="1"/>
  </LinearGradientBrush>

  <LinearGradientBrush x:Key="GPulse" StartPoint="0,0" EndPoint="1,0">
    <GradientStop Color="#FF38D6F0" Offset="0"/>
    <GradientStop Color="#FF8B7CFF" Offset="1"/>
  </LinearGradientBrush>

  <!-- =========================== MOVIMIENTO ==========================
       Tres tiempos y cuatro curvas. Como con las medidas, el movimiento deja
       de ser un número suelto cuando se elige de una escala:

         · 0,11 s  — lo que sigue al puntero. Tiene que sentirse inmediato;
                     pasado ese umbral se lee como lag.
         · 0,19 s  — lo que entra y sale (hover, selección, casilla marcada).
         · 0,34 s  — lo que acompaña un resultado nuevo (el puntaje, atenuar
                     la vista mientras se mide). Es el único lento.

       Ninguna animación decora: cada una señala un cambio de estado. Si un
       elemento no cambia de estado, no se mueve.

       Las duraciones van escritas en cada animación y no como recursos
       {StaticResource}: un recurso de tipo Duration obligaría al lector de
       XAML a convertir una cadena en una estructura, y ese es el tipo de
       detalle que rompe la carga del diccionario entero. Las curvas sí se
       comparten: son objetos normales, sin conversión de por medio.

       El sistema puede pedir no animar los controles; Ui/Motion.cs lo respeta
       y aplica el valor final en seco. Los hovers viven en el tema y siguen
       animando, que es lo correcto: son realimentación, no decoración.
       ==================================================================== -->
  <CubicEase x:Key="EEaseSalida" EasingMode="EaseOut"/>
  <CubicEase x:Key="EEaseSuave" EasingMode="EaseInOut"/>
  <QuadraticEase x:Key="EEaseAcelerando" EasingMode="EaseIn"/>
  <BackEase x:Key="EEaseSalto" EasingMode="EaseOut" Amplitude="0.28"/>

  <!-- ============================= SOMBRAS =========================== -->
  <DropShadowEffect x:Key="CardShadow" Color="#FF000000" Direction="270"
                    ShadowDepth="3" BlurRadius="14" Opacity="0.40"/>
  <DropShadowEffect x:Key="PanelShadow" Color="#FF000000" Direction="270"
                    ShadowDepth="6" BlurRadius="30" Opacity="0.55"/>

  <!-- ============================ GEOMETRÍA ========================== -->
  <!-- Escala de espaciado sobre base de 4: los valores dejan de ser
       arbitrarios y el ritmo vertical se mantiene entre vistas. -->
  <Thickness x:Key="CardPad">18,16,18,16</Thickness>
  <CornerRadius x:Key="RSm">5</CornerRadius>
  <CornerRadius x:Key="RMd">10</CornerRadius>
  <CornerRadius x:Key="RLg">14</CornerRadius>
  <CornerRadius x:Key="RPill">12</CornerRadius>

  <!-- =========================== TIPOGRAFÍA ========================== -->
  <!-- Segoe UI Variable Display para lo que se lee como titular; la
       Variable Text para el cuerpo; Cascadia Mono lleva cifras
       tabulares, así las columnas de números no bailan. -->
  <FontFamily x:Key="FDisplay">Segoe UI Variable Display, Segoe UI</FontFamily>
  <FontFamily x:Key="FBody">Segoe UI Variable Text, Segoe UI</FontFamily>
  <FontFamily x:Key="FMono">Cascadia Mono, Consolas, Courier New</FontFamily>

  <Style x:Key="Eyebrow" TargetType="TextBlock">
    <Setter Property="FontFamily" Value="{StaticResource FBody}"/>
    <Setter Property="FontSize" Value="10.5"/>
    <Setter Property="FontWeight" Value="SemiBold"/>
    <Setter Property="Foreground" Value="{StaticResource BTextMuted}"/>
  </Style>

  <Style x:Key="Metric" TargetType="TextBlock">
    <Setter Property="FontFamily" Value="{StaticResource FDisplay}"/>
    <Setter Property="FontSize" Value="30"/>
    <Setter Property="FontWeight" Value="SemiBold"/>
    <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
  </Style>

  <Style x:Key="H1" TargetType="TextBlock">
    <Setter Property="FontFamily" Value="{StaticResource FDisplay}"/>
    <Setter Property="FontSize" Value="24"/>
    <Setter Property="FontWeight" Value="SemiBold"/>
    <Setter Property="Foreground" Value="{StaticResource BText}"/>
  </Style>

  <Style x:Key="H2" TargetType="TextBlock">
    <Setter Property="FontFamily" Value="{StaticResource FDisplay}"/>
    <Setter Property="FontSize" Value="17"/>
    <Setter Property="FontWeight" Value="SemiBold"/>
    <Setter Property="Foreground" Value="{StaticResource BText}"/>
  </Style>

  <Style x:Key="Body" TargetType="TextBlock">
    <Setter Property="FontFamily" Value="{StaticResource FBody}"/>
    <Setter Property="FontSize" Value="13"/>
    <Setter Property="Foreground" Value="{StaticResource BText}"/>
  </Style>

  <Style x:Key="Dim" TargetType="TextBlock">
    <Setter Property="FontFamily" Value="{StaticResource FBody}"/>
    <Setter Property="FontSize" Value="12"/>
    <Setter Property="Foreground" Value="{StaticResource BTextDim}"/>
  </Style>

  <Style x:Key="SectionLabel" TargetType="TextBlock" BasedOn="{StaticResource Eyebrow}">
    <Setter Property="Margin" Value="0,0,0,10"/>
  </Style>

  <!-- Distintivo de severidad: fondo tenue del mismo tono que el texto. -->
  <Style x:Key="Chip" TargetType="Border">
    <Setter Property="CornerRadius" Value="{StaticResource RSm}"/>
    <Setter Property="Padding" Value="8,3"/>
    <Setter Property="HorizontalAlignment" Value="Left"/>
    <Setter Property="VerticalAlignment" Value="Center"/>
  </Style>

  <!-- Distintivo mínimo: dice de dónde viene un dato sin competir con él. -->
  <Style x:Key="MiniChip" TargetType="Border">
    <Setter Property="Background" Value="{StaticResource BSurfaceAlt}"/>
    <Setter Property="CornerRadius" Value="{StaticResource RSm}"/>
    <Setter Property="Padding" Value="7,2"/>
    <Setter Property="VerticalAlignment" Value="Center"/>
    <Setter Property="HorizontalAlignment" Value="Left"/>
  </Style>

  <Style x:Key="MiniChipText" TargetType="TextBlock">
    <Setter Property="FontFamily" Value="{StaticResource FBody}"/>
    <Setter Property="FontSize" Value="9.5"/>
    <Setter Property="FontWeight" Value="SemiBold"/>
    <Setter Property="Foreground" Value="{StaticResource BTextMuted}"/>
  </Style>

  <!-- ============================ SUPERFICIES ======================== -->
  <Style x:Key="Card" TargetType="Border">
    <Setter Property="Background" Value="{StaticResource BSurface}"/>
    <Setter Property="BorderBrush" Value="{StaticResource BStrokeSoft}"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="CornerRadius" Value="{StaticResource RMd}"/>
    <Setter Property="Padding" Value="{StaticResource CardPad}"/>
    <Setter Property="Effect" Value="{StaticResource CardShadow}"/>
  </Style>

  <!-- Variante sin relleno: para bloques que cierran una lectura y no
       deben competir con las tarjetas de datos que tienen encima. -->
  <Style x:Key="CardOutline" TargetType="Border">
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="BorderBrush" Value="{StaticResource BStrokeSoft}"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="CornerRadius" Value="{StaticResource RMd}"/>
    <Setter Property="Padding" Value="{StaticResource CardPad}"/>
  </Style>

  <!-- Tarjeta de titular: la única con degradado. reservada al puntaje,
       que es lo primero que se mira al abrir la aplicación. -->
  <Style x:Key="HeroCard" TargetType="Border" BasedOn="{StaticResource Card}">
    <Setter Property="Background" Value="{StaticResource GHero}"/>
    <Setter Property="BorderBrush" Value="{StaticResource BStroke}"/>
    <Setter Property="CornerRadius" Value="{StaticResource RLg}"/>
    <Setter Property="Padding" Value="26,24,26,26"/>
  </Style>

  <Style x:Key="MetricCard" TargetType="Border" BasedOn="{StaticResource Card}">
    <Style.Triggers>
      <Trigger Property="IsMouseOver" Value="True">
        <Setter Property="BorderBrush" Value="{StaticResource BStroke}"/>
        <Setter Property="Background" Value="{StaticResource BSurfaceAlt}"/>
      </Trigger>
    </Style.Triggers>
  </Style>

  <!-- Armazón común de los paneles flotantes (diálogos y ventanas de
       opciones). Centralizarlo aquí es lo que hace que todas las ventanas
       secundarias se vean como la misma aplicación. -->
  <Style x:Key="PanelShell" TargetType="Border">
    <Setter Property="Background" Value="{StaticResource BSurface}"/>
    <Setter Property="BorderBrush" Value="{StaticResource BStroke}"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="CornerRadius" Value="{StaticResource RLg}"/>
    <Setter Property="Padding" Value="26,22,26,20"/>
    <Setter Property="Effect" Value="{StaticResource PanelShadow}"/>
  </Style>

  <!-- Estado de la corrida, en la barra superior. -->
  <Style x:Key="EstadoPill" TargetType="Border">
    <Setter Property="Background" Value="{StaticResource BSurfaceAlt}"/>
    <Setter Property="BorderBrush" Value="{StaticResource BStrokeSoft}"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="CornerRadius" Value="{StaticResource RPill}"/>
    <Setter Property="Padding" Value="11,5"/>
    <Setter Property="VerticalAlignment" Value="Center"/>
  </Style>

  <!-- Punto que late solo mientras hay una operación en curso.

       El latido anterior era lineal (rampa de 1 a 0,25), que es lo que lo hacía
       ver mecánico; ahora respira con una curva. Sigue atado a Loaded y no a un
       DataTrigger de Ocupado: para detener el reloj al terminar la corrida
       haría falta StopStoryboard sobre un BeginStoryboard con nombre, y eso
       dentro de un Style —no dentro de una plantilla— depende de un ámbito de
       nombres distinto. No vale la pena arriesgar el arranque de la app por
       apagar un reloj que además está invisible en reposo. Pendiente: mover
       el punto a una plantilla propia y gobernar el latido por estado. -->
  <Style x:Key="PuntoVivo" TargetType="Ellipse">
    <Setter Property="Width" Value="7"/>
    <Setter Property="Height" Value="7"/>
    <Setter Property="Fill" Value="{StaticResource BAccent2}"/>
    <Setter Property="Margin" Value="0,0,7,0"/>
    <Style.Triggers>
      <EventTrigger RoutedEvent="Loaded">
        <BeginStoryboard>
          <Storyboard RepeatBehavior="Forever" AutoReverse="True">
            <DoubleAnimation Storyboard.TargetProperty="Opacity" From="1" To="0.25"
                             Duration="0:0:0.62" EasingFunction="{StaticResource EEaseSuave}"/>
          </Storyboard>
        </BeginStoryboard>
      </EventTrigger>
    </Style.Triggers>
  </Style>

  <!-- ================================================================
       Desplazamiento. La barra nativa es clara y con flechas; retemplada
       queda fina, redondeada y muda, para no competir con el contenido.
       ================================================================ -->
  <Style x:Key="ScrollThumb" TargetType="Thumb">
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Thumb">
          <Border Background="{StaticResource BStroke}" CornerRadius="3" Margin="3,0"/>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style TargetType="ScrollBar">
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="Width" Value="10"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ScrollBar">
          <Grid Background="Transparent">
            <!-- La barra queda apenas visible y sube a opacidad plena cuando el
                 puntero entra en su carril de 10 px. Sigue ahí para el ratón
                 (el carril no se oculta, solo se atenúa), pero deja de
                 interrumpir la lectura de una tabla larga. -->
            <Track x:Name="PART_Track" IsDirectionReversed="True" Opacity="0.35">
              <Track.DecreaseRepeatButton>
                <RepeatButton Command="ScrollBar.PageUpCommand" Opacity="0" Focusable="False"/>
              </Track.DecreaseRepeatButton>
              <Track.Thumb>
                <Thumb Style="{StaticResource ScrollThumb}"/>
              </Track.Thumb>
              <Track.IncreaseRepeatButton>
                <RepeatButton Command="ScrollBar.PageDownCommand" Opacity="0" Focusable="False"/>
              </Track.IncreaseRepeatButton>
            </Track>
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="Orientation" Value="Horizontal">
              <Setter Property="Height" Value="10"/>
              <Setter Property="Width" Value="Auto"/>
              <Setter TargetName="PART_Track" Property="IsDirectionReversed" Value="False"/>
            </Trigger>
            <Trigger Property="IsMouseOver" Value="True">
              <Trigger.EnterActions>
                <BeginStoryboard>
                  <Storyboard>
                    <DoubleAnimation Storyboard.TargetName="PART_Track" Storyboard.TargetProperty="Opacity"
                                     To="1" Duration="0:0:0.11"/>
                  </Storyboard>
                </BeginStoryboard>
              </Trigger.EnterActions>
              <Trigger.ExitActions>
                <BeginStoryboard>
                  <Storyboard>
                    <DoubleAnimation Storyboard.TargetName="PART_Track" Storyboard.TargetProperty="Opacity"
                                     To="0.35" Duration="0:0:0.26"/>
                  </Storyboard>
                </BeginStoryboard>
              </Trigger.ExitActions>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- ================================================================
       Botones. El hover es una capa blanca translúcida sobre el fondo,
       no un cambio de opacidad: así el texto sigue siendo legible sobre
       el violeta y sobre el fantasma por igual.

       La capa superpuesta no es un capricho: es la única forma correcta de
       interpolar un color acá. Los pinceles del tema son compartidos, y
       animar el Color de BHover cambiaría de una vez todos los sitios donde
       se usa. Lo que se anima entonces es la Opacity de una capa propia del
       control, que no comparte nada con nadie.

       Cada botón tiene cuatro capas, y cada una va a su tiempo:
         · Luz      — realimentación del puntero (0,16 s adentro, 0,22 s
                      fuera: entrar tiene que responder, salir tiene que
                      despejar sin dejar resabio).
         · Prensa   — oscurece al apretar, para que el clic se sienta aunque
                      la acción tarde; un diagnóstico tarda segundos.
         · Contorno — el filete violeta del hover entra con la capa, no a seco.
         · Enfoque  — anillo cian por teclado, por fuera del borde para que no
                      se pelee con el color del estado. Es accesibilidad, no
                      adorno: antes el foco solo recoloría el borde.
       ================================================================ -->
  <Style x:Key="BtnBase" TargetType="Button">
    <Setter Property="FontFamily" Value="{StaticResource FBody}"/>
    <Setter Property="FontSize" Value="13"/>
    <Setter Property="Foreground" Value="{StaticResource BText}"/>
    <Setter Property="Padding" Value="16,9"/>
    <Setter Property="Cursor" Value="Hand"/>
    <Setter Property="SnapsToDevicePixels" Value="True"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Border x:Name="Bd" Background="{TemplateBinding Background}"
                  BorderBrush="{TemplateBinding BorderBrush}"
                  BorderThickness="1" CornerRadius="{StaticResource RSm}">
            <Grid>
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                Margin="{TemplateBinding Padding}"/>
              <Border x:Name="Luz" Background="{StaticResource BHover}"
                      CornerRadius="{StaticResource RSm}" Opacity="0" IsHitTestVisible="False"/>
              <Border x:Name="Prensa" Background="#3A000000"
                      CornerRadius="{StaticResource RSm}" Opacity="0" IsHitTestVisible="False"/>
              <Border x:Name="Contorno" BorderBrush="{StaticResource BAccent}" BorderThickness="1"
                      CornerRadius="{StaticResource RSm}" Opacity="0" IsHitTestVisible="False"/>
              <Border x:Name="Enfoque" BorderBrush="{StaticResource BAccent2}" BorderThickness="1.5"
                      CornerRadius="7" Margin="-2" Opacity="0" IsHitTestVisible="False"/>
            </Grid>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Trigger.EnterActions>
                <BeginStoryboard>
                  <Storyboard>
                    <DoubleAnimation Storyboard.TargetName="Luz" Storyboard.TargetProperty="Opacity"
                                     To="1" Duration="0:0:0.16"/>
                    <DoubleAnimation Storyboard.TargetName="Contorno" Storyboard.TargetProperty="Opacity"
                                     To="1" Duration="0:0:0.16"/>
                  </Storyboard>
                </BeginStoryboard>
              </Trigger.EnterActions>
              <Trigger.ExitActions>
                <BeginStoryboard>
                  <Storyboard>
                    <DoubleAnimation Storyboard.TargetName="Luz" Storyboard.TargetProperty="Opacity"
                                     To="0" Duration="0:0:0.22"/>
                    <DoubleAnimation Storyboard.TargetName="Contorno" Storyboard.TargetProperty="Opacity"
                                     To="0" Duration="0:0:0.22"/>
                  </Storyboard>
                </BeginStoryboard>
              </Trigger.ExitActions>
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
              <Trigger.EnterActions>
                <BeginStoryboard>
                  <Storyboard>
                    <DoubleAnimation Storyboard.TargetName="Prensa" Storyboard.TargetProperty="Opacity"
                                     To="1" Duration="0:0:0.06"/>
                  </Storyboard>
                </BeginStoryboard>
              </Trigger.EnterActions>
              <Trigger.ExitActions>
                <BeginStoryboard>
                  <Storyboard>
                    <DoubleAnimation Storyboard.TargetName="Prensa" Storyboard.TargetProperty="Opacity"
                                     To="0" Duration="0:0:0.2"/>
                  </Storyboard>
                </BeginStoryboard>
              </Trigger.ExitActions>
            </Trigger>
            <Trigger Property="IsKeyboardFocused" Value="True">
              <Trigger.EnterActions>
                <BeginStoryboard>
                  <Storyboard>
                    <DoubleAnimation Storyboard.TargetName="Enfoque" Storyboard.TargetProperty="Opacity"
                                     To="1" Duration="0:0:0.16"/>
                  </Storyboard>
                </BeginStoryboard>
              </Trigger.EnterActions>
              <Trigger.ExitActions>
                <BeginStoryboard>
                  <Storyboard>
                    <DoubleAnimation Storyboard.TargetName="Enfoque" Storyboard.TargetProperty="Opacity"
                                     To="0" Duration="0:0:0.16"/>
                  </Storyboard>
                </BeginStoryboard>
              </Trigger.ExitActions>
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter Property="Cursor" Value="Arrow"/>
              <Trigger.EnterActions>
                <BeginStoryboard>
                  <Storyboard>
                    <DoubleAnimation Storyboard.TargetName="Bd" Storyboard.TargetProperty="Opacity"
                                     To="0.35" Duration="0:0:0.19"/>
                  </Storyboard>
                </BeginStoryboard>
              </Trigger.EnterActions>
              <Trigger.ExitActions>
                <BeginStoryboard>
                  <Storyboard>
                    <DoubleAnimation Storyboard.TargetName="Bd" Storyboard.TargetProperty="Opacity"
                                     To="1" Duration="0:0:0.19"/>
                  </Storyboard>
                </BeginStoryboard>
              </Trigger.ExitActions>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style x:Key="BtnPrimary" TargetType="Button" BasedOn="{StaticResource BtnBase}">
    <Setter Property="Background" Value="{StaticResource GAccent}"/>
    <Setter Property="BorderBrush" Value="{StaticResource BAccentDeep}"/>
    <Setter Property="Foreground" Value="{StaticResource BInk}"/>
    <Setter Property="FontWeight" Value="SemiBold"/>
  </Style>

  <Style x:Key="BtnGhost" TargetType="Button" BasedOn="{StaticResource BtnBase}">
    <Setter Property="Background" Value="{StaticResource BSurfaceAlt}"/>
    <Setter Property="BorderBrush" Value="{StaticResource BStroke}"/>
  </Style>

  <!-- Sin caja: para acciones secundarias del pie, donde cuatro botones
       enmarcados seguidos pesan más que la acción principal. El hover
       tampoco dibuja borde: con cinco botones en fila, el borde que
       aparece y desaparece distrae más de lo que orienta. -->
  <Style x:Key="BtnQuiet" TargetType="Button" BasedOn="{StaticResource BtnBase}">
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="BorderBrush" Value="Transparent"/>
    <Setter Property="Foreground" Value="{StaticResource BTextDim}"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Border x:Name="Bd" Background="{TemplateBinding Background}"
                  BorderBrush="{TemplateBinding BorderBrush}"
                  BorderThickness="1" CornerRadius="{StaticResource RSm}">
            <Grid>
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                Margin="{TemplateBinding Padding}"/>
              <Border x:Name="Luz" Background="{StaticResource BHover}"
                      CornerRadius="{StaticResource RSm}" Opacity="0" IsHitTestVisible="False"/>
              <Border x:Name="Prensa" Background="#3A000000"
                      CornerRadius="{StaticResource RSm}" Opacity="0" IsHitTestVisible="False"/>
              <Border x:Name="Enfoque" BorderBrush="{StaticResource BAccent2}" BorderThickness="1.5"
                      CornerRadius="7" Margin="-2" Opacity="0" IsHitTestVisible="False"/>
            </Grid>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <!-- El texto cambia de tono en el acto y la capa entra suave: el
                   color del rótulo es un pincel compartido del tema. -->
              <Setter Property="Foreground" Value="{StaticResource BText}"/>
              <Trigger.EnterActions>
                <BeginStoryboard>
                  <Storyboard>
                    <DoubleAnimation Storyboard.TargetName="Luz" Storyboard.TargetProperty="Opacity"
                                     To="1" Duration="0:0:0.16"/>
                  </Storyboard>
                </BeginStoryboard>
              </Trigger.EnterActions>
              <Trigger.ExitActions>
                <BeginStoryboard>
                  <Storyboard>
                    <DoubleAnimation Storyboard.TargetName="Luz" Storyboard.TargetProperty="Opacity"
                                     To="0" Duration="0:0:0.22"/>
                  </Storyboard>
                </BeginStoryboard>
              </Trigger.ExitActions>
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
              <Trigger.EnterActions>
                <BeginStoryboard>
                  <Storyboard>
                    <DoubleAnimation Storyboard.TargetName="Prensa" Storyboard.TargetProperty="Opacity"
                                     To="1" Duration="0:0:0.06"/>
                  </Storyboard>
                </BeginStoryboard>
              </Trigger.EnterActions>
              <Trigger.ExitActions>
                <BeginStoryboard>
                  <Storyboard>
                    <DoubleAnimation Storyboard.TargetName="Prensa" Storyboard.TargetProperty="Opacity"
                                     To="0" Duration="0:0:0.2"/>
                  </Storyboard>
                </BeginStoryboard>
              </Trigger.ExitActions>
            </Trigger>
            <Trigger Property="IsKeyboardFocused" Value="True">
              <Trigger.EnterActions>
                <BeginStoryboard>
                  <Storyboard>
                    <DoubleAnimation Storyboard.TargetName="Enfoque" Storyboard.TargetProperty="Opacity"
                                     To="1" Duration="0:0:0.16"/>
                  </Storyboard>
                </BeginStoryboard>
              </Trigger.EnterActions>
              <Trigger.ExitActions>
                <BeginStoryboard>
                  <Storyboard>
                    <DoubleAnimation Storyboard.TargetName="Enfoque" Storyboard.TargetProperty="Opacity"
                                     To="0" Duration="0:0:0.16"/>
                  </Storyboard>
                </BeginStoryboard>
              </Trigger.ExitActions>
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter Property="Cursor" Value="Arrow"/>
              <Trigger.EnterActions>
                <BeginStoryboard>
                  <Storyboard>
                    <DoubleAnimation Storyboard.TargetName="Bd" Storyboard.TargetProperty="Opacity"
                                     To="0.35" Duration="0:0:0.19"/>
                  </Storyboard>
                </BeginStoryboard>
              </Trigger.EnterActions>
              <Trigger.ExitActions>
                <BeginStoryboard>
                  <Storyboard>
                    <DoubleAnimation Storyboard.TargetName="Bd" Storyboard.TargetProperty="Opacity"
                                     To="1" Duration="0:0:0.19"/>
                  </Storyboard>
                </BeginStoryboard>
              </Trigger.ExitActions>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style x:Key="BtnCaption" TargetType="Button">
    <Setter Property="Width" Value="46"/>
    <Setter Property="Height" Value="34"/>
    <Setter Property="Foreground" Value="{StaticResource BTextMuted}"/>
    <Setter Property="FontFamily" Value="Segoe Fluent Icons, Segoe MDL2 Assets"/>
    <Setter Property="FontSize" Value="10"/>
    <Setter Property="Cursor" Value="Arrow"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Border x:Name="Bd" Background="Transparent">
            <Grid>
              <Border x:Name="Velo" Background="{StaticResource BHover}" Opacity="0"/>
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Grid>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter Property="Foreground" Value="{StaticResource BText}"/>
              <Trigger.EnterActions>
                <BeginStoryboard>
                  <Storyboard>
                    <DoubleAnimation Storyboard.TargetName="Velo" Storyboard.TargetProperty="Opacity"
                                     To="1" Duration="0:0:0.11"/>
                  </Storyboard>
                </BeginStoryboard>
              </Trigger.EnterActions>
              <Trigger.ExitActions>
                <BeginStoryboard>
                  <Storyboard>
                    <DoubleAnimation Storyboard.TargetName="Velo" Storyboard.TargetProperty="Opacity"
                                     To="0" Duration="0:0:0.16"/>
                  </Storyboard>
                </BeginStoryboard>
              </Trigger.ExitActions>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style x:Key="BtnCaptionClose" TargetType="Button" BasedOn="{StaticResource BtnCaption}">
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Border x:Name="Bd" Background="Transparent">
            <Grid>
              <!-- Cerrar es lo único de la barra que destruye algo: el rojo
                   entra desvaneciéndose para que el aviso no sea un parpadeo. -->
              <Border x:Name="Velo" Background="{StaticResource BBad}" Opacity="0"/>
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Grid>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter Property="Foreground" Value="White"/>
              <Trigger.EnterActions>
                <BeginStoryboard>
                  <Storyboard>
                    <DoubleAnimation Storyboard.TargetName="Velo" Storyboard.TargetProperty="Opacity"
                                     To="1" Duration="0:0:0.11"/>
                  </Storyboard>
                </BeginStoryboard>
              </Trigger.EnterActions>
              <Trigger.ExitActions>
                <BeginStoryboard>
                  <Storyboard>
                    <DoubleAnimation Storyboard.TargetName="Velo" Storyboard.TargetProperty="Opacity"
                                     To="0" Duration="0:0:0.16"/>
                  </Storyboard>
                </BeginStoryboard>
              </Trigger.ExitActions>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- ================================================================
       Conmutador de vistas. Pastillas dentro de una bandeja: el activo
       se rellena de violeta, así se distingue del resto a un golpe de
       vista sin depender solo del texto.
       ================================================================ -->
  <Style x:Key="SegmentBar" TargetType="Border">
    <Setter Property="Background" Value="{StaticResource BSurface}"/>
    <Setter Property="BorderBrush" Value="{StaticResource BStrokeSoft}"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="CornerRadius" Value="9"/>
    <Setter Property="Padding" Value="4"/>
    <Setter Property="VerticalAlignment" Value="Center"/>
    <Setter Property="SnapsToDevicePixels" Value="True"/>
  </Style>

  <Style x:Key="Segment" TargetType="RadioButton">
    <Setter Property="FontFamily" Value="{StaticResource FBody}"/>
    <Setter Property="FontSize" Value="12.5"/>
    <Setter Property="Foreground" Value="{StaticResource BTextDim}"/>
    <Setter Property="Cursor" Value="Hand"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="RadioButton">
          <Border x:Name="Bd" Background="Transparent" CornerRadius="6" Padding="14,6">
            <Grid>
              <Border x:Name="Luz" Background="{StaticResource BHover}" Opacity="0" IsHitTestVisible="False"/>
              <!-- El relleno de la pastilla activa entra y sale desvaneciéndose.
                   Es la única manera de animarlo sin tocar GAccent, que es un
                   degradado del tema compartido con todos los botones primarios. -->
              <Border x:Name="Sel" Background="{StaticResource GAccent}" CornerRadius="6"
                      Opacity="0" IsHitTestVisible="False"/>
              <!-- La etiqueta se cruza: la versión tenue y la versión tinta son
                   dos presentadores del mismo contenido que se pasan el testigo
                   mientras el relleno sube. Un solo presentador conmutando el
                   color daría un parpadeo de tinta oscura sobre fondo oscuro. -->
              <ContentPresenter x:Name="Normal" VerticalAlignment="Center" HorizontalAlignment="Center"
                                TextBlock.Foreground="{StaticResource BTextDim}"/>
              <ContentPresenter x:Name="Tinta" VerticalAlignment="Center" HorizontalAlignment="Center"
                                TextBlock.Foreground="{StaticResource BInk}" TextBlock.FontWeight="SemiBold"
                                Opacity="0" IsHitTestVisible="False"/>
            </Grid>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Trigger.EnterActions>
                <BeginStoryboard>
                  <Storyboard>
                    <DoubleAnimation Storyboard.TargetName="Luz" Storyboard.TargetProperty="Opacity"
                                     To="1" Duration="0:0:0.11"/>
                  </Storyboard>
                </BeginStoryboard>
              </Trigger.EnterActions>
              <Trigger.ExitActions>
                <BeginStoryboard>
                  <Storyboard>
                    <DoubleAnimation Storyboard.TargetName="Luz" Storyboard.TargetProperty="Opacity"
                                     To="0" Duration="0:0:0.16"/>
                  </Storyboard>
                </BeginStoryboard>
              </Trigger.ExitActions>
            </Trigger>
            <Trigger Property="IsChecked" Value="True">
              <Trigger.EnterActions>
                <BeginStoryboard>
                  <Storyboard>
                    <DoubleAnimation Storyboard.TargetName="Sel" Storyboard.TargetProperty="Opacity"
                                     To="1" Duration="0:0:0.19" EasingFunction="{StaticResource EEaseSalida}"/>
                    <DoubleAnimation Storyboard.TargetName="Tinta" Storyboard.TargetProperty="Opacity"
                                     To="1" Duration="0:0:0.19"/>
                    <DoubleAnimation Storyboard.TargetName="Normal" Storyboard.TargetProperty="Opacity"
                                     To="0" Duration="0:0:0.11"/>
                  </Storyboard>
                </BeginStoryboard>
              </Trigger.EnterActions>
              <Trigger.ExitActions>
                <BeginStoryboard>
                  <Storyboard>
                    <DoubleAnimation Storyboard.TargetName="Sel" Storyboard.TargetProperty="Opacity"
                                     To="0" Duration="0:0:0.19"/>
                    <DoubleAnimation Storyboard.TargetName="Tinta" Storyboard.TargetProperty="Opacity"
                                     To="0" Duration="0:0:0.16"/>
                    <DoubleAnimation Storyboard.TargetName="Normal" Storyboard.TargetProperty="Opacity"
                                     To="1" Duration="0:0:0.16"/>
                  </Storyboard>
                </BeginStoryboard>
              </Trigger.ExitActions>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- ================================================================
       Rail de navegación. Es un ListBox y no botones sueltos: así el
       módulo activo queda marcado solo, sin estado que sincronizar.
       ================================================================ -->
  <Style x:Key="NavItem" TargetType="ListBoxItem">
    <Setter Property="Padding" Value="0"/>
    <Setter Property="Cursor" Value="Hand"/>
    <Setter Property="Foreground" Value="{StaticResource BTextDim}"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ListBoxItem">
          <Grid x:Name="Root">
            <Border x:Name="Bd" Background="Transparent" CornerRadius="0"/>
            <Border x:Name="Velo" Background="{StaticResource BHover}" Opacity="0" IsHitTestVisible="False"/>
            <Border x:Name="Lavado" Background="{StaticResource BAccentWash}" Opacity="0" IsHitTestVisible="False"/>
            <!-- El filete del módulo activo crece desde el centro en vez de
                 aparecer: es la única señal de «estás acá», y un trazo que se
                 estira se lee como algo que se acomoda, no como un parpadeo.
                 El contenido empuja 2 px al pasar y 4 al quedar seleccionado,
                 que es lo que hace que la selección se sienta tocada. -->
            <Rectangle x:Name="Mark" Width="3" RadiusX="2" RadiusY="2" Margin="0,7"
                       HorizontalAlignment="Left" Fill="{StaticResource BAccent}"
                       Opacity="0" RenderTransformOrigin="0.5,0.5">
              <Rectangle.RenderTransform>
                <ScaleTransform x:Name="MarkEscala" ScaleY="0.2"/>
              </Rectangle.RenderTransform>
            </Rectangle>
            <ContentPresenter x:Name="Cuerpo" Margin="15,9" VerticalAlignment="Center"
                              RenderTransformOrigin="0,0.5">
              <ContentPresenter.RenderTransform>
                <TranslateTransform x:Name="Empuje" X="0"/>
              </ContentPresenter.RenderTransform>
            </ContentPresenter>
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter Property="Foreground" Value="{StaticResource BText}"/>
              <Trigger.EnterActions>
                <BeginStoryboard>
                  <Storyboard>
                    <DoubleAnimation Storyboard.TargetName="Velo" Storyboard.TargetProperty="Opacity"
                                     To="1" Duration="0:0:0.11"/>
                    <DoubleAnimation Storyboard.TargetName="Empuje" Storyboard.TargetProperty="X"
                                     To="2" Duration="0:0:0.16" EasingFunction="{StaticResource EEaseSalida}"/>
                  </Storyboard>
                </BeginStoryboard>
              </Trigger.EnterActions>
              <Trigger.ExitActions>
                <BeginStoryboard>
                  <Storyboard>
                    <DoubleAnimation Storyboard.TargetName="Velo" Storyboard.TargetProperty="Opacity"
                                     To="0" Duration="0:0:0.16"/>
                    <DoubleAnimation Storyboard.TargetName="Empuje" Storyboard.TargetProperty="X"
                                     To="0" Duration="0:0:0.16" EasingFunction="{StaticResource EEaseSalida}"/>
                  </Storyboard>
                </BeginStoryboard>
              </Trigger.ExitActions>
            </Trigger>
            <Trigger Property="IsSelected" Value="True">
              <Trigger.EnterActions>
                <BeginStoryboard>
                  <Storyboard>
                    <DoubleAnimation Storyboard.TargetName="Lavado" Storyboard.TargetProperty="Opacity"
                                     To="1" Duration="0:0:0.19" EasingFunction="{StaticResource EEaseSalida}"/>
                    <DoubleAnimation Storyboard.TargetName="Mark" Storyboard.TargetProperty="Opacity"
                                     To="1" Duration="0:0:0.11"/>
                    <DoubleAnimation Storyboard.TargetName="MarkEscala" Storyboard.TargetProperty="ScaleY"
                                     To="1" Duration="0:0:0.24" EasingFunction="{StaticResource EEaseSalto}"/>
                    <DoubleAnimation Storyboard.TargetName="Empuje" Storyboard.TargetProperty="X"
                                     To="4" Duration="0:0:0.19" EasingFunction="{StaticResource EEaseSalida}"/>
                  </Storyboard>
                </BeginStoryboard>
              </Trigger.EnterActions>
              <Trigger.ExitActions>
                <BeginStoryboard>
                  <Storyboard>
                    <DoubleAnimation Storyboard.TargetName="Lavado" Storyboard.TargetProperty="Opacity"
                                     To="0" Duration="0:0:0.22"/>
                    <DoubleAnimation Storyboard.TargetName="Mark" Storyboard.TargetProperty="Opacity"
                                     To="0" Duration="0:0:0.16"/>
                    <DoubleAnimation Storyboard.TargetName="MarkEscala" Storyboard.TargetProperty="ScaleY"
                                     To="0.2" Duration="0:0:0.16"/>
                    <DoubleAnimation Storyboard.TargetName="Empuje" Storyboard.TargetProperty="X"
                                     To="0" Duration="0:0:0.22"/>
                  </Storyboard>
                </BeginStoryboard>
              </Trigger.ExitActions>
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Trigger.EnterActions>
                <BeginStoryboard>
                  <Storyboard>
                    <DoubleAnimation Storyboard.TargetName="Root" Storyboard.TargetProperty="Opacity"
                                     To="0.45" Duration="0:0:0.19"/>
                  </Storyboard>
                </BeginStoryboard>
              </Trigger.EnterActions>
              <Trigger.ExitActions>
                <BeginStoryboard>
                  <Storyboard>
                    <DoubleAnimation Storyboard.TargetName="Root" Storyboard.TargetProperty="Opacity"
                                     To="1" Duration="0:0:0.19"/>
                  </Storyboard>
                </BeginStoryboard>
              </Trigger.ExitActions>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- Encabezado de grupo: no es un destino, es una etiqueta. Va dentro
       de la lista para que el desplazamiento la arrastre con su grupo. -->
  <Style x:Key="NavGroupItem" TargetType="ListBoxItem">
    <Setter Property="IsEnabled" Value="False"/>
    <Setter Property="Focusable" Value="False"/>
    <Setter Property="IsHitTestVisible" Value="False"/>
    <Setter Property="Padding" Value="0"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ListBoxItem">
          <ContentPresenter Margin="14,14,12,6"/>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style x:Key="NavGroup" TargetType="TextBlock" BasedOn="{StaticResource Eyebrow}">
    <Setter Property="FontSize" Value="9.5"/>
    <Setter Property="Foreground" Value="{StaticResource BTextMuted}"/>
  </Style>

  <!-- Sin color propio: hereda el del ítem, de modo que la navegación
       entera cambia de tono con un solo desencadenante. -->
  <Style x:Key="NavIcon" TargetType="TextBlock">
    <Setter Property="FontFamily" Value="Segoe Fluent Icons, Segoe MDL2 Assets"/>
    <Setter Property="FontSize" Value="15"/>
    <Setter Property="Width" Value="24"/>
    <Setter Property="VerticalAlignment" Value="Center"/>
    <Setter Property="TextAlignment" Value="Center"/>
  </Style>

  <Style x:Key="NavLabel" TargetType="TextBlock">
    <Setter Property="FontFamily" Value="{StaticResource FBody}"/>
    <Setter Property="FontSize" Value="12.5"/>
    <Setter Property="VerticalAlignment" Value="Center"/>
    <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
  </Style>

  <!-- Llamada principal del rail: diagnóstico completo. -->
  <Style x:Key="CtaIcon" TargetType="TextBlock">
    <Setter Property="FontFamily" Value="Segoe Fluent Icons, Segoe MDL2 Assets"/>
    <Setter Property="FontSize" Value="14"/>
    <Setter Property="Margin" Value="0,0,9,0"/>
    <Setter Property="VerticalAlignment" Value="Center"/>
  </Style>

  <Style x:Key="CtaLabel" TargetType="TextBlock">
    <Setter Property="FontFamily" Value="{StaticResource FBody}"/>
    <Setter Property="FontSize" Value="12.5"/>
    <Setter Property="FontWeight" Value="SemiBold"/>
    <Setter Property="VerticalAlignment" Value="Center"/>
  </Style>

  <!-- La plantilla nativa del ListBox pinta el fondo del sistema (blanco)
       cuando el control está deshabilitado, que es justo lo que pasa
       mientras corre un módulo. Se reemplaza entera para que no quede
       ningún camino por el que se cuele un color ajeno a la paleta. -->
  <Style x:Key="PlainList" TargetType="ListBox">
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="BorderThickness" Value="0"/>
    <Setter Property="Foreground" Value="{StaticResource BText}"/>
    <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ListBox">
          <Border Background="Transparent" BorderThickness="0">
            <ScrollViewer Focusable="False" Padding="0" Background="Transparent">
              <ItemsPresenter SnapsToDevicePixels="True"/>
            </ScrollViewer>
          </Border>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- Fila de hallazgo: franja de severidad + área + qué pasó. -->
  <Style x:Key="FindingItem" TargetType="ListBoxItem">
    <Setter Property="Padding" Value="0"/>
    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ListBoxItem">
          <Border x:Name="Bd" Background="Transparent" BorderBrush="{StaticResource BStrokeSoft}"
                  BorderThickness="0,0,0,1">
            <Grid>
              <Border x:Name="Velo" Background="{StaticResource BHover}" Opacity="0" IsHitTestVisible="False"/>
              <Border x:Name="Sel" Background="{StaticResource BSurfaceAlt}" Opacity="0" IsHitTestVisible="False"/>
              <!-- La marca de severidad se estira en vez de aparecer: al recorrer
                   la lista con las flechas, la selección se sigue sola. -->
              <Rectangle x:Name="Marca" Width="3" HorizontalAlignment="Left" Opacity="0"
                         RenderTransformOrigin="0.5,0.5" Fill="{StaticResource BAccent}">
                <Rectangle.RenderTransform>
                  <ScaleTransform x:Name="MarcaEscala" ScaleY="0.15"/>
                </Rectangle.RenderTransform>
              </Rectangle>
              <ContentPresenter Margin="0"/>
            </Grid>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Trigger.EnterActions>
                <BeginStoryboard>
                  <Storyboard>
                    <DoubleAnimation Storyboard.TargetName="Velo" Storyboard.TargetProperty="Opacity"
                                     To="1" Duration="0:0:0.11"/>
                  </Storyboard>
                </BeginStoryboard>
              </Trigger.EnterActions>
              <Trigger.ExitActions>
                <BeginStoryboard>
                  <Storyboard>
                    <DoubleAnimation Storyboard.TargetName="Velo" Storyboard.TargetProperty="Opacity"
                                     To="0" Duration="0:0:0.16"/>
                  </Storyboard>
                </BeginStoryboard>
              </Trigger.ExitActions>
            </Trigger>
            <Trigger Property="IsSelected" Value="True">
              <Trigger.EnterActions>
                <BeginStoryboard>
                  <Storyboard>
                    <DoubleAnimation Storyboard.TargetName="Sel" Storyboard.TargetProperty="Opacity"
                                     To="1" Duration="0:0:0.19" EasingFunction="{StaticResource EEaseSalida}"/>
                    <DoubleAnimation Storyboard.TargetName="Marca" Storyboard.TargetProperty="Opacity"
                                     To="1" Duration="0:0:0.11"/>
                    <DoubleAnimation Storyboard.TargetName="MarcaEscala" Storyboard.TargetProperty="ScaleY"
                                     To="1" Duration="0:0:0.24" EasingFunction="{StaticResource EEaseSalto}"/>
                  </Storyboard>
                </BeginStoryboard>
              </Trigger.EnterActions>
              <Trigger.ExitActions>
                <BeginStoryboard>
                  <Storyboard>
                    <DoubleAnimation Storyboard.TargetName="Sel" Storyboard.TargetProperty="Opacity"
                                     To="0" Duration="0:0:0.19"/>
                    <DoubleAnimation Storyboard.TargetName="Marca" Storyboard.TargetProperty="Opacity"
                                     To="0" Duration="0:0:0.16"/>
                    <DoubleAnimation Storyboard.TargetName="MarcaEscala" Storyboard.TargetProperty="ScaleY"
                                     To="0.15" Duration="0:0:0.16"/>
                  </Storyboard>
                </BeginStoryboard>
              </Trigger.ExitActions>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- ================================================================
       ComboBox retemplado por completo: el nativo despliega en blanco.
       ================================================================ -->
  <ControlTemplate x:Key="ComboToggle" TargetType="ToggleButton">
    <Border x:Name="Bd" Background="{StaticResource BSurfaceAlt}" BorderBrush="{StaticResource BStroke}"
            BorderThickness="1" CornerRadius="{StaticResource RSm}">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="30"/>
        </Grid.ColumnDefinitions>
        <Border x:Name="Velo" Grid.ColumnSpan="2" Background="{StaticResource BHover}"
                CornerRadius="{StaticResource RSm}" Opacity="0" IsHitTestVisible="False"/>
        <ContentPresenter Grid.Column="0" Margin="13,0,0,0" VerticalAlignment="Center"
                          Content="{Binding SelectedItem, RelativeSource={RelativeSource AncestorType=ComboBox}}"/>
        <!-- La flecha gira con la lista: dice que el mismo gesto que abre
             cierra, y evita el parpadeo de un triángulo que se invierte a seco. -->
        <Path Grid.Column="1" HorizontalAlignment="Center" VerticalAlignment="Center"
              Data="M0,0 L8,0 L4,5 Z" Fill="{StaticResource BTextDim}" RenderTransformOrigin="0.5,0.5">
          <Path.RenderTransform>
            <RotateTransform x:Name="Giro" Angle="0"/>
          </Path.RenderTransform>
        </Path>
      </Grid>
    </Border>
    <ControlTemplate.Triggers>
      <Trigger Property="IsMouseOver" Value="True">
        <Trigger.EnterActions>
          <BeginStoryboard>
            <Storyboard>
              <DoubleAnimation Storyboard.TargetName="Velo" Storyboard.TargetProperty="Opacity"
                               To="1" Duration="0:0:0.11"/>
            </Storyboard>
          </BeginStoryboard>
        </Trigger.EnterActions>
        <Trigger.ExitActions>
          <BeginStoryboard>
            <Storyboard>
              <DoubleAnimation Storyboard.TargetName="Velo" Storyboard.TargetProperty="Opacity"
                               To="0" Duration="0:0:0.16"/>
            </Storyboard>
          </BeginStoryboard>
        </Trigger.ExitActions>
      </Trigger>
      <Trigger Property="IsChecked" Value="True">
        <Trigger.EnterActions>
          <BeginStoryboard>
            <Storyboard>
              <DoubleAnimation Storyboard.TargetName="Giro" Storyboard.TargetProperty="Angle"
                               To="180" Duration="0:0:0.19" EasingFunction="{StaticResource EEaseSalida}"/>
            </Storyboard>
          </BeginStoryboard>
        </Trigger.EnterActions>
        <Trigger.ExitActions>
          <BeginStoryboard>
            <Storyboard>
              <DoubleAnimation Storyboard.TargetName="Giro" Storyboard.TargetProperty="Angle"
                               To="0" Duration="0:0:0.16"/>
            </Storyboard>
          </BeginStoryboard>
        </Trigger.ExitActions>
      </Trigger>
    </ControlTemplate.Triggers>
  </ControlTemplate>

  <Style TargetType="ComboBox">
    <Setter Property="FontFamily" Value="{StaticResource FBody}"/>
    <Setter Property="FontSize" Value="12.5"/>
    <Setter Property="Foreground" Value="{StaticResource BText}"/>
    <Setter Property="Height" Value="36"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ComboBox">
          <Grid>
            <ToggleButton Template="{StaticResource ComboToggle}"
                          IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"
                          Focusable="False" ClickMode="Press"/>
            <Popup IsOpen="{TemplateBinding IsDropDownOpen}" Placement="Bottom"
                   AllowsTransparency="True" PopupAnimation="Fade" Focusable="False">
              <Border Background="{StaticResource BSurfaceAlt}" BorderBrush="{StaticResource BStroke}"
                      BorderThickness="1" CornerRadius="{StaticResource RMd}" Margin="0,5,0,0"
                      MinWidth="{TemplateBinding ActualWidth}">
                <ScrollViewer MaxHeight="320">
                  <StackPanel IsItemsHost="True"/>
                </ScrollViewer>
              </Border>
            </Popup>
          </Grid>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style TargetType="ComboBoxItem">
    <Setter Property="Padding" Value="13,8"/>
    <Setter Property="Foreground" Value="{StaticResource BText}"/>
    <Setter Property="Cursor" Value="Hand"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ComboBoxItem">
          <Grid>
            <Border x:Name="Velo" Background="{StaticResource BHover}" Opacity="0" IsHitTestVisible="False"/>
            <Border x:Name="Sel" Background="{StaticResource BAccentWash}" Opacity="0" IsHitTestVisible="False"/>
            <Border x:Name="Bd" Background="Transparent" Padding="{TemplateBinding Padding}">
              <ContentPresenter/>
            </Border>
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Trigger.EnterActions>
                <BeginStoryboard>
                  <Storyboard>
                    <DoubleAnimation Storyboard.TargetName="Velo" Storyboard.TargetProperty="Opacity"
                                     To="1" Duration="0:0:0.09"/>
                  </Storyboard>
                </BeginStoryboard>
              </Trigger.EnterActions>
              <Trigger.ExitActions>
                <BeginStoryboard>
                  <Storyboard>
                    <DoubleAnimation Storyboard.TargetName="Velo" Storyboard.TargetProperty="Opacity"
                                     To="0" Duration="0:0:0.12"/>
                  </Storyboard>
                </BeginStoryboard>
              </Trigger.ExitActions>
            </Trigger>
            <Trigger Property="IsSelected" Value="True">
              <Trigger.EnterActions>
                <BeginStoryboard>
                  <Storyboard>
                    <DoubleAnimation Storyboard.TargetName="Sel" Storyboard.TargetProperty="Opacity"
                                     To="1" Duration="0:0:0.16" EasingFunction="{StaticResource EEaseSalida}"/>
                  </Storyboard>
                </BeginStoryboard>
              </Trigger.EnterActions>
              <Trigger.ExitActions>
                <BeginStoryboard>
                  <Storyboard>
                    <DoubleAnimation Storyboard.TargetName="Sel" Storyboard.TargetProperty="Opacity"
                                     To="0" Duration="0:0:0.16"/>
                  </Storyboard>
                </BeginStoryboard>
              </Trigger.ExitActions>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- ================================================================
       DataGrid: sin líneas verticales, cabecera discreta, datos en mono.
       ================================================================ -->
  <Style TargetType="DataGridColumnHeader">
    <Setter Property="Background" Value="#FF10162A"/>
    <Setter Property="Foreground" Value="{StaticResource BTextMuted}"/>
    <Setter Property="FontFamily" Value="{StaticResource FBody}"/>
    <Setter Property="FontSize" Value="10.5"/>
    <Setter Property="FontWeight" Value="SemiBold"/>
    <Setter Property="Padding" Value="13,11"/>
    <Setter Property="BorderBrush" Value="{StaticResource BStroke}"/>
    <Setter Property="BorderThickness" Value="0,0,0,1"/>
    <Setter Property="HorizontalContentAlignment" Value="Left"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="DataGridColumnHeader">
          <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                  BorderThickness="{TemplateBinding BorderThickness}" Padding="{TemplateBinding Padding}">
            <ContentPresenter VerticalAlignment="Center"/>
          </Border>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style TargetType="DataGridCell">
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="BorderThickness" Value="0"/>
    <Setter Property="Foreground" Value="{StaticResource BText}"/>
    <Setter Property="FontFamily" Value="{StaticResource FMono}"/>
    <Setter Property="FontSize" Value="12"/>
    <Setter Property="Padding" Value="13,8"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="DataGridCell">
          <Border Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
            <ContentPresenter VerticalAlignment="Center"/>
          </Border>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style TargetType="DataGridRow">
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="BorderBrush" Value="{StaticResource BStrokeSoft}"/>
    <Setter Property="BorderThickness" Value="0,0,0,1"/>
    <Style.Triggers>
      <Trigger Property="IsMouseOver" Value="True">
        <Setter Property="Background" Value="{StaticResource BHover}"/>
      </Trigger>
      <Trigger Property="IsSelected" Value="True">
        <Setter Property="Background" Value="{StaticResource BAccentWash}"/>
      </Trigger>
    </Style.Triggers>
  </Style>

  <Style TargetType="DataGrid">
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="BorderThickness" Value="0"/>
    <Setter Property="RowBackground" Value="Transparent"/>
    <Setter Property="GridLinesVisibility" Value="None"/>
    <Setter Property="HeadersVisibility" Value="Column"/>
    <Setter Property="AutoGenerateColumns" Value="True"/>
    <Setter Property="IsReadOnly" Value="True"/>
    <Setter Property="CanUserAddRows" Value="False"/>
    <Setter Property="CanUserDeleteRows" Value="False"/>
    <Setter Property="SelectionMode" Value="Single"/>
    <Setter Property="SelectionUnit" Value="FullRow"/>
    <Setter Property="EnableRowVirtualization" Value="True"/>
    <Setter Property="ColumnWidth" Value="Auto"/>
    <Setter Property="RowHeaderWidth" Value="0"/>
  </Style>

  <!-- Barra de progreso indeterminada propia: la nativa ignora el color.

       El trazo crece de izquierda a derecha escalando (ScaleX) en lugar de
       desplazarse en píxeles. No es un gusto: la versión anterior viajaba de
       -160 a 900 px, un número escrito a mano. En un pie de 1.300 px la barra
       nunca llegaba al borde y el reinicio se veía como un salto; en una
       ventana angosta quedaba medio segundo fuera de escena. Una escala es
       relativa al ancho real, así que el recorrido siempre es exacto y la
       animación sobrevive a cualquier cambio de layout, de DPI o de idioma. -->
  <Style x:Key="Pulse" TargetType="ProgressBar">
    <Setter Property="Height" Value="3"/>
    <Setter Property="IsIndeterminate" Value="True"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ProgressBar">
          <Grid x:Name="Root" Background="{StaticResource BStrokeSoft}" ClipToBounds="True">
            <Border x:Name="Bar" Background="{StaticResource GPulse}" Height="3" VerticalAlignment="Center"
                    Opacity="0" RenderTransformOrigin="0,0.5">
              <Border.RenderTransform>
                <ScaleTransform x:Name="Crecer" ScaleX="0"/>
              </Border.RenderTransform>
            </Border>
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="IsIndeterminate" Value="True">
              <Trigger.EnterActions>
                <BeginStoryboard x:Name="Anim">
                  <!-- Se desvanece justo cuando termina de llenarse: los dos
                       tramos cierran en el mismo cuadro, y por eso el reinicio
                       del ciclo no se nota. -->
                  <Storyboard RepeatBehavior="Forever">
                    <DoubleAnimationUsingKeyFrames Storyboard.TargetName="Crecer"
                                                   Storyboard.TargetProperty="ScaleX">
                      <LinearDoubleKeyFrame Value="0" KeyTime="0:0:0"/>
                      <EasingDoubleKeyFrame Value="0.62" KeyTime="0:0:1"
                                            EasingFunction="{StaticResource EEaseSalida}"/>
                      <EasingDoubleKeyFrame Value="1" KeyTime="0:0:1.75"
                                            EasingFunction="{StaticResource EEaseAcelerando}"/>
                    </DoubleAnimationUsingKeyFrames>
                    <DoubleAnimationUsingKeyFrames Storyboard.TargetName="Bar"
                                                   Storyboard.TargetProperty="Opacity">
                      <EasingDoubleKeyFrame Value="1" KeyTime="0:0:0.18"
                                            EasingFunction="{StaticResource EEaseSalida}"/>
                      <LinearDoubleKeyFrame Value="1" KeyTime="0:0:1.3"/>
                      <LinearDoubleKeyFrame Value="0" KeyTime="0:0:1.75"/>
                    </DoubleAnimationUsingKeyFrames>
                  </Storyboard>
                </BeginStoryboard>
              </Trigger.EnterActions>
              <Trigger.ExitActions>
                <StopStoryboard BeginStoryboardName="Anim"/>
              </Trigger.ExitActions>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- ================================================================
       Entradas
       ================================================================ -->
  <Style x:Key="CampoNumero" TargetType="TextBox">
    <Setter Property="Width" Value="72"/>
    <Setter Property="Height" Value="36"/>
    <Setter Property="Background" Value="{StaticResource BSurfaceAlt}"/>
    <Setter Property="Foreground" Value="{StaticResource BText}"/>
    <Setter Property="FontFamily" Value="{StaticResource FMono}"/>
    <Setter Property="FontSize" Value="13"/>
    <Setter Property="TextAlignment" Value="Center"/>
    <Setter Property="VerticalContentAlignment" Value="Center"/>
    <Setter Property="BorderBrush" Value="{StaticResource BStroke}"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="CaretBrush" Value="{StaticResource BAccent}"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="TextBox">
          <Border x:Name="Bd" Background="{TemplateBinding Background}"
                  BorderBrush="{TemplateBinding BorderBrush}"
                  BorderThickness="{TemplateBinding BorderThickness}"
                  CornerRadius="{StaticResource RSm}">
            <ScrollViewer x:Name="PART_ContentHost" VerticalAlignment="Center" Margin="6,0"/>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsKeyboardFocused" Value="True">
              <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource BAccent}"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- Fila de un panel de ajustes: etiqueta a la izquierda, valor a la
       derecha, separación constante. -->
  <Style x:Key="FilaAjuste" TargetType="Grid">
    <Setter Property="Margin" Value="0,0,0,14"/>
  </Style>

  <!-- Casilla de opción con franja de riesgo, compartida por los diálogos
       de limpieza y optimización. -->
  <Style x:Key="Opcion" TargetType="CheckBox">
    <Setter Property="Cursor" Value="Hand"/>
    <Setter Property="FontFamily" Value="{StaticResource FBody}"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="CheckBox">
          <Grid>
            <!-- El velo va fuera del padding, y no como Background de Bd, para
                 que el hover llene la fila completa igual que antes. -->
            <Border x:Name="Velo" Background="{StaticResource BHover}" CornerRadius="8"
                    Margin="0,0,0,8" Opacity="0" IsHitTestVisible="False"/>
            <Border x:Name="Bd" Background="Transparent" CornerRadius="8" Padding="14,12" Margin="0,0,0,8">
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="3"/>
                  <ColumnDefinition Width="30"/>
                  <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Rectangle Grid.Column="0" Width="3" RadiusX="2" RadiusY="2"
                           Fill="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}}"/>
                <Border x:Name="Box" Grid.Column="1" Width="18" Height="18" CornerRadius="5"
                        BorderBrush="{StaticResource BStroke}" BorderThickness="1.5"
                        VerticalAlignment="Top" Margin="12,1,0,0" Background="Transparent">
                  <Grid>
                    <Border x:Name="Relleno" Background="{StaticResource GAccent}" CornerRadius="3.5"
                            Opacity="0"/>
                    <!-- La palomita se dibuja con un trazo (dash) en lugar de
                         aparecer: es la única forma de animar un Path sin
                         recalcular su geometría en cada cuadro. Con
                         StrokeThickness 2, una raya de 12 cubre los ~15
                         píxeles del zigzag, así que en 12 está entera oculta
                         y en 0 está entera trazada. -->
                    <Path x:Name="Tick" Data="M0,4.5 L3.5,8 L10,0" Stroke="{StaticResource BInk}"
                          StrokeThickness="2" Stretch="None" Margin="3,4,0,0" Opacity="0"
                          StrokeDashArray="12 12" StrokeDashOffset="12"
                          RenderTransformOrigin="0.5,0.5">
                      <Path.RenderTransform>
                        <ScaleTransform x:Name="TickEscala" ScaleX="0.7" ScaleY="0.7"/>
                      </Path.RenderTransform>
                    </Path>
                  </Grid>
                </Border>
                <ContentPresenter Grid.Column="2" Margin="12,0,0,0"/>
              </Grid>
            </Border>
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Trigger.EnterActions>
                <BeginStoryboard>
                  <Storyboard>
                    <DoubleAnimation Storyboard.TargetName="Velo" Storyboard.TargetProperty="Opacity"
                                     To="1" Duration="0:0:0.11"/>
                  </Storyboard>
                </BeginStoryboard>
              </Trigger.EnterActions>
              <Trigger.ExitActions>
                <BeginStoryboard>
                  <Storyboard>
                    <DoubleAnimation Storyboard.TargetName="Velo" Storyboard.TargetProperty="Opacity"
                                     To="0" Duration="0:0:0.16"/>
                  </Storyboard>
                </BeginStoryboard>
              </Trigger.ExitActions>
            </Trigger>
            <Trigger Property="IsChecked" Value="True">
              <Setter TargetName="Box" Property="BorderBrush" Value="{StaticResource BAccentDeep}"/>
              <Trigger.EnterActions>
                <BeginStoryboard>
                  <Storyboard>
                    <DoubleAnimation Storyboard.TargetName="Relleno" Storyboard.TargetProperty="Opacity"
                                     To="1" Duration="0:0:0.19" EasingFunction="{StaticResource EEaseSalida}"/>
                    <DoubleAnimation Storyboard.TargetName="Tick" Storyboard.TargetProperty="Opacity"
                                     To="1" Duration="0:0:0.06"/>
                    <DoubleAnimation Storyboard.TargetName="Tick" Storyboard.TargetProperty="StrokeDashOffset"
                                     From="12" To="0" Duration="0:0:0.22"
                                     EasingFunction="{StaticResource EEaseSalida}"/>
                    <DoubleAnimation Storyboard.TargetName="TickEscala" Storyboard.TargetProperty="ScaleX"
                                     To="1" Duration="0:0:0.22" EasingFunction="{StaticResource EEaseSalto}"/>
                    <DoubleAnimation Storyboard.TargetName="TickEscala" Storyboard.TargetProperty="ScaleY"
                                     To="1" Duration="0:0:0.22" EasingFunction="{StaticResource EEaseSalto}"/>
                  </Storyboard>
                </BeginStoryboard>
              </Trigger.EnterActions>
              <Trigger.ExitActions>
                <BeginStoryboard>
                  <Storyboard>
                    <DoubleAnimation Storyboard.TargetName="Relleno" Storyboard.TargetProperty="Opacity"
                                     To="0" Duration="0:0:0.16"/>
                    <DoubleAnimation Storyboard.TargetName="Tick" Storyboard.TargetProperty="StrokeDashOffset"
                                     To="12" Duration="0:0:0.12"/>
                    <DoubleAnimation Storyboard.TargetName="Tick" Storyboard.TargetProperty="Opacity"
                                     To="0" Duration="0:0:0.12" BeginTime="0:0:0.06"/>
                    <DoubleAnimation Storyboard.TargetName="TickEscala" Storyboard.TargetProperty="ScaleX"
                                     To="0.7" Duration="0:0:0.12"/>
                    <DoubleAnimation Storyboard.TargetName="TickEscala" Storyboard.TargetProperty="ScaleY"
                                     To="0.7" Duration="0:0:0.12"/>
                  </Storyboard>
                </BeginStoryboard>
              </Trigger.ExitActions>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- ================================================================
       Piezas de las bandas de sección, activación y ajustes de Windows.
       ================================================================ -->

  <!-- Cuadro de icono de la banda de sección: el color lo pone el módulo. -->
  <Style x:Key="ModuleTile" TargetType="Border">
    <Setter Property="Width" Value="44"/>
    <Setter Property="Height" Value="44"/>
    <Setter Property="CornerRadius" Value="{StaticResource RMd}"/>
    <Setter Property="VerticalAlignment" Value="Center"/>
  </Style>

  <!-- Icono dentro de ModuleTile. -->
  <Style x:Key="ModuleTileIcon" TargetType="TextBlock">
    <Setter Property="FontFamily" Value="Segoe Fluent Icons, Segoe MDL2 Assets"/>
    <Setter Property="FontSize" Value="20"/>
    <Setter Property="HorizontalAlignment" Value="Center"/>
    <Setter Property="VerticalAlignment" Value="Center"/>
  </Style>

  <!-- Chip de dato corto (KPI) de la banda de sección. -->
  <Style x:Key="KpiChip" TargetType="Border">
    <Setter Property="Background" Value="{StaticResource BSurfaceAlt}"/>
    <Setter Property="CornerRadius" Value="{StaticResource RPill}"/>
    <Setter Property="Padding" Value="11,5"/>
    <Setter Property="Margin" Value="0,0,7,0"/>
  </Style>

  <Style x:Key="KpiChipText" TargetType="TextBlock">
    <Setter Property="FontFamily" Value="{StaticResource FMono}"/>
    <Setter Property="FontSize" Value="11.5"/>
    <Setter Property="Foreground" Value="{StaticResource BTextDim}"/>
    <Setter Property="VerticalAlignment" Value="Center"/>
  </Style>

  <!-- Botón de acción rápida de la banda de sección (icono + texto).

       No trae plantilla propia: reutiliza la de BtnBase, que ya tiene las capas
       de hover, pulsado y foco animadas. Duplicar la plantilla para cambiar
       solo el relleno era un segundo camino por el que el botón podía dejar de
       responder al resto del sistema — y de hecho así había quedado, con el
       hover de estas dos variantes todavía instantáneo. -->
  <Style x:Key="AccionTile" TargetType="Button" BasedOn="{StaticResource BtnBase}">
    <Setter Property="Padding" Value="12,8"/>
    <Setter Property="FontSize" Value="12"/>
    <Setter Property="Margin" Value="0,0,7,0"/>
    <Setter Property="Background" Value="{StaticResource BSurfaceAlt}"/>
    <Setter Property="Foreground" Value="{StaticResource BTextDim}"/>
    <Setter Property="BorderBrush" Value="{StaticResource BStrokeSoft}"/>
  </Style>

  <!-- Botón primario con el mismo formato que AccionTile. -->
  <Style x:Key="AccionTilePrimary" TargetType="Button" BasedOn="{StaticResource BtnBase}">
    <Setter Property="Padding" Value="13,8"/>
    <Setter Property="FontSize" Value="12"/>
    <Setter Property="Margin" Value="0,0,7,0"/>
    <Setter Property="Background" Value="{StaticResource GAccent}"/>
    <Setter Property="Foreground" Value="{StaticResource BInk}"/>
    <Setter Property="BorderBrush" Value="{StaticResource BAccentDeep}"/>
  </Style>

  <!-- Campo de texto ancho (búsqueda, código de activación). -->
  <Style x:Key="CampoTexto" TargetType="TextBox" BasedOn="{StaticResource CampoNumero}">
    <Setter Property="Width" Value="Auto"/>
    <Setter Property="Height" Value="36"/>
    <Setter Property="FontFamily" Value="{StaticResource FBody}"/>
    <Setter Property="FontSize" Value="13"/>
    <Setter Property="TextAlignment" Value="Left"/>
    <Setter Property="Padding" Value="0"/>
    <Setter Property="VerticalContentAlignment" Value="Center"/>
  </Style>

  <!-- Campo del código de activación: monoespaciado y legible al teclear. -->
  <Style x:Key="CampoCodigo" TargetType="TextBox" BasedOn="{StaticResource CampoNumero}">
    <Setter Property="Width" Value="Auto"/>
    <Setter Property="Height" Value="42"/>
    <Setter Property="FontFamily" Value="{StaticResource FMono}"/>
    <Setter Property="FontSize" Value="15"/>
    <Setter Property="TextAlignment" Value="Left"/>
    <Setter Property="CharacterCasing" Value="Upper"/>
    <Setter Property="VerticalContentAlignment" Value="Center"/>
  </Style>

  <!-- Chip de estado (Aplicado / No aplicado / riesgo) con color de etiqueta. -->
  <Style x:Key="EstadoChip" TargetType="Border">
    <Setter Property="CornerRadius" Value="{StaticResource RPill}"/>
    <Setter Property="Padding" Value="9,3"/>
    <Setter Property="VerticalAlignment" Value="Center"/>
    <Setter Property="HorizontalAlignment" Value="Right"/>
  </Style>

  <!-- ================================================================
       Gráfico de barras. Etiqueta a la izquierda, barra al centro y
       cifra a la derecha: se lee por columnas o comparando longitudes,
       sin tener que interpretar ejes. El riel de fondo marca el máximo
       del conjunto, que es la escala con la que se dibujaron.
       ================================================================ -->
  <DataTemplate x:Key="BarTemplate">
    <Grid Margin="0,0,0,11" ToolTip="{Binding Detalle}">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="176"/>
        <ColumnDefinition Width="Auto"/>
        <ColumnDefinition Width="Auto"/>
      </Grid.ColumnDefinitions>
      <TextBlock Grid.Column="0" Text="{Binding Etiqueta}" Style="{StaticResource Dim}"
                 VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Margin="0,0,16,0"/>
      <Grid Grid.Column="1" VerticalAlignment="Center">
        <Rectangle Width="420" Height="10" RadiusX="5" RadiusY="5"
                   Fill="{StaticResource BTrack}" HorizontalAlignment="Left"/>
        <!-- La barra se estira hasta su longitud en vez de aparecer dibujada:
             es el gesto que explica que la cifra se midió contra el riel. Se
             escala (no se anima Width) para no provocar una pasada de layout
             por cuadro dentro de la lista, y el origen en el borde izquierdo es
             lo que la mantiene pegada a la etiqueta. Se empieza en 0,5 y no en
             0 para que el radio de las puntas no se deforme de forma visible. -->
        <Rectangle Height="10" RadiusX="5" RadiusY="5" HorizontalAlignment="Left"
                   Fill="{Binding Color}" Width="{Binding Ancho}" Opacity="0"
                   RenderTransformOrigin="0,0.5">
          <Rectangle.RenderTransform>
            <ScaleTransform ScaleX="0.5"/>
          </Rectangle.RenderTransform>
          <!-- Sin Storyboard.TargetName: dentro de <Rectangle.Triggers> el
               destino ya es el propio rectángulo, y la transformación se
               alcanza por ruta de propiedad. Es el mismo truco del punto de la
               barra superior, y evita depender de que el nombre esté en el
               ámbito de esta plantilla. -->
          <Rectangle.Triggers>
            <EventTrigger RoutedEvent="FrameworkElement.Loaded">
              <BeginStoryboard>
                <Storyboard>
                  <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)"
                                   From="0.5" To="1" Duration="0:0:0.34"
                                   EasingFunction="{StaticResource EEaseSalida}"/>
                  <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                   From="0" To="1" Duration="0:0:0.14"/>
                </Storyboard>
              </BeginStoryboard>
            </EventTrigger>
          </Rectangle.Triggers>
        </Rectangle>
      </Grid>
      <TextBlock Grid.Column="2" Text="{Binding ValorTexto}" FontFamily="{StaticResource FMono}"
                 FontSize="12" Foreground="{Binding Color}" VerticalAlignment="Center"
                 Margin="16,0,0,0" MinWidth="64"/>
    </Grid>
  </DataTemplate>

  <Style TargetType="ToolTip">
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ToolTip">
          <Border Background="{StaticResource BSurfaceHi}" BorderBrush="{StaticResource BStroke}"
                  BorderThickness="1" CornerRadius="{StaticResource RSm}" Padding="11,7"
                  Effect="{StaticResource CardShadow}">
            <ContentPresenter TextBlock.Foreground="{StaticResource BText}"
                              TextBlock.FontFamily="{StaticResource FBody}"
                              TextBlock.FontSize="12"/>
          </Border>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

</ResourceDictionary>
