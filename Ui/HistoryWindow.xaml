<Window x:Class="SysDiag.Ui.HistoryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Historial" Height="640" Width="900" MinHeight="420" MinWidth="700"
        WindowStartupLocation="CenterOwner" Background="{StaticResource BBase}">
  <Grid Margin="24">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
    </Grid.RowDefinitions>

    <StackPanel Grid.Row="0" Margin="0,0,0,16">
      <TextBlock Text="Historial de diagnósticos" Style="{StaticResource H1}"/>
      <TextBlock Style="{StaticResource Dim}" Margin="0,4,0,0"
                 Text="Cada diagnóstico completo queda archivado. Elegí uno de la lista para ver sus hallazgos."/>
    </StackPanel>

    <Grid Grid.Row="1">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="230"/>
        <ColumnDefinition Width="16"/>
        <ColumnDefinition Width="*"/>
      </Grid.ColumnDefinitions>

      <Border Grid.Column="0" Style="{StaticResource Card}" Padding="0">
        <ListBox x:Name="Lista" Style="{StaticResource PlainList}"
                 ItemContainerStyle="{StaticResource FindingItem}"
                 SelectionChanged="Lista_SelectionChanged">
          <ListBox.ItemTemplate>
            <DataTemplate>
              <StackPanel Margin="16,12">
                <TextBlock Text="{Binding Fecha, StringFormat='dd MMM yyyy · HH:mm'}"
                           Style="{StaticResource Body}"/>
                <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                  <TextBlock Text="{Binding Puntaje}" FontFamily="{StaticResource FMono}"
                             FontSize="16" Foreground="{Binding Color}"/>
                  <TextBlock Text="/100" Style="{StaticResource Dim}" Margin="2,3,0,0"/>
                </StackPanel>
                <TextBlock Text="{Binding Cobertura}" Style="{StaticResource Dim}" FontSize="11" Margin="0,2,0,0"/>
              </StackPanel>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
      </Border>

      <Border Grid.Column="2" Style="{StaticResource Card}">
        <Grid>
          <StackPanel x:Name="PanelVacio" VerticalAlignment="Center" HorizontalAlignment="Center">
            <TextBlock Text="Elegí un diagnóstico de la lista" Style="{StaticResource Dim}"/>
          </StackPanel>

          <Grid x:Name="PanelDetalle" Visibility="Collapsed">
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto"/>
              <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0" Margin="0,0,0,14">
              <TextBlock x:Name="TxtEquipo" Style="{StaticResource Body}" FontWeight="SemiBold"/>
              <TextBlock x:Name="TxtResumen" Style="{StaticResource Dim}" Margin="0,4,0,0"/>
            </StackPanel>

            <ListBox Grid.Row="1" x:Name="ListaHallazgos" Style="{StaticResource PlainList}"
                     ItemContainerStyle="{StaticResource FindingItem}">
              <ListBox.ItemTemplate>
                <DataTemplate>
                  <Grid Margin="4,10">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="4"/>
                      <ColumnDefinition Width="100"/>
                      <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Rectangle Grid.Column="0" Width="3" RadiusX="2" RadiusY="2"
                               Fill="{Binding Severity, Converter={StaticResource SevBrush}}"/>
                    <TextBlock Grid.Column="1" Text="{Binding Area}" Style="{StaticResource Dim}" Margin="12,1,0,0"/>
                    <TextBlock Grid.Column="2" Text="{Binding Message}" Style="{StaticResource Body}" TextWrapping="Wrap"/>
                  </Grid>
                </DataTemplate>
              </ListBox.ItemTemplate>
            </ListBox>
          </Grid>
        </Grid>
      </Border>
    </Grid>
  </Grid>
</Window>
