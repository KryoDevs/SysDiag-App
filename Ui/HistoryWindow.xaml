<Window x:Class="SysDiag.Ui.HistoryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        xmlns:ui="clr-namespace:SysDiag.Ui"
        Title="Historial" Height="660" Width="940" MinHeight="440" MinWidth="760"
        WindowStyle="None" WindowStartupLocation="CenterOwner"
        Background="{StaticResource BBase}"
        TextOptions.TextFormattingMode="Ideal" UseLayoutRounding="True">

  <shell:WindowChrome.WindowChrome>
    <shell:WindowChrome CaptionHeight="46" ResizeBorderThickness="6"
                        CornerRadius="0" GlassFrameThickness="0"
                        UseAeroCaptionButtons="False"/>
  </shell:WindowChrome.WindowChrome>

  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="46"/>
      <RowDefinition Height="*"/>
    </Grid.RowDefinitions>

    <Border Grid.Row="0" Background="{StaticResource BRail}"
            BorderBrush="{StaticResource BStrokeSoft}" BorderThickness="0,0,0,1">
      <Grid>
        <StackPanel Orientation="Horizontal" Margin="18,0,0,0" VerticalAlignment="Center">
          <Image Source="/Resources/Logo/Lockup.png" Height="22" Stretch="Uniform"
                 RenderOptions.BitmapScalingMode="HighQuality"/>
          <Rectangle Width="1" Height="16" Fill="{StaticResource BStroke}" Margin="16,0,14,0"/>
          <TextBlock Text="Historial" Style="{StaticResource Dim}" VerticalAlignment="Center"/>
        </StackPanel>
        <Button HorizontalAlignment="Right" Content="&#xE8BB;" Style="{StaticResource BtnCaptionClose}"
                Click="Cerrar_Click" ToolTip="Cerrar"
                AutomationProperties.Name="Cerrar esta ventana"
                shell:WindowChrome.IsHitTestVisibleInChrome="True"/>
      </Grid>
    </Border>

    <Grid Grid.Row="1" Margin="24,16,24,16" ui:Motion.Enter="True">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="*"/>
      </Grid.RowDefinitions>

      <StackPanel Grid.Row="0" Margin="0,0,0,18">
        <TextBlock Text="Historial de diagnósticos" Style="{StaticResource H1}"/>
        <TextBlock Style="{StaticResource Dim}" Margin="0,5,0,0"
                   Text="Cada diagnóstico queda archivado con los módulos que midió. Elegí uno de la lista para ver sus hallazgos."/>
      </StackPanel>

      <Grid Grid.Row="1">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="250"/>
          <ColumnDefinition Width="16"/>
          <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" Style="{StaticResource Card}" Padding="0">
          <ListBox x:Name="Lista" Style="{StaticResource PlainList}"
                   ItemContainerStyle="{StaticResource FindingItem}"
                   SelectionChanged="Lista_SelectionChanged">
            <ListBox.ItemTemplate>
              <DataTemplate>
                <Grid Margin="16,13">
                  <StackPanel>
                    <TextBlock Text="{Binding Fecha, StringFormat='dd MMM yyyy · HH:mm'}"
                               Style="{StaticResource Body}"/>
                    <StackPanel Orientation="Horizontal" Margin="0,5,0,0">
                      <TextBlock Text="{Binding Puntaje}" FontFamily="{StaticResource FMono}"
                                 FontSize="17" Foreground="{Binding Color}"/>
                      <TextBlock Text="/100" Style="{StaticResource Dim}" Margin="3,4,0,0"/>
                    </StackPanel>
                    <Border Style="{StaticResource MiniChip}" Margin="0,7,0,0">
                      <TextBlock Text="{Binding Cobertura}" Style="{StaticResource MiniChipText}"/>
                    </Border>
                  </StackPanel>
                </Grid>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
        </Border>

        <Border Grid.Column="2" Style="{StaticResource Card}">
          <Grid>
            <StackPanel x:Name="PanelVacio" VerticalAlignment="Center" HorizontalAlignment="Center">
              <TextBlock Text="Elegí un diagnóstico de la lista" Style="{StaticResource Dim}"/>
            </StackPanel>

            <Grid x:Name="PanelDetalle" Visibility="Collapsed">
              <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
              </Grid.RowDefinitions>

              <StackPanel Grid.Row="0" Margin="0,0,0,16">
                <TextBlock x:Name="TxtEquipo" Style="{StaticResource Body}" FontWeight="SemiBold"/>
                <TextBlock x:Name="TxtResumen" Style="{StaticResource Dim}" Margin="0,4,0,0" TextWrapping="Wrap"/>
              </StackPanel>

              <ListBox Grid.Row="1" x:Name="ListaHallazgos" Style="{StaticResource PlainList}"
                       ItemContainerStyle="{StaticResource FindingItem}"
                       ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                <ListBox.ItemTemplate>
                  <DataTemplate>
                    <Grid Margin="4,11">
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="4"/>
                        <ColumnDefinition Width="104"/>
                        <ColumnDefinition Width="*"/>
                      </Grid.ColumnDefinitions>
                      <Rectangle Grid.Column="0" Width="4" RadiusX="2" RadiusY="2"
                                 Fill="{Binding Severity, Converter={StaticResource SevBrush}}"/>
                      <TextBlock Grid.Column="1" Text="{Binding Area}" Style="{StaticResource Dim}" Margin="12,1,0,0"
                                 TextTrimming="CharacterEllipsis"/>
                      <TextBlock Grid.Column="2" Text="{Binding Message}" Style="{StaticResource Body}" TextWrapping="Wrap"/>
                    </Grid>
                  </DataTemplate>
                </ListBox.ItemTemplate>
              </ListBox>
            </Grid>
          </Grid>
        </Border>
      </Grid>
    </Grid>
  </Grid>
</Window>
