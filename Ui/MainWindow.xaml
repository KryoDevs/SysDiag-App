<Window x:Class="SysDiag.Ui.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        xmlns:ui="clr-namespace:SysDiag.Ui"
        Title="SysDiag" Height="860" Width="1340" MinHeight="640" MinWidth="1060"
        WindowStartupLocation="CenterScreen" KeyDown="Ventana_KeyDown"
        Background="{StaticResource BBase}"
        TextOptions.TextFormattingMode="Ideal"
        UseLayoutRounding="True">

  <shell:WindowChrome.WindowChrome>
    <shell:WindowChrome CaptionHeight="52" ResizeBorderThickness="6"
                        CornerRadius="0" GlassFrameThickness="0"
                        UseAeroCaptionButtons="False"/>
  </shell:WindowChrome.WindowChrome>

  <Grid x:Name="Root">
    <Grid.RowDefinitions>
      <RowDefinition Height="52"/>
      <RowDefinition Height="*"/>
    </Grid.RowDefinitions>

    <!-- ========================== BARRA SUPERIOR ==========================
         Marca y equipo a la izquierda, estado de la corrida y controles de
         ventana a la derecha. El reloj y el estado van aquí y no en la
         cabecera del módulo porque no pertenecen a ningún módulo: valen
         igual estés donde estés. -->
    <Border Grid.Row="0" Background="{StaticResource BRail}"
            BorderBrush="{StaticResource BStrokeSoft}" BorderThickness="0,0,0,1">
      <Grid>
        <StackPanel Orientation="Horizontal" Margin="18,0,0,0" VerticalAlignment="Center">
          <Image Source="/Resources/Logo/Lockup.png" Height="30" Stretch="Uniform"
                 HorizontalAlignment="Left" RenderOptions.BitmapScalingMode="HighQuality"/>
          <Rectangle Width="1" Height="20" Fill="{StaticResource BStroke}" Margin="18,0,16,0"/>
          <TextBlock Text="{Binding Equipo}" Style="{StaticResource Dim}"
                     VerticalAlignment="Center" MaxWidth="280"
                     TextTrimming="CharacterEllipsis"/>
        </StackPanel>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center"
                    shell:WindowChrome.IsHitTestVisibleInChrome="True">

          <!-- Un atajo de teclado que nadie ve no existe. El rótulo lleva la
               combinación escrita, que es la forma más corta de enseñarla sin
               un tutorial. -->
          <Button Style="{StaticResource BtnQuiet}" Margin="0,0,10,0" Padding="11,5"
                  FontSize="11.5" Click="Paleta_Click"
                  AutomationProperties.Name="Buscar comandos"
                  ToolTip="Busca un módulo, una acción o una tabla por nombre (Ctrl+K)">
            <StackPanel Orientation="Horizontal">
              <TextBlock Text="&#xE721;" FontFamily="Segoe MDL2 Assets" FontSize="12"
                         VerticalAlignment="Center" Margin="0,0,7,0"/>
              <TextBlock Text="Buscar" VerticalAlignment="Center"/>
              <TextBlock Text="Ctrl+K" Style="{StaticResource Eyebrow}" Margin="8,0,0,0"
                         VerticalAlignment="Center" Opacity="0.7"/>
            </StackPanel>
          </Button>

          <Button Content="{Binding LicenciaEtiqueta}" Style="{StaticResource BtnQuiet}"
                  Margin="0,0,10,0" Padding="11,5" FontSize="11.5" Click="Licencia_Click"
                  ToolTip="Estado de la licencia: prueba, activación y compra de códigos"/>

          <Border Style="{StaticResource EstadoPill}" Margin="0,0,14,0">
            <Grid>
              <StackPanel Orientation="Horizontal" Visibility="{Binding Ocupado, Converter={StaticResource BoolVis}}">
                <Ellipse Style="{StaticResource PuntoVivo}"/>
                <TextBlock Text="Midiendo" Style="{StaticResource Dim}"/>
              </StackPanel>
              <StackPanel Orientation="Horizontal" Visibility="{Binding Libre, Converter={StaticResource BoolVis}}">
                <Ellipse Width="7" Height="7" Fill="{StaticResource BOk}" Margin="0,0,7,0"/>
                <TextBlock Text="Listo" Style="{StaticResource Dim}"/>
              </StackPanel>
            </Grid>
          </Border>

          <TextBlock Text="{Binding HoraSistema}" Style="{StaticResource Dim}"
                     FontFamily="{StaticResource FMono}" VerticalAlignment="Center"
                     Foreground="{StaticResource BTextMuted}" Margin="0,0,10,0"/>

          <!-- El Name es para el lector de pantalla: el contenido es un glifo de
               Segoe Fluent Icons, que leído en voz alta es un carácter de área de
               uso privado. El ToolTip no sustituye: no lo anuncia nada. Son los
               únicos cinco botones del programa sin texto visible, y están en la
               cabecera, que es por donde se empieza a navegar. -->
          <Button Content="&#xE921;" Style="{StaticResource BtnCaption}" Click="Min_Click" ToolTip="Minimizar"
                  AutomationProperties.Name="Minimizar la ventana"/>
          <Button x:Name="BtnMax" Content="&#xE922;" Style="{StaticResource BtnCaption}" Click="Max_Click" ToolTip="Maximizar"
                  AutomationProperties.Name="Maximizar o restaurar la ventana"/>
          <Button Content="&#xE8BB;" Style="{StaticResource BtnCaptionClose}" Click="Cerrar_Click" ToolTip="Cerrar"
                  AutomationProperties.Name="Cerrar SysDiag"/>
        </StackPanel>
      </Grid>
    </Border>

    <!-- ============================== CUERPO ============================== -->
    <Grid Grid.Row="1">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="182"/>
        <ColumnDefinition Width="*"/>
      </Grid.ColumnDefinitions>

      <!-- ============================ RAIL ============================
           La acción principal va arriba, como botón, porque es lo que se
           hace siempre al abrir la aplicación; el resto son módulos
           sueltos, agrupados por lo que hacen y no por cuándo se
           escribieron. -->
      <Border Grid.Column="0" Background="{StaticResource GRail}"
              BorderBrush="{StaticResource BStrokeSoft}" BorderThickness="0,0,1,0"
              ui:Motion.Enter="True">
        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
          </Grid.RowDefinitions>

          <Button Grid.Row="0" Style="{StaticResource BtnPrimary}" Margin="14,14,14,4"
                  Height="40" Padding="10,0" Click="Completo_Click" IsEnabled="{Binding Libre}"
                  ToolTip="Red, rendimiento, térmicas, almacenamiento y estabilidad en una sola pasada">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
              <TextBlock Text="&#xE9D9;" Style="{StaticResource CtaIcon}"/>
              <TextBlock Text="Diagnóstico completo" Style="{StaticResource CtaLabel}"/>
            </StackPanel>
          </Button>

          <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="0,8,0,0">
            <StackPanel>
              <ListBox x:Name="Nav" Style="{StaticResource PlainList}"
                       ItemContainerStyle="{StaticResource NavItem}"
                       SelectionChanged="Nav_SelectionChanged"
                       IsEnabled="{Binding Libre}">

                <ListBoxItem Style="{StaticResource NavGroupItem}">
                  <Grid>
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="12"/>
                      <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Rectangle Grid.Column="0" Height="1" Fill="{StaticResource BStroke}" VerticalAlignment="Center"/>
                    <TextBlock Grid.Column="1" Text="ANÁLISIS" Style="{StaticResource NavGroup}" Margin="7,0,0,0"/>
                  </Grid>
                </ListBoxItem>

                <ListBoxItem Tag="red" ToolTip="Latencia, jitter, pérdida, Wi-Fi, canales y traceroute">
                  <StackPanel Orientation="Horizontal">
                    <TextBlock Text="&#xEC05;" Style="{StaticResource NavIcon}"/>
                    <TextBlock Text="Red y latencia" Style="{StaticResource NavLabel}"/>
                  </StackPanel>
                </ListBoxItem>
                <ListBoxItem Tag="ping-monitor" ToolTip="Ping cada segundo en vivo, mientras la ventana esté abierta">
                  <StackPanel Orientation="Horizontal">
                    <TextBlock Text="&#xE9D9;" Style="{StaticResource NavIcon}"/>
                    <TextBlock Text="Monitor de ping" Style="{StaticResource NavLabel}"/>
                  </StackPanel>
                </ListBoxItem>
                <ListBoxItem Tag="rendimiento" ToolTip="CPU real por proceso, memoria y disco">
                  <StackPanel Orientation="Horizontal">
                    <TextBlock Text="&#xE9D2;" Style="{StaticResource NavIcon}"/>
                    <TextBlock Text="Rendimiento" Style="{StaticResource NavLabel}"/>
                  </StackPanel>
                </ListBoxItem>
                <ListBoxItem Tag="termicas" ToolTip="Temperatura, frecuencia, throttling, batería y GPU">
                  <StackPanel Orientation="Horizontal">
                    <TextBlock Text="&#xE9CA;" Style="{StaticResource NavIcon}"/>
                    <TextBlock Text="Térmicas y energía" Style="{StaticResource NavLabel}"/>
                  </StackPanel>
                </ListBoxItem>
                <ListBoxItem Tag="almacenamiento" ToolTip="Salud SMART, desgaste y errores del disco">
                  <StackPanel Orientation="Horizontal">
                    <TextBlock Text="&#xEDA2;" Style="{StaticResource NavIcon}"/>
                    <TextBlock Text="Almacenamiento" Style="{StaticResource NavLabel}"/>
                  </StackPanel>
                </ListBoxItem>
                <ListBoxItem Tag="seguridad" ToolTip="Defender, Firewall, BitLocker, TPM, Secure Boot y UAC — solo lectura">
                  <StackPanel Orientation="Horizontal">
                    <TextBlock Text="&#xEA18;" Style="{StaticResource NavIcon}"/>
                    <TextBlock Text="Seguridad" Style="{StaticResource NavLabel}"/>
                  </StackPanel>
                </ListBoxItem>
                <ListBoxItem Tag="estabilidad" ToolTip="Reinicios, pantallazos, WHEA y volcados">
                  <StackPanel Orientation="Horizontal">
                    <TextBlock Text="&#xE7BA;" Style="{StaticResource NavIcon}"/>
                    <TextBlock Text="Estabilidad" Style="{StaticResource NavLabel}"/>
                  </StackPanel>
                </ListBoxItem>

                <ListBoxItem Style="{StaticResource NavGroupItem}">
                  <Grid>
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="12"/>
                      <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Rectangle Grid.Column="0" Height="1" Fill="{StaticResource BStroke}" VerticalAlignment="Center"/>
                    <TextBlock Grid.Column="1" Text="MANTENIMIENTO" Style="{StaticResource NavGroup}" Margin="7,0,0,0"/>
                  </Grid>
                </ListBoxItem>

                <ListBoxItem Tag="drivers" ToolTip="Inventario de drivers. No descarga ni instala nada">
                  <StackPanel Orientation="Horizontal">
                    <TextBlock Text="&#xE950;" Style="{StaticResource NavIcon}"/>
                    <TextBlock Text="Drivers" Style="{StaticResource NavLabel}"/>
                  </StackPanel>
                </ListBoxItem>
                <ListBoxItem Tag="arranque" ToolTip="Programas al inicio, servicios y software instalado">
                  <StackPanel Orientation="Horizontal">
                    <TextBlock Text="&#xE7B5;" Style="{StaticResource NavIcon}"/>
                    <TextBlock Text="Arranque y software" Style="{StaticResource NavLabel}"/>
                  </StackPanel>
                </ListBoxItem>
                <ListBoxItem Tag="actualizaciones" ToolTip="Programas con versión nueva disponible vía winget">
                  <StackPanel Orientation="Horizontal">
                    <TextBlock Text="&#xE896;" Style="{StaticResource NavIcon}"/>
                    <TextBlock Text="Actualizaciones" Style="{StaticResource NavLabel}"/>
                  </StackPanel>
                </ListBoxItem>
                <ListBoxItem Tag="limpieza" ToolTip="Calcula y borra archivos temporales">
                  <StackPanel Orientation="Horizontal">
                    <TextBlock Text="&#xE74D;" Style="{StaticResource NavIcon}"/>
                    <TextBlock Text="Limpieza" Style="{StaticResource NavLabel}"/>
                  </StackPanel>
                </ListBoxItem>
                <ListBoxItem Tag="optimizar" ToolTip="Ajustes reversibles de red y energía">
                  <StackPanel Orientation="Horizontal">
                    <TextBlock Text="&#xE9F5;" Style="{StaticResource NavIcon}"/>
                    <TextBlock Text="Optimizar" Style="{StaticResource NavLabel}"/>
                  </StackPanel>
                </ListBoxItem>
                <ListBoxItem Tag="tweaks" ToolTip="Ajustes de Windows 10 y 11 por categorías, con respaldo y reversión total">
                  <StackPanel Orientation="Horizontal">
                    <TextBlock Text="&#xE72E;" Style="{StaticResource NavIcon}"/>
                    <TextBlock Text="Ajustes de Windows" Style="{StaticResource NavLabel}"/>
                  </StackPanel>
                </ListBoxItem>
                <ListBoxItem Tag="perfiles" ToolTip="Universidad, Trabajo o Juego: combinaciones listas de energía y red">
                  <StackPanel Orientation="Horizontal">
                    <TextBlock Text="&#xE8FC;" Style="{StaticResource NavIcon}"/>
                    <TextBlock Text="Perfiles" Style="{StaticResource NavLabel}"/>
                  </StackPanel>
                </ListBoxItem>

                <ListBoxItem Style="{StaticResource NavGroupItem}">
                  <Grid>
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="12"/>
                      <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Rectangle Grid.Column="0" Height="1" Fill="{StaticResource BStroke}" VerticalAlignment="Center"/>
                    <TextBlock Grid.Column="1" Text="SISTEMA" Style="{StaticResource NavGroup}" Margin="7,0,0,0"/>
                  </Grid>
                </ListBoxItem>

                <ListBoxItem Tag="punto-restauracion" ToolTip="Punto de restauración completo de Windows, para volver atrás si algo sale mal después">
                  <StackPanel Orientation="Horizontal">
                    <TextBlock Text="&#xE777;" Style="{StaticResource NavIcon}"/>
                    <TextBlock Text="Punto de restauración" Style="{StaticResource NavLabel}"/>
                  </StackPanel>
                </ListBoxItem>
                <ListBoxItem Tag="restaurar" ToolTip="Deshace la última optimización">
                  <StackPanel Orientation="Horizontal">
                    <TextBlock Text="&#xE7A7;" Style="{StaticResource NavIcon}"/>
                    <TextBlock Text="Restaurar estado" Style="{StaticResource NavLabel}"/>
                  </StackPanel>
                </ListBoxItem>
                <ListBoxItem Tag="cambios" ToolTip="Lo que SysDiag cambió en este equipo, con deshacer paso por paso">
                  <StackPanel Orientation="Horizontal">
                    <TextBlock Text="&#xE81C;" Style="{StaticResource NavIcon}"/>
                    <TextBlock Text="Cambios aplicados" Style="{StaticResource NavLabel}"/>
                  </StackPanel>
                </ListBoxItem>
                <ListBoxItem Tag="activacion-windows" ToolTip="Estado de la licencia de Windows y activación por los canales oficiales de Microsoft">
                  <StackPanel Orientation="Horizontal">
                    <TextBlock Text="&#xE975;" Style="{StaticResource NavIcon}"/>
                    <TextBlock Text="Activación de Windows" Style="{StaticResource NavLabel}"/>
                  </StackPanel>
                </ListBoxItem>

                <ListBoxItem Style="{StaticResource NavGroupItem}">
                  <Grid>
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="12"/>
                      <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Rectangle Grid.Column="0" Height="1" Fill="{StaticResource BStroke}" VerticalAlignment="Center"/>
                    <TextBlock Grid.Column="1" Text="DATOS" Style="{StaticResource NavGroup}" Margin="7,0,0,0"/>
                  </Grid>
                </ListBoxItem>

                <ListBoxItem Tag="historial" ToolTip="Diagnósticos guardados: abrí cualquiera para ver sus hallazgos">
                  <StackPanel Orientation="Horizontal">
                    <TextBlock Text="&#xE81C;" Style="{StaticResource NavIcon}"/>
                    <TextBlock Text="Historial" Style="{StaticResource NavLabel}"/>
                  </StackPanel>
                </ListBoxItem>
                <ListBoxItem Tag="ajustes" ToolTip="Segundos de muestreo, cantidad de pings, ventanas de días">
                  <StackPanel Orientation="Horizontal">
                    <TextBlock Text="&#xE713;" Style="{StaticResource NavIcon}"/>
                    <TextBlock Text="Ajustes" Style="{StaticResource NavLabel}"/>
                  </StackPanel>
                </ListBoxItem>
              </ListBox>
            </StackPanel>
          </ScrollViewer>

          <StackPanel Grid.Row="2" Margin="14,10,14,14">
            <Border Background="{StaticResource BSurface}" CornerRadius="{StaticResource RSm}"
                    Padding="12,10" Visibility="{Binding AvisoAdmin}" Margin="0,0,0,12">
              <StackPanel>
                <TextBlock Text="Permisos limitados" Style="{StaticResource Body}" FontSize="12"/>
                <TextBlock Text="Algunos módulos verán datos parciales." Style="{StaticResource Dim}"
                           TextWrapping="Wrap" Margin="0,3,0,8"/>
                <Button Content="Reiniciar como administrador" Style="{StaticResource BtnGhost}"
                        FontSize="12" Padding="10,6" Click="Elevar_Click"/>
              </StackPanel>
            </Border>
            <TextBlock Style="{StaticResource Eyebrow}">
              <Run Text="versión"/><Run Text=" "/><Run Text="{Binding Version, Mode=OneWay}"/>
            </TextBlock>
          </StackPanel>
        </Grid>
      </Border>

      <!-- =========================== CONTENIDO =========================== -->
      <Grid Grid.Column="1">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="*"/>
          <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Cabecera del módulo: qué se está mirando, y el conmutador de
             vistas a la derecha, siempre en el mismo sitio. Entra 50 ms después
             del rail para que la ventana se arme en un recorrido corto y no de
             un golpe. -->
        <Grid Grid.Row="0" Margin="24,16,24,12"
              ui:Motion.Enter="True" ui:Motion.EnterDelay="0:0:0.05">
          <StackPanel VerticalAlignment="Center">
            <TextBlock Text="{Binding Titulo}" Style="{StaticResource H1}"/>
            <TextBlock Text="{Binding Subtitulo}" Style="{StaticResource Dim}" Margin="0,5,0,0"
                       MaxWidth="620" HorizontalAlignment="Left" TextTrimming="CharacterEllipsis"/>
          </StackPanel>
          <Border Style="{StaticResource SegmentBar}" HorizontalAlignment="Right" VerticalAlignment="Center">
            <StackPanel Orientation="Horizontal">
              <RadioButton x:Name="VResumen" Content="Resumen" Style="{StaticResource Segment}" IsChecked="True"/>
              <RadioButton x:Name="VHallazgos" Content="Hallazgos" Style="{StaticResource Segment}"/>
              <RadioButton x:Name="VDatos" Content="Datos" Style="{StaticResource Segment}"/>
              <RadioButton x:Name="VRegistro" Content="Registro" Style="{StaticResource Segment}"/>
            </StackPanel>
          </Border>
        </Grid>

        <!-- ===================== BANDA DE SECCIÓN ==========================
             Identidad del módulo activo y sus acciones propias: cada sección
             tiene su color, su icono y sus herramientas a mano, siempre en
             el mismo sitio. Es lo que hace que cada sección se vea propia y
             no una copia de las demás. -->
        <Grid Grid.Row="1" Margin="24,0,24,14">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
          </Grid.ColumnDefinitions>

          <Border Grid.Column="0" Style="{StaticResource ModuleTile}" Background="{Binding ModuloLavado}"
                  Margin="0,0,14,0">
            <TextBlock Text="{Binding Contexto.Icono}" Style="{StaticResource ModuleTileIcon}"
                       Foreground="{Binding ModuloAcento}"/>
          </Border>

          <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,12,0">
            <TextBlock Text="{Binding Contexto.Nombre}" Style="{StaticResource Body}" FontWeight="SemiBold"/>
            <TextBlock Text="{Binding Contexto.Descripcion}" Style="{StaticResource Dim}"
                       TextTrimming="CharacterEllipsis" MaxWidth="520"/>
          </StackPanel>

          <ItemsControl Grid.Column="2" VerticalAlignment="Center" ItemsSource="{Binding Contexto.Acciones}">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <Button Tag="{Binding Id}" Click="AccionRapida_Click" ToolTip="{Binding Texto}">
                  <Button.Style>
                    <Style TargetType="Button" BasedOn="{StaticResource AccionTile}">
                      <Style.Triggers>
                        <DataTrigger Binding="{Binding EsPrimario}" Value="True">
                          <Setter Property="Background" Value="{StaticResource GAccent}"/>
                          <Setter Property="Foreground" Value="{StaticResource BInk}"/>
                          <Setter Property="BorderThickness" Value="0"/>
                        </DataTrigger>
                      </Style.Triggers>
                    </Style>
                  </Button.Style>
                  <StackPanel Orientation="Horizontal">
                    <TextBlock Text="{Binding Icono}" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                               FontSize="13" VerticalAlignment="Center" Margin="0,0,6,0"/>
                    <TextBlock Text="{Binding Texto}" VerticalAlignment="Center" FontSize="12"/>
                  </StackPanel>
                </Button>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </Grid>

        <!-- ============================ VISTAS ============================
             La atenuación mientras se mide existía como un salto de 1,0 a 0,4
             del ViewModel; ahora interpola Motion, que además respeta la
             preferencia del sistema de no animar y deja el mismo valor final.
             Cada vista entra con su propio desvanecimiento porque se muestran
             por Visibility: «volver a ser visible» es el cambio de estado. -->
        <Grid Grid.Row="2" Margin="24,0,24,0" ui:Motion.Fade="{Binding ContenidoOpacidad}">

          <!-- ========================== Resumen ========================== -->
          <Grid Visibility="{Binding IsChecked, ElementName=VResumen, Converter={StaticResource BoolVis}}"
                ui:Motion.Enter="True">
            <ScrollViewer VerticalScrollBarVisibility="Auto"
                          Visibility="{Binding HayDatos, Converter={StaticResource BoolVis}}">
              <StackPanel>

                <!-- Titular: el puntaje ordena la atención, y va siempre con
                     su desglose al lado, porque un número sin el porqué no
                     informa. -->
                <Border Style="{StaticResource HeroCard}" Margin="0,0,0,16">
                  <Grid>
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="Auto"/>
                      <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Margin="0,0,36,0" HorizontalAlignment="Center">
                      <TextBlock Text="ESTADO GENERAL" Style="{StaticResource SectionLabel}"
                                 HorizontalAlignment="Center"/>

                      <!-- Anillo de progreso: un arco trazado con la geometría
                           que calcula ScoreArc, sobre un aro de fondo que marca
                           la escala completa. El número va centrado adentro.

                           Las medidas están atadas a las del calculador: el
                           arco se dibuja en un lienzo de 120x120 con centro en
                           (60,60) y radio 50. El aro de fondo tiene que medir
                           100 (diámetro de la línea media, no del borde) para
                           que ambos compartan radio, y el Path mantiene sus 120
                           y se centra: si se agranda, el arco se dibuja
                           descentrado respecto del aro.

                           Ni el número ni el arco enlazan su propiedad final:
                           enlazan el valor *objetivo* de Motion, que los
                           interpola. Un puntaje que aparece de golpe no dice si
                           mejoró; uno que sube de 60 a 82 en un tercio de
                           segundo lo dice sin explicarlo. Ver Ui/Motion.cs. -->
                      <Grid Width="132" Height="132">
                        <Ellipse Width="100" Height="100" HorizontalAlignment="Center" VerticalAlignment="Center"
                                 Stroke="{StaticResource BStrokeSoft}" StrokeThickness="11"/>
                        <Path Width="120" Height="120" Stretch="None"
                              HorizontalAlignment="Center" VerticalAlignment="Center"
                              ui:Motion.Sweep="{Binding Puntaje}"
                              Stroke="{Binding PuntajeBrush}" StrokeThickness="11"
                              StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                          <TextBlock ui:Motion.Number="{Binding Puntaje}" FontFamily="{StaticResource FDisplay}"
                                     FontSize="36" FontWeight="SemiBold" Foreground="{Binding PuntajeBrush}"
                                     HorizontalAlignment="Center"/>
                          <TextBlock Text="/ 100" Style="{StaticResource Eyebrow}"
                                     HorizontalAlignment="Center" Margin="0,-3,0,0"/>
                        </StackPanel>
                      </Grid>

                      <TextBlock Text="{Binding PuntajeEtiqueta}" Style="{StaticResource Body}"
                                 Foreground="{Binding PuntajeBrush}" Margin="0,12,0,0"
                                 HorizontalAlignment="Center"/>
                    </StackPanel>

                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                      <TextBlock Text="{Binding PuntajeDesglose}" Style="{StaticResource Dim}"
                                 TextWrapping="Wrap" Margin="0,0,0,14"/>
                      <Border Background="{StaticResource BAccentWash}" CornerRadius="{StaticResource RSm}"
                              Padding="13,10" HorizontalAlignment="Left">
                        <TextBlock Text="{Binding PuntajeTendencia}" Style="{StaticResource Body}"
                                   TextWrapping="Wrap"/>
                      </Border>
                    </StackPanel>
                  </Grid>
                </Border>

                <!-- Qué conviene mirar después. Va segundo y no al final:
                     es la única parte del resumen que dice qué hacer, y
                     enterrarla al pie la convertía en decoración. -->
                <Border Style="{StaticResource CardOutline}" Margin="0,0,0,20">
                  <StackPanel>
                    <TextBlock Text="SIGUIENTE PASO" Style="{StaticResource SectionLabel}"/>
                    <TextBlock Text="{Binding Sugerencia}" Style="{StaticResource Dim}"
                               TextWrapping="Wrap"/>
                  </StackPanel>
                </Border>

                <TextBlock Text="MEDICIONES" Style="{StaticResource SectionLabel}"/>

                <!-- Cada tarjeta entra unos milisegundos después de la anterior y
                     se eleva al pasar el puntero. La cascada no es adorno: con
                     diez módulos midiendo a la vez, el ojo puede seguir un
                     recorrido en lugar de descubrir veinte números nuevos. -->
                <ItemsControl ItemsSource="{Binding Tarjetas}" ui:Motion.Stagger="True">
                  <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
                  </ItemsControl.ItemsPanel>
                  <ItemsControl.ItemTemplate>
                    <DataTemplate>
                      <Border Style="{StaticResource MetricCard}" Width="256" Margin="0,0,14,14"
                              ui:Motion.Lift="0.014">
                        <StackPanel>
                          <Grid>
                            <TextBlock Text="{Binding Titulo}" Style="{StaticResource Eyebrow}"
                                       HorizontalAlignment="Left" TextTrimming="CharacterEllipsis"
                                       Margin="0,0,8,0"/>
                            <Border Style="{StaticResource MiniChip}" HorizontalAlignment="Right"
                                    Visibility="{Binding Modulo, Converter={StaticResource NotEmptyVis}}">
                              <TextBlock Text="{Binding Modulo, Converter={StaticResource ModuloLabel}}"
                                         Style="{StaticResource MiniChipText}"/>
                            </Border>
                          </Grid>
                          <TextBlock Text="{Binding Valor}" Style="{StaticResource Metric}"
                                     Foreground="{Binding Acento}" Margin="0,10,0,12"/>
                          <!-- Regla de escala: marcas que se llenan según magnitud -->
                          <Grid Height="6">
                            <Grid.ColumnDefinitions>
                              <ColumnDefinition Width="{Binding FillStar}"/>
                              <ColumnDefinition Width="{Binding RestStar}"/>
                            </Grid.ColumnDefinitions>
                            <Rectangle Grid.Column="0" Fill="{Binding TicksOn}"/>
                            <Rectangle Grid.Column="1" Fill="{Binding TicksOff}"/>
                          </Grid>
                          <TextBlock Text="{Binding Nota}" Style="{StaticResource Dim}"
                                     Margin="0,12,0,0" TextTrimming="CharacterEllipsis"/>
                        </StackPanel>
                      </Border>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!-- Gráficos: los números de las tarjetas dicen cuánto; estos
                     dicen cuánto comparado con qué, que es lo que permite
                     decidir dónde mirar. -->
                <ItemsControl Margin="0,10,0,0">
                  <ItemsControl.Resources>
                    <Style TargetType="Border" BasedOn="{StaticResource Card}"/>
                  </ItemsControl.Resources>

                  <!-- Composición del disco: un anillo y no barras, porque la
                       pregunta no es «cuál es más grande» sino «de qué está
                       hecho el total». Las medidas del aro están atadas a
                       DonutChart: radio externo 62, interno 43, así que la
                       elipse de fondo mide 105 (= 124 de diámetro exterior
                       menos los 19 de grosor de trazo, que se centra en el
                       borde) y comparte centro con los arcos. -->
                  <Border Margin="0,0,0,16"
                          Visibility="{Binding GraficoDiscos.Visible, Converter={StaticResource BoolVis}}">
                    <StackPanel>
                      <TextBlock Text="{Binding GraficoDiscos.Titulo}" Style="{StaticResource SectionLabel}"/>
                      <TextBlock Text="{Binding GraficoDiscos.Nota}" Style="{StaticResource Dim}"
                                 TextWrapping="Wrap" Margin="0,0,0,18"/>
                      <Grid HorizontalAlignment="Left">
                        <Grid.ColumnDefinitions>
                          <ColumnDefinition Width="Auto"/>
                          <ColumnDefinition Width="28"/>
                          <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <Grid Grid.Column="0" Width="132" Height="132">
                          <Ellipse Width="105" Height="105" Stroke="{StaticResource BStrokeSoft}"
                                   StrokeThickness="19" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                          <ItemsControl ItemsSource="{Binding GraficoDiscos.Segmentos}">
                            <ItemsControl.ItemsPanel>
                              <ItemsPanelTemplate><Canvas/></ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                              <DataTemplate>
                                <Path Data="{Binding Arco}" Fill="{Binding Color}"
                                      ToolTip="{Binding Detalle}"/>
                              </DataTemplate>
                            </ItemsControl.ItemTemplate>
                          </ItemsControl>
                          <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                            <TextBlock Text="{Binding GraficoDiscos.Centro1}" Style="{StaticResource Metric}"
                                       FontSize="18" HorizontalAlignment="Center" Foreground="{StaticResource BText}"/>
                            <TextBlock Text="{Binding GraficoDiscos.Centro2}" Style="{StaticResource Eyebrow}"
                                       HorizontalAlignment="Center" Margin="0,1,0,0"/>
                          </StackPanel>
                        </Grid>

                        <ItemsControl Grid.Column="2" ItemsSource="{Binding GraficoDiscos.Segmentos}"
                                      ItemTemplate="{StaticResource DonutLegendTemplate}"
                                      VerticalAlignment="Center" MinWidth="300"/>
                      </Grid>
                    </StackPanel>
                  </Border>

                  <Border Margin="0,0,0,16"
                          Visibility="{Binding GraficoRed.Visible, Converter={StaticResource BoolVis}}">
                    <StackPanel>
                      <TextBlock Text="{Binding GraficoRed.Titulo}" Style="{StaticResource SectionLabel}"/>
                      <TextBlock Text="{Binding GraficoRed.Nota}" Style="{StaticResource Dim}"
                                 TextWrapping="Wrap" Margin="0,0,0,16"/>
                      <ItemsControl ItemsSource="{Binding GraficoRed.Barras}"
                                    ItemTemplate="{StaticResource BarTemplate}"/>
                      <!-- Pie de escala: sin esto la rejilla del riel es
                           decoración. Acá se dice cuánto vale el riel completo
                           y cuánto hay entre guía y guía. -->
                      <Grid Margin="0,12,0,0">
                        <TextBlock Text="{Binding GraficoRed.Escala}" Style="{StaticResource ChartFoot}"
                                   HorizontalAlignment="Left"/>
                        <TextBlock Text="{Binding GraficoRed.Resumen}" Style="{StaticResource ChartFoot}"
                                   HorizontalAlignment="Right"/>
                      </Grid>
                    </StackPanel>
                  </Border>

                  <Border Margin="0,0,0,16"
                          Visibility="{Binding GraficoProcesos.Visible, Converter={StaticResource BoolVis}}">
                    <StackPanel>
                      <TextBlock Text="{Binding GraficoProcesos.Titulo}" Style="{StaticResource SectionLabel}"/>
                      <TextBlock Text="{Binding GraficoProcesos.Nota}" Style="{StaticResource Dim}"
                                 TextWrapping="Wrap" Margin="0,0,0,16"/>
                      <ItemsControl ItemsSource="{Binding GraficoProcesos.Barras}"
                                    ItemTemplate="{StaticResource BarTemplate}"/>
                      <Grid Margin="0,12,0,0">
                        <TextBlock Text="{Binding GraficoProcesos.Escala}" Style="{StaticResource ChartFoot}"
                                   HorizontalAlignment="Left"/>
                        <TextBlock Text="{Binding GraficoProcesos.Resumen}" Style="{StaticResource ChartFoot}"
                                   HorizontalAlignment="Right"/>
                      </Grid>
                    </StackPanel>
                  </Border>

                  <Border Margin="0,0,0,16"
                          Visibility="{Binding GraficoEventos.Visible, Converter={StaticResource BoolVis}}">
                    <StackPanel>
                      <TextBlock Text="{Binding GraficoEventos.Titulo}" Style="{StaticResource SectionLabel}"/>
                      <TextBlock Text="{Binding GraficoEventos.Nota}" Style="{StaticResource Dim}"
                                 TextWrapping="Wrap" Margin="0,0,0,16"/>
                      <ItemsControl ItemsSource="{Binding GraficoEventos.Barras}"
                                    ItemTemplate="{StaticResource BarTemplate}"/>
                      <Grid Margin="0,12,0,0">
                        <TextBlock Text="{Binding GraficoEventos.Escala}" Style="{StaticResource ChartFoot}"
                                   HorizontalAlignment="Left"/>
                        <TextBlock Text="{Binding GraficoEventos.Resumen}" Style="{StaticResource ChartFoot}"
                                   HorizontalAlignment="Right"/>
                      </Grid>
                    </StackPanel>
                  </Border>

                  <Border Margin="0,0,0,16"
                          Visibility="{Binding GraficoHistorial.Visible, Converter={StaticResource BoolVis}}">
                    <StackPanel>
                      <TextBlock Text="EVOLUCIÓN DEL PUNTAJE" Style="{StaticResource SectionLabel}"/>
                      <TextBlock Style="{StaticResource Dim}" TextWrapping="Wrap" Margin="0,0,0,16"
                                 Text="Cada punto es un diagnóstico guardado. La línea subiendo significa que el equipo mejoró respecto a como estaba; bajando, que apareció algo nuevo."/>
                      <Grid Margin="0,4,0,0" HorizontalAlignment="Left">
                        <Grid.ColumnDefinitions>
                          <ColumnDefinition Width="40"/>
                          <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <!-- Eje Y con rótulos. El rango se ajusta a los datos
                             en vez de estar clavado en 0-100: con puntajes que
                             se mueven entre 78 y 84, una escala completa
                             aplana la serie y la variación real desaparece.
                             El límite de 0-100 lo fija el cálculo, así que el
                             eje nunca promete más de lo que el puntaje puede
                             dar. Ver ChartMath.Escala. -->
                        <ItemsControl Grid.Column="0" ItemsSource="{Binding GraficoHistorial.Guias}"
                                      Width="40" Height="120">
                          <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate><Canvas/></ItemsPanelTemplate>
                          </ItemsControl.ItemsPanel>
                          <ItemsControl.ItemContainerStyle>
                            <Style TargetType="ContentPresenter">
                              <Setter Property="Canvas.Top" Value="{Binding YTexto}"/>
                            </Style>
                          </ItemsControl.ItemContainerStyle>
                          <ItemsControl.ItemTemplate>
                            <DataTemplate>
                              <TextBlock Text="{Binding Texto}" Style="{StaticResource AxisLabel}"/>
                            </DataTemplate>
                          </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <Canvas Grid.Column="1" Width="620" Height="120" ClipToBounds="False">
                          <!-- Rejilla horizontal: una línea por rótulo del eje. -->
                          <ItemsControl ItemsSource="{Binding GraficoHistorial.Guias}" Width="620" Height="120">
                            <ItemsControl.ItemsPanel>
                              <ItemsPanelTemplate><Canvas/></ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                              <DataTemplate>
                                <Line X1="0" X2="620" Y1="{Binding Y}" Y2="{Binding Y}"
                                      Stroke="{StaticResource BStrokeSoft}" StrokeThickness="1"/>
                              </DataTemplate>
                            </ItemsControl.ItemTemplate>
                          </ItemsControl>

                          <!-- Promedio: la única línea que no se mide, se
                             calcula. Sirve de referencia para saber si un
                             punto es bueno o malo sin acordarse del anterior. -->
                          <Line X1="0" X2="620" Stroke="{StaticResource BTextMuted}" StrokeThickness="1"
                                StrokeDashArray="4 4" Opacity="0.55"
                                Y1="{Binding GraficoHistorial.MediaY}"
                                Y2="{Binding GraficoHistorial.MediaY}"/>

                          <Polygon Points="{Binding GraficoHistorial.Area}" Fill="{StaticResource BAccentWash}"/>
                          <Polyline Points="{Binding GraficoHistorial.Puntos}"
                                    Stroke="{StaticResource BAccent}" StrokeThickness="2"
                                    StrokeLineJoin="Round"/>

                          <ItemsControl ItemsSource="{Binding GraficoHistorial.Marcas}">
                            <ItemsControl.ItemsPanel>
                              <ItemsPanelTemplate><Canvas/></ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemContainerStyle>
                              <Style TargetType="ContentPresenter">
                                <Setter Property="Canvas.Left" Value="{Binding X}"/>
                                <Setter Property="Canvas.Top" Value="{Binding Y}"/>
                              </Style>
                            </ItemsControl.ItemContainerStyle>
                            <ItemsControl.ItemTemplate>
                              <DataTemplate>
                                <Ellipse Width="7" Height="7" Fill="{StaticResource BAccent2}"
                                         ToolTip="{Binding Tooltip}"/>
                              </DataTemplate>
                            </ItemsControl.ItemTemplate>
                          </ItemsControl>

                          <!-- El presente: el ojo encuentra el último punto sin
                               tener que seguir la línea hasta el borde. -->
                          <Ellipse Canvas.Left="{Binding GraficoHistorial.UltimoX}"
                                   Canvas.Top="{Binding GraficoHistorial.UltimoY}"
                                   Width="10" Height="10" Fill="{StaticResource BAccent2}"
                                   Stroke="{StaticResource BSurface}" StrokeThickness="2"
                                   ToolTip="{Binding GraficoHistorial.Resumen}"/>
                        </Canvas>
                      </Grid>
                      <Grid Margin="0,10,0,0">
                        <TextBlock Text="{Binding GraficoHistorial.Rango}" Style="{StaticResource Eyebrow}"/>
                        <TextBlock Text="{Binding GraficoHistorial.Resumen}" Style="{StaticResource Eyebrow}"
                                   HorizontalAlignment="Right"/>
                      </Grid>
                    </StackPanel>
                  </Border>
                </ItemsControl>
              </StackPanel>
            </ScrollViewer>

            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="440"
                        Visibility="{Binding HayDatos, Converter={StaticResource BoolVisNot}}">
              <Border Width="72" Height="72" CornerRadius="36" Background="{StaticResource BAccentWash}"
                      Margin="0,0,0,20">
                <TextBlock Text="&#xE9D9;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                           FontSize="30" Foreground="{StaticResource BAccent}"
                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
              </Border>
              <TextBlock Text="Todavía no hay mediciones" Style="{StaticResource H1}"
                         HorizontalAlignment="Center"/>
              <TextBlock Style="{StaticResource Dim}" Margin="0,10,0,0" TextAlignment="Center"
                         TextWrapping="Wrap" Text="{Binding TextoVacio}"/>
            </StackPanel>
          </Grid>

          <!-- ========================= Hallazgos ========================= -->
          <Grid Visibility="{Binding IsChecked, ElementName=VHallazgos, Converter={StaticResource BoolVis}}"
                ui:Motion.Enter="True">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="2.1*"/>
              <ColumnDefinition Width="16"/>
              <ColumnDefinition Width="*" MinWidth="270"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Style="{StaticResource Card}" Padding="0">
              <Grid>
                <Grid.RowDefinitions>
                  <RowDefinition Height="Auto"/>
                  <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Filtro por severidad. Con veinte hallazgos mezclados, lo
                     primero que se quiere ver es lo crítico, y recorrer la
                     lista buscando el color no es una forma de encontrarlo. -->
                <Border Grid.Row="0" Padding="16,11" BorderBrush="{StaticResource BStrokeSoft}"
                        BorderThickness="0,0,0,1">
                  <Grid>
                    <StackPanel Orientation="Horizontal">
                      <RadioButton Content="Todos" Style="{StaticResource FilterChip}" Tag="0"
                                   IsChecked="True" GroupName="FiltroHallazgos"
                                   Checked="FiltroHallazgos_Checked"/>
                      <RadioButton Content="Críticos" Style="{StaticResource FilterChip}" Tag="1" Margin="6,0,0,0"
                                   GroupName="FiltroHallazgos" Checked="FiltroHallazgos_Checked"/>
                      <RadioButton Content="Avisos" Style="{StaticResource FilterChip}" Tag="2" Margin="6,0,0,0"
                                   GroupName="FiltroHallazgos" Checked="FiltroHallazgos_Checked"/>
                      <RadioButton Content="Correctos" Style="{StaticResource FilterChip}" Tag="3" Margin="6,0,0,0"
                                   GroupName="FiltroHallazgos" Checked="FiltroHallazgos_Checked"/>
                    </StackPanel>
                    <TextBlock Text="{Binding ContadorHallazgos}" Style="{StaticResource Eyebrow}"
                               HorizontalAlignment="Right" VerticalAlignment="Center"/>
                  </Grid>
                </Border>

                <ListBox Grid.Row="1" ItemsSource="{Binding HallazgosFiltrados}" Style="{StaticResource PlainList}"
                         ItemContainerStyle="{StaticResource FindingItem}"
                         SelectedItem="{Binding HallazgoSeleccionado, Mode=TwoWay}">
                  <ListBox.ItemTemplate>
                    <DataTemplate>
                      <Grid Margin="16,13">
                        <Grid.ColumnDefinitions>
                          <ColumnDefinition Width="4"/>
                          <ColumnDefinition Width="104"/>
                          <ColumnDefinition Width="128"/>
                          <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Rectangle Grid.Column="0" Width="4" RadiusX="2" RadiusY="2"
                                   Fill="{Binding Severity, Converter={StaticResource SevBrush}}"/>
                        <Border Grid.Column="1" Style="{StaticResource Chip}"
                                Background="{Binding Severity, Converter={StaticResource SevWash}}">
                          <TextBlock Text="{Binding Etiqueta}" Style="{StaticResource Eyebrow}"
                                     Foreground="{Binding Severity, Converter={StaticResource SevBrush}}"/>
                        </Border>
                        <TextBlock Grid.Column="2" Text="{Binding Area}" Style="{StaticResource Dim}"
                                   VerticalAlignment="Center" Margin="12,0,0,0"/>
                        <TextBlock Grid.Column="3" Text="{Binding Message}" Style="{StaticResource Body}"
                                   TextWrapping="Wrap" VerticalAlignment="Center"/>
                      </Grid>
                    </DataTemplate>
                  </ListBox.ItemTemplate>
                </ListBox>

                <Border Grid.Row="1" Background="{StaticResource BSurface}" Padding="26,22"
                        Visibility="{Binding SinHallazgos, Converter={StaticResource BoolVis}}">
                  <TextBlock Style="{StaticResource Dim}" TextAlignment="Center" TextWrapping="Wrap"
                             Text="Sin hallazgos todavía. Pulsa «Diagnóstico completo» o elige un módulo del panel izquierdo: los hallazgos aparecen aquí con su recomendación."/>
                </Border>

                <!-- El filtro no deja nada: no es que no se haya medido, es
                     que no hay nada de ese tipo. Decir otra cosa haría dudar
                     de si la medición funcionó. -->
                <Border Grid.Row="1" Background="{StaticResource BSurface}" Padding="26,22"
                        Visibility="{Binding SinHallazgosPorFiltro, Converter={StaticResource BoolVis}}">
                  <TextBlock Style="{StaticResource Dim}" TextAlignment="Center" TextWrapping="Wrap"
                             Text="Ningún hallazgo de este tipo. El filtro está acotando la lista: ponlo en «Todos» para ver el resto."/>
                </Border>
              </Grid>
            </Border>

            <Border Grid.Column="2" Style="{StaticResource Card}">
              <Grid>
                <Grid.RowDefinitions>
                  <RowDefinition Height="Auto"/>
                  <RowDefinition Height="*"/>
                  <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Text="RECOMENDACIÓN" Style="{StaticResource SectionLabel}"/>

                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"
                              Margin="0,0,-14,0" Padding="0,0,14,0">
                  <TextBlock Text="{Binding DetalleHallazgo}" Style="{StaticResource Body}"
                             TextWrapping="Wrap" Foreground="{StaticResource BTextDim}"/>
                </ScrollViewer>

                <Button Grid.Row="2" Content="{Binding TextoReparar}" Margin="0,16,0,0"
                        Visibility="{Binding BotonReparar}" IsEnabled="{Binding Libre}"
                        Click="Reparar_Click" Style="{StaticResource BtnPrimary}"
                        HorizontalAlignment="Stretch"/>
              </Grid>
            </Border>
          </Grid>

          <!-- =========================== Datos =========================== -->
          <Grid Visibility="{Binding IsChecked, ElementName=VDatos, Converter={StaticResource BoolVis}}"
                ui:Motion.Enter="True">
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto"/>
              <RowDefinition Height="Auto"/>
              <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Selector y búsqueda en la misma línea: una tabla de 300
                 servicios sin forma de acotarla tiene el dato, pero hay que
                 encontrarlo a ojo. El contador dice cuánto se está viendo de
                 cuánto hay, para que filtrar nunca deje a ciegas. -->
            <Grid Grid.Row="0">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="300"/>
                <ColumnDefinition Width="14"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="10"/>
                <ColumnDefinition Width="280"/>
                <ColumnDefinition Width="*"/>
              </Grid.ColumnDefinitions>

              <ComboBox Grid.Column="0" Width="300" HorizontalAlignment="Left"
                        ItemsSource="{Binding Tablas}"
                        SelectedItem="{Binding TablaSeleccionada, Mode=TwoWay}"/>

              <TextBlock Grid.Column="2" Text="Buscar" Style="{StaticResource Eyebrow}"
                         VerticalAlignment="Center"/>

              <TextBox Grid.Column="4" x:Name="BuscarTabla" Style="{StaticResource CampoTexto}"
                       HorizontalAlignment="Stretch"
                       Text="{Binding BusquedaTabla, UpdateSourceTrigger=PropertyChanged}"
                       ToolTip="Busca en todas las columnas visibles de la tabla seleccionada"/>

              <TextBlock Grid.Column="5" Text="{Binding ConteoTabla}" Style="{StaticResource Eyebrow}"
                         VerticalAlignment="Center" HorizontalAlignment="Right" Margin="0,0,4,0"/>
            </Grid>

            <Border Grid.Row="1" Margin="0,12,0,0" Padding="10" CornerRadius="{StaticResource RMd}"
                    Background="{StaticResource BSurface}" BorderBrush="{StaticResource BStrokeSoft}"
                    BorderThickness="1"
                    Visibility="{Binding MostrarAccionesTabla, Converter={StaticResource BoolVis}}">
              <WrapPanel Orientation="Horizontal">

                <!-- Solo canales oficiales: Windows Update y el sitio del
                     fabricante. La app nunca descarga ni instala un driver
                     por su cuenta. -->
                <StackPanel Orientation="Horizontal"
                            Visibility="{Binding MostrarAyudaDrivers, Converter={StaticResource BoolVis}}">
                  <Button Content="Windows Update ▸ Opcionales" Style="{StaticResource BtnQuiet}"
                          Padding="12,7" FontSize="12" Margin="0,0,6,0" Click="AbrirWindowsUpdate_Click"
                          ToolTip="Único canal donde Microsoft publica drivers firmados y verificados contra tu hardware"/>
                  <Button Content="Buscar drivers nuevos" Style="{StaticResource BtnPrimary}"
                          Padding="12,7" FontSize="12" Margin="0,0,6,0" Click="BuscarDrivers_Click"
                          ToolTip="Consulta Windows Update por versiones más nuevas para este hardware"/>
                  <Button Content="Propiedades del seleccionado" Style="{StaticResource BtnQuiet}"
                          Padding="12,7" FontSize="12" Margin="0,0,6,0" Click="PropiedadesDispositivo_Click"
                          ToolTip="Abre la pestaña Controlador del dispositivo marcado, con Actualizar y Revertir"/>
                  <Button Content="Buscar cambios de hardware" Style="{StaticResource BtnQuiet}"
                          Padding="12,7" FontSize="12" Margin="0,0,6,0" Click="EscanearHardware_Click"/>
                  <Button Content="Administrador de dispositivos" Style="{StaticResource BtnQuiet}"
                          Padding="12,7" FontSize="12" Margin="0,0,6,0" Click="AbrirDeviceManager_Click"/>
                  <Button Content="Soporte del fabricante" Style="{StaticResource BtnQuiet}"
                          Padding="12,7" FontSize="12" Margin="0,0,6,0" Click="AbrirSoporteAsus_Click"/>
                  <Button Content="Verificar driver descargado" Style="{StaticResource BtnQuiet}"
                          Padding="12,7" FontSize="12" Click="VerificarDriver_Click"
                          ToolTip="Comprueba firma digital, editor, hash y amenazas en un archivo bajado de cualquier sitio"/>
                </StackPanel>

                <StackPanel Orientation="Horizontal"
                            Visibility="{Binding MostrarAccionesDrivers, Converter={StaticResource BoolVis}}">
                  <Button Content="Instalar seleccionado" Style="{StaticResource BtnPrimary}"
                          Padding="12,7" FontSize="12" Margin="0,0,6,0" Click="InstalarDriver_Click"
                          ToolTip="Descarga e instala desde Windows Update el driver marcado en la tabla"/>
                  <Button Content="Instalar todos" Style="{StaticResource BtnQuiet}"
                          Padding="12,7" FontSize="12" Margin="0,0,6,0" Click="InstalarTodosDrivers_Click"/>
                  <Button Content="Volver a buscar" Style="{StaticResource BtnQuiet}"
                          Padding="12,7" FontSize="12" Margin="0,0,6,0" Click="BuscarDrivers_Click"/>
                  <Button Content="Ver en Windows Update" Style="{StaticResource BtnQuiet}"
                          Padding="12,7" FontSize="12" Margin="0,0,6,0" Click="AbrirWindowsUpdate_Click"
                          ToolTip="Abre Actualizaciones opcionales, donde Windows lista los drivers por su cuenta"/>
                  <Button Content="Soporte del fabricante" Style="{StaticResource BtnQuiet}"
                          Padding="12,7" FontSize="12" Click="AbrirSoporteAsus_Click"/>
                </StackPanel>

                <StackPanel Orientation="Horizontal"
                            Visibility="{Binding MostrarAyudaUpdates, Converter={StaticResource BoolVis}}">
                  <Button Content="Actualizar todo con winget" Style="{StaticResource BtnPrimary}"
                          Padding="12,7" FontSize="12" Margin="0,0,6,0" Click="ActualizarTodo_Click"
                          ToolTip="Abre una consola visible con winget: verás qué se instala y puedes cortarlo"/>
                  <Button Content="Actualizar solo el seleccionado" Style="{StaticResource BtnQuiet}"
                          Padding="12,7" FontSize="12" Margin="0,0,6,0" Click="ActualizarUno_Click"/>
                  <Button Content="Buscar actualizaciones de Windows" Style="{StaticResource BtnQuiet}"
                          Padding="12,7" FontSize="12" Click="AbrirWindowsUpdateSistema_Click"
                          ToolTip="Abre Windows Update para buscar e instalar las actualizaciones del sistema"/>
                </StackPanel>
              </WrapPanel>
            </Border>

            <Border Grid.Row="2" Background="{StaticResource BSurface}" CornerRadius="{StaticResource RMd}"
                    Margin="0,14,0,0" Padding="4,0,4,4" BorderBrush="{StaticResource BStrokeSoft}"
                    BorderThickness="1">
              <Grid>
                <DataGrid x:Name="Grid" ItemsSource="{Binding FilasTablaFiltradas}"
                          AutoGeneratingColumn="Grid_AutoGeneratingColumn"/>

                <!-- Búsqueda sin resultados. Sin este aviso, una rejilla vacía
                     y una tabla que no se cargó se ven exactamente igual. -->
                <Border Background="{StaticResource BBase}" Padding="30,28"
                        Visibility="{Binding SinCoincidencias, Converter={StaticResource BoolVis}}">
                  <StackPanel MaxWidth="440" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <TextBlock Text="Ninguna fila coincide" Style="{StaticResource H2}"
                               HorizontalAlignment="Center"/>
                    <TextBlock Style="{StaticResource Dim}" Margin="0,10,0,0" TextAlignment="Center"
                               TextWrapping="Wrap"
                               Text="La tabla tiene datos, pero ninguna fila contiene ese texto. Probá con una parte más corta o revisá la ortografía."/>
                  </StackPanel>
                </Border>

                <Border Background="{StaticResource BBase}" Padding="30,28"
                        Visibility="{Binding SinTablas, Converter={StaticResource BoolVis}}">
                  <StackPanel MaxWidth="480" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <TextBlock Text="Sin tablas que mostrar" Style="{StaticResource H2}"
                               HorizontalAlignment="Center"/>
                    <TextBlock Style="{StaticResource Dim}" Margin="0,10,0,0" TextAlignment="Center"
                               TextWrapping="Wrap"
                               Text="Pulsa «Diagnóstico completo» o elige un módulo del panel izquierdo: cada uno llena esta vista con sus propias tablas."/>
                  </StackPanel>
                </Border>
                <Border Visibility="{Binding AvisoDrivers}" Background="{StaticResource BSurface}"
                        Padding="30,26" VerticalAlignment="Top" Margin="0,30,0,0">
                  <StackPanel MaxWidth="620" HorizontalAlignment="Center">
                    <TextBlock Text="Sin drivers nuevos que ofrecer" Style="{StaticResource H2}"
                               HorizontalAlignment="Center"/>
                    <TextBlock Text="{Binding TextoAvisoDrivers}" Style="{StaticResource Dim}"
                               TextWrapping="Wrap" TextAlignment="Center" Margin="0,10,0,0"/>
                  </StackPanel>
                </Border>
              </Grid>
            </Border>
          </Grid>

          <!-- ========================== Registro ========================== -->
          <Border Background="{StaticResource BSurface}" CornerRadius="{StaticResource RMd}"
                  BorderBrush="{StaticResource BStrokeSoft}" BorderThickness="1"
                  Padding="0"
                  ui:Motion.Enter="True"
                  Visibility="{Binding IsChecked, ElementName=VRegistro, Converter={StaticResource BoolVis}}">
            <Grid>
              <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
              </Grid.RowDefinitions>

              <!-- Barra del registro. Un diagnóstico completo deja cientos de
                   líneas y el error que se busca es una: filtrar por nivel y
                   buscar por texto es lo que separa «hay un registro» de
                   «puedo usar el registro». -->
              <Border Grid.Row="0" Padding="12,8" BorderBrush="{StaticResource BStrokeSoft}"
                      BorderThickness="0,0,0,1">
                <Grid>
                  <StackPanel Orientation="Horizontal">
                    <RadioButton Content="Todo" Style="{StaticResource FilterChip}" Tag="todo"
                                 IsChecked="True" GroupName="FiltroRegistro"
                                 Checked="FiltroRegistro_Checked"/>
                    <RadioButton Content="Avisos y errores" Style="{StaticResource FilterChip}" Tag="avisos"
                                 Margin="6,0,0,0" GroupName="FiltroRegistro"
                                 Checked="FiltroRegistro_Checked"/>
                    <RadioButton Content="Solo errores" Style="{StaticResource FilterChip}" Tag="errores"
                                 Margin="6,0,0,0" GroupName="FiltroRegistro"
                                 Checked="FiltroRegistro_Checked"/>
                  </StackPanel>

                  <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <TextBlock Text="{Binding ResumenRegistro}" Style="{StaticResource Eyebrow}"
                               VerticalAlignment="Center" Margin="0,0,14,0"/>
                    <TextBox x:Name="BuscarRegistro" Style="{StaticResource CampoTexto}" Width="230"
                             Text="{Binding BusquedaRegistro, UpdateSourceTrigger=PropertyChanged}"
                             ToolTip="Busca una palabra en el texto del registro, incluida la hora"/>
                    <Button Content="Copiar" Style="{StaticResource BtnQuiet}" Padding="12,7" FontSize="12"
                            Margin="8,0,0,0" Click="CopiarRegistro_Click"
                            ToolTip="Copia al portapapeles las líneas que se están viendo"/>
                  </StackPanel>
                </Grid>
              </Border>

            <ListBox Grid.Row="1" x:Name="LogList" ItemsSource="{Binding RegistroFiltrado}"
                     Style="{StaticResource PlainList}" Margin="8,6"
                     ScrollViewer.HorizontalScrollBarVisibility="Auto">
              <ListBox.ItemContainerStyle>
                <Style TargetType="ListBoxItem">
                  <Setter Property="Template">
                    <Setter.Value>
                      <ControlTemplate TargetType="ListBoxItem">
                        <ContentPresenter Margin="11,1"/>
                      </ControlTemplate>
                    </Setter.Value>
                  </Setter>
                </Style>
              </ListBox.ItemContainerStyle>
              <ListBox.ItemTemplate>
                <DataTemplate>
                  <TextBlock Text="{Binding Texto}" Foreground="{Binding Color}"
                             FontFamily="{StaticResource FMono}" FontSize="12"/>
                </DataTemplate>
              </ListBox.ItemTemplate>
            </ListBox>
            </Grid>
          </Border>
        </Grid>

        <!-- ============================== PIE ==============================
             La barra de progreso y los botones ocupan siempre el mismo
             sitio: la interfaz no salta al empezar y terminar una corrida.
             El texto de la ruta vive en su propia columna y se recorta con
             elipsis: antes se superponía con los botones en pantallas no
             muy anchas. -->
        <Grid Grid.Row="3" Margin="24,16,24,16">
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
          </Grid.RowDefinitions>

          <!-- La barra sabe cuántos módulos faltan porque se lo dice el propio
               ViewModel que los lanzó. Cuando no hay conteo (una acción de un
               paso) el estilo vuelve solo al modo indeterminado. -->
          <Grid Grid.Row="0" Margin="0,0,0,12" Visibility="{Binding BarraVisible}">
            <ProgressBar Style="{StaticResource Pulse}" VerticalAlignment="Center"
                         Maximum="{Binding AvadeTotal}" Value="{Binding AvadeHechos}"
                         IsIndeterminate="{Binding AvadeIndeterminado}"/>
            <TextBlock Text="{Binding AvadeTexto}" Style="{StaticResource Dim}"
                       FontFamily="{StaticResource FMono}" FontSize="11"
                       HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,0,4"/>
          </Grid>

          <Border Grid.Row="1" Background="{StaticResource BSurface}" CornerRadius="{StaticResource RMd}"
                  BorderBrush="{StaticResource BStrokeSoft}" BorderThickness="1" Padding="14,10"
                  ui:Motion.Enter="True" ui:Motion.EnterDelay="0:0:0.09">
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
              </Grid.ColumnDefinitions>
              <TextBlock Grid.Column="0" Style="{StaticResource Dim}" VerticalAlignment="Center"
                         TextTrimming="CharacterEllipsis" Margin="0,0,16,0"
                         ToolTip="{Binding RutaSalidaTexto}"
                         Text="{Binding RutaSalidaTexto}"/>
              <StackPanel Grid.Column="1" Orientation="Horizontal">
                <!-- El coste de la corrida se muestra acá, junto a los botones
                     y no dentro del camino del archivo: es una cifra corta que
                     se lee de reojo, y el camino necesita todo el ancho para no
                     recortarse. ElToolTip explica por qué está. -->
                <TextBlock Text="{Binding CosteTexto}" Style="{StaticResource Dim}"
                           FontFamily="{StaticResource FMono}" FontSize="11"
                           VerticalAlignment="Center" Margin="0,0,12,0"
                           Visibility="{Binding CosteVisible, Converter={StaticResource BoolVis}}"
                           ToolTip="Lo que la corrida le costó al equipo, no al revés: si esta cifra es alta, las mediciones de rendimiento de esa corrida están algo infladas por el propio SysDiag."/>
                <Button Content="Cancelar" Style="{StaticResource BtnQuiet}" Margin="0,0,6,0"
                        IsEnabled="{Binding PuedeCancelar}" Click="Cancelar_Click"/>
                <Button Content="Exportar tabla (CSV)" Style="{StaticResource BtnQuiet}" Margin="0,0,6,0"
                        IsEnabled="{Binding PuedeExportar}" Click="ExportarCsv_Click"
                        ToolTip="Exporta la tabla seleccionada en la vista Datos"/>
                <Button Content="Exportar todo (JSON)" Style="{StaticResource BtnQuiet}" Margin="0,0,6,0"
                        IsEnabled="{Binding PuedeExportar}" Click="ExportarJson_Click"/>
                <Button Content="Abrir carpeta" Style="{StaticResource BtnQuiet}" Margin="0,0,6,0"
                        Click="Carpeta_Click"/>
                <Button Content="Generar informe" Style="{StaticResource BtnPrimary}"
                        IsEnabled="{Binding PuedeExportar}" Click="Informe_Click"/>
              </StackPanel>
            </Grid>
          </Border>
        </Grid>
      </Grid>
    </Grid>
  </Grid>
</Window>
