<Window x:Class="SysDiag.Ui.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        xmlns:ui="clr-namespace:SysDiag.Ui"
        Title="SysDiag" Height="820" Width="1300" MinHeight="620" MinWidth="1020"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BBase}"
        TextOptions.TextFormattingMode="Ideal"
        UseLayoutRounding="True">

  <shell:WindowChrome.WindowChrome>
    <shell:WindowChrome CaptionHeight="46" ResizeBorderThickness="6"
                        CornerRadius="0" GlassFrameThickness="0"
                        UseAeroCaptionButtons="False"/>
  </shell:WindowChrome.WindowChrome>

  <Grid x:Name="Root">
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="252"/>
      <ColumnDefinition Width="*"/>
    </Grid.ColumnDefinitions>

    <!-- ============================ BARRA LATERAL ============================ -->
    <Border Grid.Column="0" Background="{StaticResource BSidebar}">
      <Grid>
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="*"/>
          <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="20,26,20,20">
          <Image Source="/Resources/Logo/Lockup.png" Width="190" Stretch="Uniform"
                 HorizontalAlignment="Left" RenderOptions.BitmapScalingMode="HighQuality"/>
          <TextBlock Text="Diagnóstico de equipo y enlace" Style="{StaticResource Eyebrow}"
                     Margin="0,8,0,0"/>
        </StackPanel>


        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
          <StackPanel>
            <TextBlock Text="DIAGNÓSTICO" Style="{StaticResource NavGroup}"/>
            <ListBox x:Name="Nav" Style="{StaticResource PlainList}"
                     ItemContainerStyle="{StaticResource NavItem}"
                     SelectionChanged="Nav_SelectionChanged"
                     IsEnabled="{Binding Libre}">
              <ListBoxItem Tag="completo" ToolTip="Red, rendimiento, térmicas, almacenamiento y estabilidad">
                <StackPanel Orientation="Horizontal">
                  <TextBlock Text="&#xE9D9;" Style="{StaticResource NavIcon}"/>
                  <TextBlock Text="Diagnóstico completo" Style="{StaticResource Body}"/>
                </StackPanel>
              </ListBoxItem>
              <ListBoxItem Tag="red" ToolTip="Latencia, jitter, pérdida, Wi-Fi, canales y traceroute">
                <StackPanel Orientation="Horizontal">
                  <TextBlock Text="&#xEC05;" Style="{StaticResource NavIcon}"/>
                  <TextBlock Text="Red y latencia" Style="{StaticResource Body}"/>
                </StackPanel>
              </ListBoxItem>
              <ListBoxItem Tag="ping-monitor" ToolTip="Ping cada segundo en vivo, mientras la ventana esté abierta">
                <StackPanel Orientation="Horizontal">
                  <TextBlock Text="&#xE9D9;" Style="{StaticResource NavIcon}"/>
                  <TextBlock Text="Monitor de ping" Style="{StaticResource Body}"/>
                </StackPanel>
              </ListBoxItem>
              <ListBoxItem Tag="rendimiento" ToolTip="CPU real por proceso, memoria y disco">
                <StackPanel Orientation="Horizontal">
                  <TextBlock Text="&#xE9D2;" Style="{StaticResource NavIcon}"/>
                  <TextBlock Text="Rendimiento" Style="{StaticResource Body}"/>
                </StackPanel>
              </ListBoxItem>
              <ListBoxItem Tag="termicas" ToolTip="Temperatura, frecuencia, throttling, batería y GPU">
                <StackPanel Orientation="Horizontal">
                  <TextBlock Text="&#xE9CA;" Style="{StaticResource NavIcon}"/>
                  <TextBlock Text="Térmicas y energía" Style="{StaticResource Body}"/>
                </StackPanel>
              </ListBoxItem>
              <ListBoxItem Tag="almacenamiento" ToolTip="Salud SMART, desgaste y errores del disco">
                <StackPanel Orientation="Horizontal">
                  <TextBlock Text="&#xEDA2;" Style="{StaticResource NavIcon}"/>
                  <TextBlock Text="Almacenamiento" Style="{StaticResource Body}"/>
                </StackPanel>
              </ListBoxItem>
              <ListBoxItem Tag="seguridad" ToolTip="Defender, Firewall, BitLocker, TPM, Secure Boot y UAC — solo lectura">
                <StackPanel Orientation="Horizontal">
                  <TextBlock Text="&#xEA18;" Style="{StaticResource NavIcon}"/>
                  <TextBlock Text="Seguridad" Style="{StaticResource Body}"/>
                </StackPanel>
              </ListBoxItem>
              <ListBoxItem Tag="estabilidad" ToolTip="Reinicios, pantallazos, WHEA y volcados">
                <StackPanel Orientation="Horizontal">
                  <TextBlock Text="&#xE7BA;" Style="{StaticResource NavIcon}"/>
                  <TextBlock Text="Estabilidad" Style="{StaticResource Body}"/>
                </StackPanel>
              </ListBoxItem>

              <ListBoxItem IsEnabled="False" Focusable="False" IsHitTestVisible="False">
                <TextBlock Text="MANTENIMIENTO" Style="{StaticResource Eyebrow}" FontSize="10" Margin="0,10,0,0"/>
              </ListBoxItem>
              <ListBoxItem Tag="drivers" ToolTip="Inventario de drivers. No descarga ni instala nada">
                <StackPanel Orientation="Horizontal">
                  <TextBlock Text="&#xE950;" Style="{StaticResource NavIcon}"/>
                  <TextBlock Text="Drivers" Style="{StaticResource Body}"/>
                </StackPanel>
              </ListBoxItem>
              <ListBoxItem Tag="arranque" ToolTip="Programas al inicio, servicios y software instalado">
                <StackPanel Orientation="Horizontal">
                  <TextBlock Text="&#xE7B5;" Style="{StaticResource NavIcon}"/>
                  <TextBlock Text="Arranque y software" Style="{StaticResource Body}"/>
                </StackPanel>
              </ListBoxItem>
              <ListBoxItem Tag="actualizaciones" ToolTip="Programas con versión nueva disponible vía winget">
                <StackPanel Orientation="Horizontal">
                  <TextBlock Text="&#xE896;" Style="{StaticResource NavIcon}"/>
                  <TextBlock Text="Actualizaciones" Style="{StaticResource Body}"/>
                </StackPanel>
              </ListBoxItem>
              <ListBoxItem Tag="limpieza" ToolTip="Calcula y borra archivos temporales">
                <StackPanel Orientation="Horizontal">
                  <TextBlock Text="&#xE74D;" Style="{StaticResource NavIcon}"/>
                  <TextBlock Text="Limpieza" Style="{StaticResource Body}"/>
                </StackPanel>
              </ListBoxItem>
              <ListBoxItem Tag="optimizar" ToolTip="Ajustes reversibles de red y energía">
                <StackPanel Orientation="Horizontal">
                  <TextBlock Text="&#xE9F5;" Style="{StaticResource NavIcon}"/>
                  <TextBlock Text="Optimizar" Style="{StaticResource Body}"/>
                </StackPanel>
              </ListBoxItem>
              <ListBoxItem Tag="perfiles" ToolTip="Universidad, Trabajo o Juego: combinaciones listas de energía y red">
                <StackPanel Orientation="Horizontal">
                  <TextBlock Text="&#xE8FC;" Style="{StaticResource NavIcon}"/>
                  <TextBlock Text="Perfiles" Style="{StaticResource Body}"/>
                </StackPanel>
              </ListBoxItem>
              <ListBoxItem Tag="punto-restauracion" ToolTip="Punto de restauración completo de Windows, para volver atrás si algo sale mal después">
                <StackPanel Orientation="Horizontal">
                  <TextBlock Text="&#xE777;" Style="{StaticResource NavIcon}"/>
                  <TextBlock Text="Punto de restauración" Style="{StaticResource Body}"/>
                </StackPanel>
              </ListBoxItem>
              <ListBoxItem Tag="restaurar" ToolTip="Deshace la última optimización">
                <StackPanel Orientation="Horizontal">
                  <TextBlock Text="&#xE7A7;" Style="{StaticResource NavIcon}"/>
                  <TextBlock Text="Restaurar estado" Style="{StaticResource Body}"/>
                </StackPanel>
              </ListBoxItem>
              <ListBoxItem Tag="historial" ToolTip="Diagnósticos guardados: abrí cualquiera para ver sus hallazgos">
                <StackPanel Orientation="Horizontal">
                  <TextBlock Text="&#xE81C;" Style="{StaticResource NavIcon}"/>
                  <TextBlock Text="Historial" Style="{StaticResource Body}"/>
                </StackPanel>
              </ListBoxItem>
              <ListBoxItem Tag="ajustes" ToolTip="Segundos de muestreo, cantidad de pings, ventanas de días">
                <StackPanel Orientation="Horizontal">
                  <TextBlock Text="&#xE713;" Style="{StaticResource NavIcon}"/>
                  <TextBlock Text="Ajustes" Style="{StaticResource Body}"/>
                </StackPanel>
              </ListBoxItem>
            </ListBox>
          </StackPanel>
        </ScrollViewer>

        <StackPanel Grid.Row="2" Margin="20,0,20,20">
          <Border Background="{StaticResource BSurface}" CornerRadius="4" Padding="12,9"
                  Visibility="{Binding AvisoAdmin}" Margin="0,0,0,12">
            <StackPanel>
              <TextBlock Text="Permisos limitados" Style="{StaticResource Body}" FontSize="12"/>
              <TextBlock Text="Algunos módulos verán datos parciales." Style="{StaticResource Dim}"
                         TextWrapping="Wrap" Margin="0,2,0,8"/>
              <Button Content="Reiniciar como administrador" Style="{StaticResource BtnGhost}"
                      FontSize="12" Padding="10,6" Click="Elevar_Click"/>
            </StackPanel>
          </Border>
          <TextBlock Style="{StaticResource Eyebrow}">
            <Run Text="versión"/><Run Text=" "/><Run Text="{Binding Version, Mode=OneWay}"/>
          </TextBlock>
        </StackPanel>
      </Grid>
    </Border>

    <!-- ============================== CONTENIDO ============================== -->
    <Grid Grid.Column="1">
      <Grid.RowDefinitions>
        <RowDefinition Height="46"/>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="*"/>
        <RowDefinition Height="Auto"/>
      </Grid.RowDefinitions>

      <!-- Barra de título propia: la del sistema no se puede tematizar -->
      <Grid Grid.Row="0">
        <TextBlock Style="{StaticResource Dim}" VerticalAlignment="Center" Margin="28,0,0,0"
                   Foreground="{StaticResource BTextMuted}" TextTrimming="CharacterEllipsis"
                   Text="{Binding Equipo}"/>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right"
                    shell:WindowChrome.IsHitTestVisibleInChrome="True">
          <Button Content="&#xE921;" Style="{StaticResource BtnCaption}" Click="Min_Click" ToolTip="Minimizar"/>
          <Button x:Name="BtnMax" Content="&#xE922;" Style="{StaticResource BtnCaption}" Click="Max_Click" ToolTip="Maximizar"/>
          <Button Content="&#xE8BB;" Style="{StaticResource BtnCaption}" Click="Cerrar_Click" ToolTip="Cerrar"/>
        </StackPanel>
      </Grid>

      <!-- Cabecera: módulo actual + conmutador de vistas -->
      <Grid Grid.Row="1" Margin="28,6,28,18">
        <StackPanel>
          <TextBlock Text="{Binding Titulo}" Style="{StaticResource H1}"/>
          <TextBlock Text="{Binding Subtitulo}" Style="{StaticResource Dim}" Margin="0,3,0,0"/>
        </StackPanel>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Bottom">
          <TextBlock Text="{Binding HoraSistema}" Style="{StaticResource Dim}"
                     FontFamily="{StaticResource FMono}" VerticalAlignment="Center" Margin="0,0,20,0"/>
          <RadioButton x:Name="VResumen" Content="Resumen" Style="{StaticResource Segment}" IsChecked="True"/>
          <RadioButton x:Name="VHallazgos" Content="Hallazgos" Style="{StaticResource Segment}"/>
          <RadioButton x:Name="VDatos" Content="Datos" Style="{StaticResource Segment}"/>
          <RadioButton x:Name="VRegistro" Content="Registro" Style="{StaticResource Segment}"/>
        </StackPanel>
      </Grid>

      <!-- Vistas -->
      <Grid Grid.Row="2" Margin="28,0,28,0" Opacity="{Binding ContenidoOpacidad}">

        <!-- Resumen -->
        <Grid Visibility="{Binding IsChecked, ElementName=VResumen, Converter={StaticResource BoolVis}}">
          <ScrollViewer VerticalScrollBarVisibility="Auto"
                        Visibility="{Binding HayDatos, Converter={StaticResource BoolVis}}">
            <StackPanel>

              <!-- Titular: el puntaje ordena la atención, y va siempre con su
                   desglose al lado, porque un número sin el porqué no informa. -->
              <Border Style="{StaticResource Card}" Padding="26,22,26,24" Margin="0,0,0,20">
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                  </Grid.ColumnDefinitions>

                  <StackPanel Grid.Column="0" Margin="0,0,34,0" HorizontalAlignment="Center">
                    <TextBlock Text="ESTADO GENERAL" Style="{StaticResource SectionLabel}"
                               HorizontalAlignment="Center"/>

                    <!-- Anillo de progreso: un arco trazado con la geometría que
                         calcula ScoreArcConverter, sobre un aro de fondo que marca
                         la escala completa. El número va centrado adentro. -->
                    <Grid Width="120" Height="120">
                      <Ellipse Width="100" Height="100" HorizontalAlignment="Center" VerticalAlignment="Center"
                               Stroke="{StaticResource BStrokeSoft}" StrokeThickness="10"/>
                      <Path Width="120" Height="120" Stretch="None"
                            Data="{Binding Puntaje, Converter={StaticResource ScoreArc}}"
                            Stroke="{Binding PuntajeBrush}" StrokeThickness="10"
                            StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                      <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                        <TextBlock Text="{Binding Puntaje}" FontFamily="{StaticResource FDisplay}"
                                   FontSize="34" Foreground="{Binding PuntajeBrush}"
                                   HorizontalAlignment="Center"/>
                        <TextBlock Text="/ 100" Style="{StaticResource Eyebrow}"
                                   HorizontalAlignment="Center" Margin="0,-2,0,0"/>
                      </StackPanel>
                    </Grid>

                    <TextBlock Text="{Binding PuntajeEtiqueta}" Style="{StaticResource Body}"
                               Foreground="{Binding PuntajeBrush}" Margin="0,10,0,0"
                               HorizontalAlignment="Center"/>
                  </StackPanel>

                  <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock Text="{Binding PuntajeDesglose}" Style="{StaticResource Dim}"
                               TextWrapping="Wrap" Margin="0,0,0,10"/>
                    <TextBlock Text="{Binding PuntajeTendencia}" Style="{StaticResource Body}"
                               TextWrapping="Wrap"/>
                  </StackPanel>
                </Grid>
              </Border>

              <TextBlock Text="MEDICIONES" Style="{StaticResource SectionLabel}"/>

              <ItemsControl ItemsSource="{Binding Tarjetas}">
                <ItemsControl.ItemsPanel>
                  <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <Border Style="{StaticResource MetricCard}" Width="268" Margin="0,0,16,16">
                      <StackPanel>
                        <TextBlock Text="{Binding Titulo}" Style="{StaticResource Eyebrow}"
                                   TextTrimming="CharacterEllipsis"/>
                        <TextBlock Text="{Binding Valor}" Style="{StaticResource Metric}"
                                   Foreground="{Binding Acento}" Margin="0,8,0,10"/>
                        <!-- Regla de escala: marcas que se llenan según magnitud -->
                        <Grid Height="7">
                          <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="{Binding FillStar}"/>
                            <ColumnDefinition Width="{Binding RestStar}"/>
                          </Grid.ColumnDefinitions>
                          <Rectangle Grid.Column="0" Fill="{Binding TicksOn}"/>
                          <Rectangle Grid.Column="1" Fill="{Binding TicksOff}"/>
                        </Grid>
                        <TextBlock Text="{Binding Nota}" Style="{StaticResource Dim}"
                                   Margin="0,10,0,0" TextTrimming="CharacterEllipsis"/>
                      </StackPanel>
                    </Border>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>

              <!-- Gráficos: los números de las tarjetas dicen cuánto; estos
                   dicen cuánto comparado con qué, que es lo que permite
                   decidir dónde mirar. -->
              <ItemsControl Margin="0,10,0,0">
                <ItemsControl.Resources>
                  <Style TargetType="Border" BasedOn="{StaticResource Card}"/>
                </ItemsControl.Resources>

                <Border Margin="0,0,0,16"
                        Visibility="{Binding GraficoRed.Visible, Converter={StaticResource BoolVis}}">
                  <StackPanel>
                    <TextBlock Text="{Binding GraficoRed.Titulo}" Style="{StaticResource SectionLabel}"/>
                    <TextBlock Text="{Binding GraficoRed.Nota}" Style="{StaticResource Dim}"
                               TextWrapping="Wrap" Margin="0,0,0,16"/>
                    <ItemsControl ItemsSource="{Binding GraficoRed.Barras}"
                                  ItemTemplate="{StaticResource BarTemplate}"/>
                  </StackPanel>
                </Border>

                <Border Margin="0,0,0,16"
                        Visibility="{Binding GraficoProcesos.Visible, Converter={StaticResource BoolVis}}">
                  <StackPanel>
                    <TextBlock Text="{Binding GraficoProcesos.Titulo}" Style="{StaticResource SectionLabel}"/>
                    <TextBlock Text="{Binding GraficoProcesos.Nota}" Style="{StaticResource Dim}"
                               TextWrapping="Wrap" Margin="0,0,0,16"/>
                    <ItemsControl ItemsSource="{Binding GraficoProcesos.Barras}"
                                  ItemTemplate="{StaticResource BarTemplate}"/>
                  </StackPanel>
                </Border>

                <Border Margin="0,0,0,16"
                        Visibility="{Binding GraficoEventos.Visible, Converter={StaticResource BoolVis}}">
                  <StackPanel>
                    <TextBlock Text="{Binding GraficoEventos.Titulo}" Style="{StaticResource SectionLabel}"/>
                    <TextBlock Text="{Binding GraficoEventos.Nota}" Style="{StaticResource Dim}"
                               TextWrapping="Wrap" Margin="0,0,0,16"/>
                    <ItemsControl ItemsSource="{Binding GraficoEventos.Barras}"
                                  ItemTemplate="{StaticResource BarTemplate}"/>
                  </StackPanel>
                </Border>

                <Border Margin="0,0,0,16"
                        Visibility="{Binding GraficoHistorial.Visible, Converter={StaticResource BoolVis}}">
                  <StackPanel>
                    <TextBlock Text="EVOLUCIÓN DEL PUNTAJE" Style="{StaticResource SectionLabel}"/>
                    <TextBlock Style="{StaticResource Dim}" TextWrapping="Wrap" Margin="0,0,0,16"
                               Text="Cada punto es un diagnóstico guardado. La línea subiendo significa que el equipo mejoró respecto a como estaba; bajando, que apareció algo nuevo."/>
                    <Canvas Width="620" Height="120" ClipToBounds="False" Margin="0,4,0,0">
                      <Line X1="0" Y1="0" X2="620" Y2="0" Stroke="{StaticResource BStrokeSoft}" StrokeThickness="1"/>
                      <Line X1="0" Y1="60" X2="620" Y2="60" Stroke="{StaticResource BStrokeSoft}" StrokeThickness="1"/>
                      <Line X1="0" Y1="120" X2="620" Y2="120" Stroke="{StaticResource BStroke}" StrokeThickness="1"/>
                      <Polygon Points="{Binding GraficoHistorial.Area}" Fill="{StaticResource BAccentWash}"/>
                      <Polyline Points="{Binding GraficoHistorial.Puntos}"
                                Stroke="{StaticResource BAccent}" StrokeThickness="2"
                                StrokeLineJoin="Round"/>
                      <ItemsControl ItemsSource="{Binding GraficoHistorial.Marcas}">
                        <ItemsControl.ItemsPanel>
                          <ItemsPanelTemplate><Canvas/></ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemContainerStyle>
                          <Style TargetType="ContentPresenter">
                            <Setter Property="Canvas.Left" Value="{Binding X}"/>
                            <Setter Property="Canvas.Top" Value="{Binding Y}"/>
                          </Style>
                        </ItemsControl.ItemContainerStyle>
                        <ItemsControl.ItemTemplate>
                          <DataTemplate>
                            <Ellipse Width="6" Height="6" Fill="{StaticResource BAccent}"
                                     ToolTip="{Binding Tooltip}"/>
                          </DataTemplate>
                        </ItemsControl.ItemTemplate>
                      </ItemsControl>
                    </Canvas>
                    <Grid Margin="0,8,0,0">
                      <TextBlock Text="{Binding GraficoHistorial.Rango}" Style="{StaticResource Eyebrow}"/>
                      <TextBlock Text="0 — 100" Style="{StaticResource Eyebrow}" HorizontalAlignment="Right"/>
                    </Grid>
                  </StackPanel>
                </Border>
              </ItemsControl>

              <Border Style="{StaticResource Card}" Margin="0,6,0,0"
                      Background="Transparent" BorderBrush="{StaticResource BStrokeSoft}">
                <StackPanel>
                  <TextBlock Text="SIGUIENTE PASO" Style="{StaticResource SectionLabel}"/>
                  <TextBlock Text="{Binding Sugerencia}" Style="{StaticResource Dim}"
                             TextWrapping="Wrap"/>
                </StackPanel>
              </Border>
            </StackPanel>
          </ScrollViewer>

          <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="420"
                      Visibility="{Binding HayDatos, Converter={StaticResource BoolVisNot}}">
            <TextBlock Text="&#xE9D9;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                       FontSize="34" Foreground="{StaticResource BTextMuted}"
                       HorizontalAlignment="Center" Margin="0,0,0,14"/>
            <TextBlock Text="Todavía no hay mediciones" Style="{StaticResource H1}"
                       HorizontalAlignment="Center"/>
            <TextBlock Style="{StaticResource Dim}" Margin="0,8,0,0" TextAlignment="Center"
                       TextWrapping="Wrap"
                       Text="{Binding TextoVacio}"/>
          </StackPanel>
        </Grid>

        <!-- Hallazgos -->
        <Grid Visibility="{Binding IsChecked, ElementName=VHallazgos, Converter={StaticResource BoolVis}}">
          <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
          </Grid.RowDefinitions>

          <Border Grid.Row="0" Background="{StaticResource BSurface}" CornerRadius="6">
            <ListBox ItemsSource="{Binding Hallazgos}" Style="{StaticResource PlainList}"
                     ItemContainerStyle="{StaticResource FindingItem}"
                     SelectedItem="{Binding HallazgoSeleccionado, Mode=TwoWay}">
              <ListBox.ItemTemplate>
                <DataTemplate>
                  <Grid Margin="18,12">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="4"/>
                      <ColumnDefinition Width="104"/>
                      <ColumnDefinition Width="128"/>
                      <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Rectangle Grid.Column="0" Width="3" RadiusX="2" RadiusY="2"
                               Fill="{Binding Severity, Converter={StaticResource SevBrush}}"/>
                    <Border Grid.Column="1" Style="{StaticResource Chip}" Margin="14,0,0,0"
                            Background="{Binding Severity, Converter={StaticResource SevWash}}">
                      <TextBlock Text="{Binding Etiqueta}" Style="{StaticResource Eyebrow}"
                                 Foreground="{Binding Severity, Converter={StaticResource SevBrush}}"/>
                    </Border>
                    <TextBlock Grid.Column="2" Text="{Binding Area}" Style="{StaticResource Dim}"
                               VerticalAlignment="Center"/>
                    <TextBlock Grid.Column="3" Text="{Binding Message}" Style="{StaticResource Body}"
                               TextWrapping="Wrap" VerticalAlignment="Center"/>
                  </Grid>
                </DataTemplate>
              </ListBox.ItemTemplate>
            </ListBox>
          </Border>

          <Border Grid.Row="1" Background="{StaticResource BSurfaceAlt}" CornerRadius="6"
                  Padding="20,16" Margin="0,14,0,0" MinHeight="86">
            <StackPanel>
              <TextBlock Text="RECOMENDACIÓN" Style="{StaticResource Eyebrow}" Margin="0,0,0,6"/>
              <TextBlock Text="{Binding DetalleHallazgo}" Style="{StaticResource Body}"
                         TextWrapping="Wrap" Foreground="{StaticResource BTextDim}"/>
              <Button Content="{Binding TextoReparar}" Visibility="{Binding BotonReparar}"
                      IsEnabled="{Binding Libre}" Click="Reparar_Click" Style="{StaticResource BtnPrimary}"
                      HorizontalAlignment="Left" Margin="0,12,0,0"/>
            </StackPanel>
          </Border>
        </Grid>

        <!-- Datos -->
        <Grid Visibility="{Binding IsChecked, ElementName=VDatos, Converter={StaticResource BoolVis}}">
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
          </Grid.RowDefinitions>
          <ComboBox Grid.Row="0" Width="280" HorizontalAlignment="Left"
                    ItemsSource="{Binding Tablas}"
                    SelectedItem="{Binding TablaSeleccionada, Mode=TwoWay}"/>

          <!-- Solo canales oficiales: Windows Update y el sitio del fabricante.
               La app nunca descarga ni instala un driver por su cuenta. -->
          <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,12,0,0"
                      Visibility="{Binding MostrarAyudaDrivers, Converter={StaticResource BoolVis}}">
            <Button Content="Windows Update ▸ Opcionales" Style="{StaticResource BtnGhost}"
                    Padding="12,7" FontSize="12" Margin="0,0,8,0" Click="AbrirWindowsUpdate_Click"
                    ToolTip="Único canal donde Microsoft publica drivers firmados y verificados contra tu hardware"/>
            <Button Content="Buscar drivers nuevos" Style="{StaticResource BtnPrimary}"
                    Padding="12,7" FontSize="12" Margin="0,0,8,0" Click="BuscarDrivers_Click"
                    ToolTip="Consulta Windows Update por versiones más nuevas para este hardware"/>
            <Button Content="Propiedades del seleccionado" Style="{StaticResource BtnGhost}"
                    Padding="12,7" FontSize="12" Margin="0,0,8,0" Click="PropiedadesDispositivo_Click"
                    ToolTip="Abre la pestaña Controlador del dispositivo marcado, con Actualizar y Revertir"/>
            <Button Content="Buscar cambios de hardware" Style="{StaticResource BtnGhost}"
                    Padding="12,7" FontSize="12" Margin="0,0,8,0" Click="EscanearHardware_Click"/>
            <Button Content="Administrador de dispositivos" Style="{StaticResource BtnGhost}"
                    Padding="12,7" FontSize="12" Margin="0,0,8,0" Click="AbrirDeviceManager_Click"/>
            <Button Content="Soporte del fabricante" Style="{StaticResource BtnGhost}"
                    Padding="12,7" FontSize="12" Margin="0,0,8,0" Click="AbrirSoporteAsus_Click"/>
            <Button Content="Verificar driver descargado" Style="{StaticResource BtnGhost}"
                    Padding="12,7" FontSize="12" Click="VerificarDriver_Click"
                    ToolTip="Comprueba firma digital, editor, hash y amenazas en un archivo bajado de cualquier sitio"/>
          </StackPanel>

          <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,12,0,0"
                      Visibility="{Binding MostrarAccionesDrivers, Converter={StaticResource BoolVis}}">
            <Button Content="Instalar seleccionado" Style="{StaticResource BtnPrimary}"
                    Padding="12,7" FontSize="12" Margin="0,0,8,0" Click="InstalarDriver_Click"
                    ToolTip="Descarga e instala desde Windows Update el driver marcado en la tabla"/>
            <Button Content="Instalar todos" Style="{StaticResource BtnGhost}"
                    Padding="12,7" FontSize="12" Margin="0,0,8,0" Click="InstalarTodosDrivers_Click"/>
            <Button Content="Volver a buscar" Style="{StaticResource BtnGhost}"
                    Padding="12,7" FontSize="12" Margin="0,0,8,0" Click="BuscarDrivers_Click"/>
            <Button Content="Ver en Windows Update" Style="{StaticResource BtnGhost}"
                    Padding="12,7" FontSize="12" Margin="0,0,8,0" Click="AbrirWindowsUpdate_Click"
                    ToolTip="Abre Actualizaciones opcionales, donde Windows lista los drivers por su cuenta"/>
            <Button Content="Soporte del fabricante" Style="{StaticResource BtnGhost}"
                    Padding="12,7" FontSize="12" Click="AbrirSoporteAsus_Click"/>
          </StackPanel>

          <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,12,0,0"
                      Visibility="{Binding MostrarAyudaUpdates, Converter={StaticResource BoolVis}}">
            <Button Content="Actualizar todo con winget" Style="{StaticResource BtnGhost}"
                    Padding="12,7" FontSize="12" Margin="0,0,8,0" Click="ActualizarTodo_Click"
                    ToolTip="Abre una consola visible con winget: verás qué se instala y puedes cortarlo"/>
            <Button Content="Actualizar solo el seleccionado" Style="{StaticResource BtnGhost}"
                    Padding="12,7" FontSize="12" Click="ActualizarUno_Click"/>
          </StackPanel>

          <Border Grid.Row="2" Background="{StaticResource BSurface}" CornerRadius="6"
                  Margin="0,14,0,0" Padding="4,0,4,4">
            <Grid>
              <DataGrid x:Name="Grid" ItemsSource="{Binding FilasTabla}"
                        AutoGeneratingColumn="Grid_AutoGeneratingColumn"/>
              <Border Visibility="{Binding AvisoDrivers}" Background="{StaticResource BSurface}"
                      Padding="30,26" VerticalAlignment="Top" Margin="0,30,0,0">
                <StackPanel MaxWidth="620" HorizontalAlignment="Center">
                  <TextBlock Text="Sin drivers nuevos que ofrecer" Style="{StaticResource H1}"
                             HorizontalAlignment="Center"/>
                  <TextBlock Text="{Binding TextoAvisoDrivers}" Style="{StaticResource Dim}"
                             TextWrapping="Wrap" TextAlignment="Center" Margin="0,10,0,0"/>
                </StackPanel>
              </Border>
            </Grid>
          </Border>
        </Grid>

        <!-- Registro -->
        <Border Background="{StaticResource BSurface}" CornerRadius="6" Padding="8,6"
                Visibility="{Binding IsChecked, ElementName=VRegistro, Converter={StaticResource BoolVis}}">
          <ListBox x:Name="LogList" ItemsSource="{Binding Registro}" Style="{StaticResource PlainList}"
                   ScrollViewer.HorizontalScrollBarVisibility="Auto">
            <ListBox.ItemContainerStyle>
              <Style TargetType="ListBoxItem">
                <Setter Property="Template">
                  <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                      <ContentPresenter Margin="10,1"/>
                    </ControlTemplate>
                  </Setter.Value>
                </Setter>
              </Style>
            </ListBox.ItemContainerStyle>
            <ListBox.ItemTemplate>
              <DataTemplate>
                <TextBlock Text="{Binding Texto}" Foreground="{Binding Color}"
                           FontFamily="{StaticResource FMono}" FontSize="12"/>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
        </Border>
      </Grid>

      <!-- =============================== PIE =============================== -->
      <Grid Grid.Row="3" Margin="28,18,28,0">
        <Grid.RowDefinitions>
          <RowDefinition Height="2"/>
          <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <ProgressBar Grid.Row="0" Style="{StaticResource Pulse}" Visibility="{Binding BarraVisible}"/>

        <Grid Grid.Row="1" Margin="0,16,0,18">
          <TextBlock Style="{StaticResource Dim}" VerticalAlignment="Center"
                     Text="Los informes y registros se guardan en Documentos\SysDiag"/>
          <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Cancelar" Style="{StaticResource BtnGhost}" Margin="0,0,8,0"
                    IsEnabled="{Binding PuedeCancelar}" Click="Cancelar_Click"/>
            <Button Content="Exportar tabla (CSV)" Style="{StaticResource BtnGhost}" Margin="0,0,8,0"
                    IsEnabled="{Binding PuedeExportar}" Click="ExportarCsv_Click"
                    ToolTip="Exporta la tabla seleccionada en la vista Datos"/>
            <Button Content="Exportar todo (JSON)" Style="{StaticResource BtnGhost}" Margin="0,0,8,0"
                    IsEnabled="{Binding PuedeExportar}" Click="ExportarJson_Click"/>
            <Button Content="Abrir carpeta" Style="{StaticResource BtnGhost}" Margin="0,0,8,0"
                    Click="Carpeta_Click"/>
            <Button Content="Generar informe" Style="{StaticResource BtnPrimary}"
                    IsEnabled="{Binding PuedeExportar}" Click="Informe_Click"/>
          </StackPanel>
        </Grid>
      </Grid>
    </Grid>
  </Grid>
</Window>
