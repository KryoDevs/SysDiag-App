<Window x:Class="SysDiag.Ui.CanalesWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        xmlns:ui="clr-namespace:SysDiag.Ui"
        Title="Canales Wi-Fi" Height="720" Width="1000" MinHeight="460" MinWidth="760"
        WindowStyle="None" WindowStartupLocation="CenterOwner"
        Background="{StaticResource BBase}"
        TextOptions.TextFormattingMode="Ideal" UseLayoutRounding="True">

  <shell:WindowChrome.WindowChrome>
    <shell:WindowChrome CaptionHeight="46" ResizeBorderThickness="6"
                        CornerRadius="0" GlassFrameThickness="0"
                        UseAeroCaptionButtons="False"/>
  </shell:WindowChrome.WindowChrome>

  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="46"/>
      <RowDefinition Height="*"/>
    </Grid.RowDefinitions>

    <Border Grid.Row="0" Background="{StaticResource BRail}"
            BorderBrush="{StaticResource BStrokeSoft}" BorderThickness="0,0,0,1">
      <Grid>
        <StackPanel Orientation="Horizontal" Margin="18,0,0,0" VerticalAlignment="Center">
          <Image Source="/Resources/Logo/Lockup.png" Height="22" Stretch="Uniform"
                 RenderOptions.BitmapScalingMode="HighQuality"/>
          <Rectangle Width="1" Height="16" Fill="{StaticResource BStroke}" Margin="16,0,14,0"/>
          <TextBlock Text="Canales Wi-Fi" Style="{StaticResource Dim}" VerticalAlignment="Center"/>
        </StackPanel>
        <Button HorizontalAlignment="Right" Content="&#xE8BB;" Style="{StaticResource BtnCaptionClose}"
                Click="Cerrar_Click" ToolTip="Cerrar"
                AutomationProperties.Name="Cerrar esta ventana"
                shell:WindowChrome.IsHitTestVisibleInChrome="True"/>
      </Grid>
    </Border>

    <Grid Grid.Row="1" Margin="24,16,24,16" ui:Motion.Enter="True">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="*"/>
        <RowDefinition Height="Auto"/>
      </Grid.RowDefinitions>

      <StackPanel Grid.Row="0" Margin="0,0,0,14">
        <TextBlock Text="Qué canal está ocupado y cuál conviene" Style="{StaticResource H1}"/>
        <TextBlock Style="{StaticResource Dim}" Margin="0,5,0,0" TextWrapping="Wrap"
                   Text="En 2.4 GHz los canales se pisan entre sí: una red en el canal 2 molesta al 1 y al 3 aunque no coincida con ninguno. Por eso la barra cuenta todas las redes que tocan cada canal, y la recomendación sale de los tres que no se solapan (1, 6 y 11). En 5 GHz los canales no se pisan: se comparan por número."/>
        <TextBlock x:Name="TxtEstado" Style="{StaticResource Eyebrow}" Margin="0,10,0,0"/>
        <Border Style="{StaticResource CardOutline}" Margin="0,12,0,0" Padding="16,13,16,13">
          <StackPanel>
            <TextBlock x:Name="TxtRecomendacion" Style="{StaticResource Body}" TextWrapping="Wrap"/>
            <TextBlock x:Name="TxtNota" Style="{StaticResource Dim}" TextWrapping="Wrap" Margin="0,7,0,0"
                       Visibility="Collapsed"/>
          </StackPanel>
        </Border>
      </StackPanel>

      <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"
                    Margin="0,0,-14,0" Padding="0,0,14,0">
        <StackPanel x:Name="PanelBarras"/>
      </ScrollViewer>

      <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
        <TextBlock x:Name="TxtLeyenda" Style="{StaticResource Dim}" VerticalAlignment="Center"
                   Margin="0,0,14,0"
                   Text="La barra es la cantidad de redes que tocan el canal; el color, la congestión."/>
        <Button x:Name="BtnMedir" Content="Volver a medir" Style="{StaticResource BtnGhost}"
                Margin="0,0,8,0" Click="Medir_Click"
                AutomationProperties.Name="Volver a medir los canales"
                ToolTip="Repite el escaneo. Cada medición es una foto del momento: nada de lo que ves se guarda."/>
        <Button Content="Cerrar" Style="{StaticResource BtnGhost}" Click="Cerrar_Click"/>
      </StackPanel>
    </Grid>
  </Grid>
</Window>
