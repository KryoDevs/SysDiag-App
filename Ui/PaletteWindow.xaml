<Window x:Class="SysDiag.Ui.PaletteWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="clr-namespace:SysDiag.Ui"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        Height="480" Width="640" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False">

  <!-- Al abrirse, el panel sube y aparece: el gesto que explica de
       dónde salió respecto de la ventana madre. -->
  <Border Style="{StaticResource PanelShell}" ui:Motion.Enter="True">
    <Grid>
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="*"/>
        <RowDefinition Height="Auto"/>
      </Grid.RowDefinitions>

      <!-- El campo de búsqueda. El foco lo recibe en el code-behind, porque
           una paleta a la que hay que hacerle clic antes de escribir deja de
           ser un atajo y pasa a ser un cuadro de diálogo más. -->
      <Grid Grid.Row="0" Margin="0,0,0,12">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto"/>
          <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <TextBlock Grid.Column="0" Text="&#xE721;" Style="{StaticResource NavIcon}"
                   VerticalAlignment="Center" Margin="0,0,12,0"/>
        <TextBox x:Name="TxtBuscar" Grid.Column="1" Style="{StaticResource CampoTexto}"
                 Height="40" FontSize="15" VerticalContentAlignment="Center"
                 TextChanged="Buscar_TextChanged" KeyDown="Buscar_KeyDown"
                 AutomationProperties.Name="Buscar un comando"/>
      </Grid>

      <ListBox x:Name="Lista" Grid.Row="1" Style="{StaticResource PlainList}"
               KeyDown="Lista_KeyDown" MouseDoubleClick="Lista_DoubleClick"
               ScrollViewer.HorizontalScrollBarVisibility="Disabled">
        <ListBox.ItemTemplate>
          <DataTemplate>
            <Grid Margin="12,9">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
              </Grid.ColumnDefinitions>

              <Border Grid.Column="0" Style="{StaticResource Chip}" Margin="0,0,12,0"
                      VerticalAlignment="Center">
                <TextBlock Text="{Binding Grupo}" Style="{StaticResource Eyebrow}"/>
              </Border>

              <StackPanel Grid.Column="1" VerticalAlignment="Center">
                <TextBlock Text="{Binding Titulo}" Style="{StaticResource Body}"
                           TextTrimming="CharacterEllipsis"/>
                <TextBlock Text="{Binding Detalle}" Style="{StaticResource Dim}"
                           FontSize="12" TextTrimming="CharacterEllipsis" Margin="0,2,0,0"
                           Visibility="{Binding TieneDetalle, Converter={StaticResource BoolVis}}"/>
              </StackPanel>

              <TextBlock Grid.Column="2" Text="{Binding Atajo}" Style="{StaticResource Eyebrow}"
                         VerticalAlignment="Center" Margin="12,0,0,0"
                         Visibility="{Binding TieneAtajo, Converter={StaticResource BoolVis}}"/>
            </Grid>
          </DataTemplate>
        </ListBox.ItemTemplate>
      </ListBox>

      <Border Grid.Row="1" Background="{StaticResource BSurface}" Padding="20,16"
              Visibility="{Binding SinResultados, Converter={StaticResource BoolVis}}">
        <TextBlock x:Name="TxtVacio" Style="{StaticResource Dim}" TextAlignment="Center"
                   TextWrapping="Wrap"/>
      </Border>

      <TextBlock Grid.Row="2" Style="{StaticResource Dim}" FontSize="12" Margin="0,12,0,0"
                 Text="↑ ↓ navegar · Enter ejecutar · Esc cerrar"/>
    </Grid>
  </Border>
</Window>
