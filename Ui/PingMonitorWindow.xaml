<Window x:Class="SysDiag.Ui.PingMonitorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        xmlns:ui="clr-namespace:SysDiag.Ui"
        Title="Monitor de ping" Height="600" Width="880" MinHeight="480" MinWidth="700"
        WindowStyle="None" WindowStartupLocation="CenterOwner"
        Background="{StaticResource BBase}"
        TextOptions.TextFormattingMode="Ideal" UseLayoutRounding="True">

  <shell:WindowChrome.WindowChrome>
    <shell:WindowChrome CaptionHeight="46" ResizeBorderThickness="6"
                        CornerRadius="0" GlassFrameThickness="0"
                        UseAeroCaptionButtons="False"/>
  </shell:WindowChrome.WindowChrome>

  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="46"/>
      <RowDefinition Height="*"/>
    </Grid.RowDefinitions>

    <!-- Barra de título: misma marca y mismos controles que la ventana
         principal, así ninguna ventana de la aplicación parece de otro
         programa. -->
    <Border Grid.Row="0" Background="{StaticResource BRail}"
            BorderBrush="{StaticResource BStrokeSoft}" BorderThickness="0,0,0,1">
      <Grid>
        <StackPanel Orientation="Horizontal" Margin="18,0,0,0" VerticalAlignment="Center">
          <Image Source="/Resources/Logo/Lockup.png" Height="22" Stretch="Uniform"
                 RenderOptions.BitmapScalingMode="HighQuality"/>
          <Rectangle Width="1" Height="16" Fill="{StaticResource BStroke}" Margin="16,0,14,0"/>
          <TextBlock Text="Monitor de ping" Style="{StaticResource Dim}" VerticalAlignment="Center"/>
        </StackPanel>
        <Button HorizontalAlignment="Right" Content="&#xE8BB;" Style="{StaticResource BtnCaptionClose}"
                Click="Cerrar_Click" ToolTip="Cerrar"
                AutomationProperties.Name="Cerrar esta ventana"
                shell:WindowChrome.IsHitTestVisibleInChrome="True"/>
      </Grid>
    </Border>

    <Grid Grid.Row="1" Margin="24,16,24,16" ui:Motion.Enter="True">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="*"/>
      </Grid.RowDefinitions>

      <StackPanel Grid.Row="0" Margin="0,0,0,18">
        <TextBlock Text="Ping en vivo" Style="{StaticResource H1}"/>
        <TextBlock Style="{StaticResource Dim}" Margin="0,5,0,0" TextWrapping="Wrap" MaxWidth="720"
                   HorizontalAlignment="Left"
                   Text="Un ping por segundo mientras esta ventana esté abierta. Útil para ver si un pico de lag coincide con algo puntual: otro dispositivo descargando, el ventilador acelerando, una actualización en segundo plano."/>
      </StackPanel>

      <Grid Grid.Row="1" Margin="0,0,0,16">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>
        <ComboBox x:Name="ComboDestino" Grid.Column="0" Width="300" HorizontalAlignment="Left"/>
        <Button x:Name="BtnIniciar" Grid.Column="1" Content="Iniciar" Style="{StaticResource BtnPrimary}"
                Click="Toggle_Click"/>
      </Grid>

      <Border Grid.Row="2" Style="{StaticResource Card}">
        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
          </Grid.RowDefinitions>

          <Grid Grid.Row="0" Margin="0,0,0,20">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*"/>
              <ColumnDefinition Width="12"/>
              <ColumnDefinition Width="*"/>
              <ColumnDefinition Width="12"/>
              <ColumnDefinition Width="*"/>
              <ColumnDefinition Width="12"/>
              <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Background="{StaticResource BSurfaceAlt}" CornerRadius="{StaticResource RMd}" Padding="14,12">
              <StackPanel>
                <TextBlock Text="ACTUAL" Style="{StaticResource Eyebrow}"/>
                <TextBlock x:Name="TxtActual" Text="—" Style="{StaticResource Metric}" FontSize="26"
                           Foreground="{StaticResource BAccent}" Margin="0,6,0,0"/>
              </StackPanel>
            </Border>
            <Border Grid.Column="2" Background="{StaticResource BSurfaceAlt}" CornerRadius="{StaticResource RMd}" Padding="14,12">
              <StackPanel>
                <TextBlock Text="PROMEDIO" Style="{StaticResource Eyebrow}"/>
                <TextBlock x:Name="TxtPromedio" Text="—" Style="{StaticResource Metric}" FontSize="26"
                           Foreground="{StaticResource BText}" Margin="0,6,0,0"/>
              </StackPanel>
            </Border>
            <Border Grid.Column="4" Background="{StaticResource BSurfaceAlt}" CornerRadius="{StaticResource RMd}" Padding="14,12">
              <StackPanel>
                <TextBlock Text="MÁXIMO" Style="{StaticResource Eyebrow}"/>
                <TextBlock x:Name="TxtMaximo" Text="—" Style="{StaticResource Metric}" FontSize="26"
                           Foreground="{StaticResource BWarn}" Margin="0,6,0,0"/>
              </StackPanel>
            </Border>
            <Border Grid.Column="6" Background="{StaticResource BSurfaceAlt}" CornerRadius="{StaticResource RMd}" Padding="14,12">
              <StackPanel>
                <TextBlock Text="PÉRDIDA" Style="{StaticResource Eyebrow}"/>
                <TextBlock x:Name="TxtPerdida" Text="—" Style="{StaticResource Metric}" FontSize="26"
                           Foreground="{StaticResource BBad}" Margin="0,6,0,0"/>
              </StackPanel>
            </Border>
          </Grid>

          <Grid Grid.Row="1">
            <Grid.Resources>
              <!-- Relleno del área: cian vivo arriba, casi transparente abajo. -->
              <LinearGradientBrush x:Key="GAreaCian" StartPoint="0,0" EndPoint="0,1">
                <GradientStop Color="#3838D6F0" Offset="0"/>
                <GradientStop Color="#0738D6F0" Offset="1"/>
              </LinearGradientBrush>
            </Grid.Resources>

            <!-- Franjas de referencia: dan escala al ojo. La etiqueta de la
                 derecha dice cuánto vale cada franja, para poder leer el
                 gráfico sin adivinar. -->
            <Canvas x:Name="Lienzo" ClipToBounds="True">
              <Line X1="0" Y1="0" X2="0" Y2="0" x:Name="LineaTope" Stroke="{StaticResource BStrokeSoft}" StrokeThickness="1"/>
              <Line X1="0" Y1="0" X2="0" Y2="0" x:Name="LineaMedio" Stroke="{StaticResource BStrokeSoft}" StrokeThickness="1"/>
              <Line X1="0" Y1="0" X2="0" Y2="0" x:Name="LineaBase" Stroke="{StaticResource BStroke}" StrokeThickness="1"/>
              <Polygon x:Name="Area" Fill="{StaticResource GAreaCian}"/>
              <Polyline x:Name="Linea" Stroke="{StaticResource BAccent2}" StrokeThickness="2" StrokeLineJoin="Round"/>
              <!-- El punto de la última muestra respira. De los acentos del tema,
                   el cian es el color de lo que está vivo en este instante, y aquí
                   es literal: la ventana está midiendo. El latido escala desde el
                   centro para no despegarse del trazo. -->
              <Ellipse x:Name="PuntoFinal" Width="9" Height="9" Fill="{StaticResource BAccent2}"
                       Stroke="{StaticResource BSurface}" StrokeThickness="2" Visibility="Collapsed"
                       RenderTransformOrigin="0.5,0.5">
                <Ellipse.RenderTransform>
                  <ScaleTransform x:Name="PuntoLatido" ScaleX="1" ScaleY="1"/>
                </Ellipse.RenderTransform>
                <Ellipse.Triggers>
                  <EventTrigger RoutedEvent="FrameworkElement.Loaded">
                    <BeginStoryboard>
                      <Storyboard RepeatBehavior="Forever" AutoReverse="True">
                        <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)"
                                         To="1.18" Duration="0:0:1.1" EasingFunction="{StaticResource EEaseSuave}"/>
                        <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)"
                                         To="1.18" Duration="0:0:1.1" EasingFunction="{StaticResource EEaseSuave}"/>
                        <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                         To="0.72" Duration="0:0:1.1" EasingFunction="{StaticResource EEaseSuave}"/>
                      </Storyboard>
                    </BeginStoryboard>
                  </EventTrigger>
                </Ellipse.Triggers>
              </Ellipse>
            </Canvas>

            <Grid Margin="8,2,10,2" IsHitTestVisible="False">
              <TextBlock x:Name="TxtEscalaTope" Style="{StaticResource Eyebrow}" HorizontalAlignment="Right"
                         VerticalAlignment="Top" Foreground="{StaticResource BTextMuted}"/>
              <TextBlock x:Name="TxtEscalaMedio" Style="{StaticResource Eyebrow}" HorizontalAlignment="Right"
                         VerticalAlignment="Center" Foreground="{StaticResource BTextMuted}"/>
              <TextBlock x:Name="TxtEscalaBase" Style="{StaticResource Eyebrow}" HorizontalAlignment="Right"
                         VerticalAlignment="Bottom" Foreground="{StaticResource BTextMuted}"/>
            </Grid>

            <TextBlock x:Name="TxtVacio" Style="{StaticResource Dim}" HorizontalAlignment="Center"
                       VerticalAlignment="Center" Text="Elegí un destino y tocá Iniciar."/>
          </Grid>
        </Grid>
      </Border>
    </Grid>
  </Grid>
</Window>
