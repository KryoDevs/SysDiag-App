<Window x:Class="SysDiag.Ui.CleanupWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        SizeToContent="Height" Width="640" ResizeMode="NoResize" MaxHeight="720"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
  <Border Style="{StaticResource PanelShell}">
    <StackPanel>
      <Rectangle Height="4" Width="46" HorizontalAlignment="Left" RadiusX="2" RadiusY="2"
                 Fill="{StaticResource BAccent}" Margin="0,0,0,16"/>
      <TextBlock Text="Qué limpiar" Style="{StaticResource H2}"/>
      <TextBlock Style="{StaticResource Dim}" TextWrapping="Wrap" Margin="0,8,0,18"
                 Text="Primero se calcula cuánto ocupa cada destino y después se pide confirmación. Nada se borra en este paso."/>

      <ScrollViewer MaxHeight="420" VerticalScrollBarVisibility="Auto" Margin="0,0,-14,0" Padding="0,0,14,0">
        <StackPanel x:Name="Lista"/>
      </ScrollViewer>

      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
        <Button Content="Cancelar" Style="{StaticResource BtnGhost}" Margin="0,0,8,0" Click="Cancelar_Click"/>
        <Button Content="Analizar" Style="{StaticResource BtnPrimary}" Click="Aceptar_Click" IsDefault="True"/>
      </StackPanel>
    </StackPanel>
  </Border>
</Window>
